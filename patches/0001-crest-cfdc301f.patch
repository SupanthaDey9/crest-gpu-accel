diff -ruN --exclude=subprojects upstream/src/calculator/cuda/crest_cuda_bridge.cpp v2tree/src/calculator/cuda/crest_cuda_bridge.cpp
--- upstream/src/calculator/cuda/crest_cuda_bridge.cpp	1969-12-31 18:00:00
+++ v2tree/src/calculator/cuda/crest_cuda_bridge.cpp	2026-10-12 04:44:02
@@ -0,0 +1,693 @@
+#include "crest_cuda_bridge.h"
+
+#include <cuda_runtime_api.h>
+#include <cusolverDn.h>
+#include <cublas_v2.h>
+
+#include <atomic>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <new>
+
+namespace {
+
+struct Session {
+    int n = 0;
+    int device = 0;
+    int lwork = 0;
+    size_t matrix_bytes = 0;
+    cudaStream_t stream = nullptr;
+    cusolverDnHandle_t solver = nullptr;
+    cublasHandle_t blas = nullptr;
+    double *a = nullptr;
+    double *b = nullptr;
+    double *w = nullptr;
+    double *work = nullptr;
+    int *info = nullptr;
+    double *density = nullptr;
+    crest_cuda_stats stats{};
+    crest_cuda_error error{};
+};
+
+void record(crest_cuda_error &e, int status, int stage, int native) noexcept {
+    if (status == CREST_CUDA_SUCCESS) return;
+    if (e.status == CREST_CUDA_SUCCESS) {
+        e.status = status;
+        e.stage = stage;
+        e.native_code = native;
+        if (status == CREST_CUDA_DEVICE_INFO_ERROR) e.device_info = native;
+    } else {
+        if (e.secondary_count == 0) {
+            e.secondary_status = status;
+            e.secondary_stage = stage;
+            e.secondary_native_code = native;
+        }
+        ++e.secondary_count;
+    }
+}
+
+bool runtime_ok(cudaError_t rc, int stage, crest_cuda_error &e) noexcept {
+    if (rc == cudaSuccess) return true;
+    record(e, CREST_CUDA_RUNTIME_ERROR, stage, static_cast<int>(rc));
+    return false;
+}
+
+bool solver_ok(cusolverStatus_t rc, int stage, crest_cuda_error &e) noexcept {
+    if (rc == CUSOLVER_STATUS_SUCCESS) return true;
+    record(e, CREST_CUDA_SOLVER_ERROR, stage, static_cast<int>(rc));
+    return false;
+}
+
+bool blas_ok(cublasStatus_t rc, int stage, crest_cuda_error &e) noexcept {
+    if (rc == CUBLAS_STATUS_SUCCESS) return true;
+    record(e, CREST_CUDA_CUBLAS_ERROR, stage, static_cast<int>(rc));
+    return false;
+}
+
+/* The stream is drained even after failure so accepted async transfers cannot
+ * retain caller-owned host buffers past the ABI call's lifetime.
+ */
+void cleanup(Session &s, crest_cuda_error &e) noexcept {
+    if (s.stream)
+        runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e);
+    if (s.solver)
+        solver_ok(cusolverDnDestroy(s.solver), CREST_CUDA_STAGE_SOLVER_DESTROY, e);
+    if (s.blas)
+        blas_ok(cublasDestroy(s.blas), CREST_CUDA_STAGE_BLAS_DESTROY, e);
+    if (s.density)
+        runtime_ok(cudaFree(s.density), CREST_CUDA_STAGE_DENSITY_FREE, e);
+    if (s.a) runtime_ok(cudaFree(s.a), CREST_CUDA_STAGE_DEVICE_FREE, e);
+    if (s.b) runtime_ok(cudaFree(s.b), CREST_CUDA_STAGE_DEVICE_FREE, e);
+    if (s.w) runtime_ok(cudaFree(s.w), CREST_CUDA_STAGE_DEVICE_FREE, e);
+    if (s.work) runtime_ok(cudaFree(s.work), CREST_CUDA_STAGE_DEVICE_FREE, e);
+    if (s.info) runtime_ok(cudaFree(s.info), CREST_CUDA_STAGE_DEVICE_FREE, e);
+    if (s.stream)
+        runtime_ok(cudaStreamDestroy(s.stream), CREST_CUDA_STAGE_STREAM_DESTROY, e);
+}
+
+bool enter_device(const Session &s, int &previous, crest_cuda_error &e) noexcept {
+    if (!runtime_ok(cudaGetDevice(&previous), CREST_CUDA_STAGE_GET_DEVICE, e)) return false;
+    return previous == s.device ||
+        runtime_ok(cudaSetDevice(s.device), CREST_CUDA_STAGE_SET_DEVICE, e);
+}
+
+void restore_device(const Session &s, int previous, crest_cuda_error &e) noexcept {
+    if (previous >= 0 && previous != s.device)
+        runtime_ok(cudaSetDevice(previous), CREST_CUDA_STAGE_RESTORE_DEVICE, e);
+}
+
+bool copy(Session &s, void *dest, const void *source, size_t bytes,
+          cudaMemcpyKind kind, int stage, crest_cuda_error &e) noexcept {
+    if (!runtime_ok(cudaMemcpyAsync(dest, source, bytes, kind, s.stream), stage, e)) return false;
+    if (kind == cudaMemcpyHostToDevice) {
+        ++s.stats.h2d_calls;
+        s.stats.h2d_bytes += bytes;
+    } else {
+        ++s.stats.d2h_calls;
+        s.stats.d2h_bytes += bytes;
+    }
+    return true;
+}
+
+/* Called only while the session's device is current. Commit the lazy resources
+ * together, so an initialization failure cannot leave a partially configured
+ * cuBLAS handle available to the next call. No caller input is enqueued here.
+ */
+bool prepare_density(Session &s, crest_cuda_error &e) noexcept {
+    if (s.blas && s.density) return true;
+    cublasHandle_t blas = nullptr;
+    double *density = nullptr;
+    do {
+        if (!blas_ok(cublasCreate(&blas), CREST_CUDA_STAGE_BLAS_CREATE, e)) break;
+        if (!blas_ok(cublasSetStream(blas, s.stream), CREST_CUDA_STAGE_BLAS_SET_STREAM, e)) break;
+        if (!blas_ok(cublasSetPointerMode(blas, CUBLAS_POINTER_MODE_HOST),
+                     CREST_CUDA_STAGE_BLAS_SET_POINTER_MODE, e)) break;
+        if (!blas_ok(cublasSetMathMode(blas, CUBLAS_DEFAULT_MATH),
+                     CREST_CUDA_STAGE_BLAS_SET_MATH_MODE, e)) break;
+        if (!runtime_ok(cudaMalloc(reinterpret_cast<void **>(&density), s.matrix_bytes),
+                        CREST_CUDA_STAGE_DENSITY_ALLOC, e)) break;
+    } while (false);
+    if (e.status) {
+        runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e);
+        if (blas) blas_ok(cublasDestroy(blas), CREST_CUDA_STAGE_BLAS_DESTROY, e);
+        if (density) runtime_ok(cudaFree(density), CREST_CUDA_STAGE_DENSITY_FREE, e);
+        return false;
+    }
+    s.blas = blas;
+    s.density = density;
+    return true;
+}
+
+/* v11 multi-GPU experiment. CREST_CUDA_MULTI_DEVICE=1 (read once per process)
+ * places each new session round-robin on device k % ndev of the visible
+ * devices. Unset, any other value, or fewer than two visible devices: the
+ * stock single-device path (the caller's current device) is used.
+ */
+int multi_device_requested() noexcept {
+    static const int requested = [] {
+        const char *v = std::getenv("CREST_CUDA_MULTI_DEVICE");
+        return (v && std::strcmp(v, "1") == 0) ? 1 : 0;
+    }();
+    return requested;
+}
+
+int multi_device_count() noexcept {
+    static const int count = [] {
+        int n = 0;
+        if (!multi_device_requested() || cudaGetDeviceCount(&n) != cudaSuccess) return 0;
+        return n;
+    }();
+    return count;
+}
+
+std::atomic<unsigned> multi_device_sessions{0};
+
+}  // namespace
+
+extern "C" int crest_cuda_create(int n, void **out) noexcept {
+    return crest_cuda_create_ex(n, out, nullptr);
+}
+
+extern "C" int crest_cuda_create_ex(int n, void **out, crest_cuda_error *error) noexcept {
+    crest_cuda_error e{};
+    if (out) *out = nullptr;
+    const size_t dim = n > 0 ? static_cast<size_t>(n) : 0;
+    if (!out) {
+        record(e, CREST_CUDA_INVALID_ARGUMENT, CREST_CUDA_STAGE_ARGUMENT, 0);
+    } else if (n <= 0 || dim > std::numeric_limits<size_t>::max() / sizeof(double) / dim) {
+        record(e, CREST_CUDA_INVALID_DIMENSION, CREST_CUDA_STAGE_ARGUMENT, n);
+    }
+    if (e.status) {
+        if (error) *error = e;
+        return e.status;
+    }
+
+    Session *s = new (std::nothrow) Session;
+    if (!s) {
+        record(e, CREST_CUDA_HOST_ALLOCATION_ERROR, CREST_CUDA_STAGE_HOST_ALLOC, 0);
+        if (error) *error = e;
+        return e.status;
+    }
+    s->n = n;
+    s->matrix_bytes = dim * dim * sizeof(double);
+    int previous = -1;
+    bool switched = false;
+    unsigned session = 0;
+    do {
+        if (!runtime_ok(cudaGetDevice(&s->device), CREST_CUDA_STAGE_GET_DEVICE, e)) break;
+        if (multi_device_requested()) {
+            session = multi_device_sessions.fetch_add(1u, std::memory_order_relaxed);
+            const int ndev = multi_device_count();
+            const int d = ndev > 1 ? static_cast<int>(session % static_cast<unsigned>(ndev)) : s->device;
+            if (d != s->device) {
+                if (!runtime_ok(cudaSetDevice(d), CREST_CUDA_STAGE_SET_DEVICE, e)) break;
+                previous = s->device;
+                switched = true;
+                s->device = d;
+            }
+        }
+        if (!runtime_ok(cudaStreamCreateWithFlags(&s->stream, cudaStreamNonBlocking),
+                        CREST_CUDA_STAGE_STREAM_CREATE, e)) break;
+        if (!solver_ok(cusolverDnCreate(&s->solver), CREST_CUDA_STAGE_SOLVER_CREATE, e)) break;
+        if (!solver_ok(cusolverDnSetStream(s->solver, s->stream), CREST_CUDA_STAGE_SET_STREAM, e)) break;
+        if (!runtime_ok(cudaMalloc(reinterpret_cast<void **>(&s->a), s->matrix_bytes), CREST_CUDA_STAGE_DEVICE_ALLOC, e)) break;
+        if (!runtime_ok(cudaMalloc(reinterpret_cast<void **>(&s->b), s->matrix_bytes), CREST_CUDA_STAGE_DEVICE_ALLOC, e)) break;
+        if (!runtime_ok(cudaMalloc(reinterpret_cast<void **>(&s->w), dim * sizeof(double)), CREST_CUDA_STAGE_DEVICE_ALLOC, e)) break;
+        if (!runtime_ok(cudaMalloc(reinterpret_cast<void **>(&s->info), sizeof(int)), CREST_CUDA_STAGE_DEVICE_ALLOC, e)) break;
+        if (!solver_ok(cusolverDnDsygvd_bufferSize(s->solver, CUSOLVER_EIG_TYPE_1,
+                CUSOLVER_EIG_MODE_VECTOR, CUBLAS_FILL_MODE_UPPER, n, s->a, n,
+                s->b, n, s->w, &s->lwork), CREST_CUDA_STAGE_BUFFER_SIZE, e)) break;
+        if (s->lwork <= 0 || static_cast<size_t>(s->lwork) > std::numeric_limits<size_t>::max() / sizeof(double)) {
+            record(e, CREST_CUDA_INVALID_DIMENSION, CREST_CUDA_STAGE_BUFFER_SIZE, s->lwork);
+            break;
+        }
+        if (!runtime_ok(cudaMalloc(reinterpret_cast<void **>(&s->work),
+                static_cast<size_t>(s->lwork) * sizeof(double)), CREST_CUDA_STAGE_DEVICE_ALLOC, e)) break;
+    } while (false);
+
+    const int placed = s->device;
+    if (e.status) {
+        cleanup(*s, e);
+        delete s;
+    } else {
+        s->stats.abi_version = 1;
+        s->stats.dimension = n;
+        s->stats.device_ordinal = s->device;
+        s->stats.workspace_elements = s->lwork;
+        s->stats.session_creations = 1;
+        *out = s;
+    }
+    // Multi-device placement leaves the caller's current device unchanged.
+    if (switched && !runtime_ok(cudaSetDevice(previous), CREST_CUDA_STAGE_RESTORE_DEVICE, e) && *out) {
+        crest_cuda_destroy_ex(*out, nullptr);
+        *out = nullptr;
+    }
+    if (multi_device_requested())
+        std::fprintf(stderr, "CREST_CUDA_DEVICE session %u device %d visible %d status %d\n",
+                     session, placed, multi_device_count(), e.status);
+    if (error) *error = e;
+    return e.status;
+}
+
+extern "C" int crest_cuda_solve(void *handle, int n, double *hmat,
+                                 const double *smat, double *eval) noexcept {
+    if (!handle) return CREST_CUDA_INVALID_ARGUMENT;
+    Session &s = *static_cast<Session *>(handle);
+    crest_cuda_error e{};
+    if (!hmat || !smat || !eval) {
+        record(e, CREST_CUDA_INVALID_ARGUMENT, CREST_CUDA_STAGE_ARGUMENT, 0);
+    } else if (n <= 0 || n != s.n) {
+        record(e, CREST_CUDA_INVALID_DIMENSION, CREST_CUDA_STAGE_ARGUMENT, n);
+    }
+    int previous = -1;
+    bool entered = false;
+    int info = 0;
+    if (!e.status) entered = enter_device(s, previous, e);
+    if (entered) {
+        do {
+            if (!copy(s, s.a, hmat, s.matrix_bytes, cudaMemcpyHostToDevice, CREST_CUDA_STAGE_UPLOAD_H, e)) break;
+            if (!copy(s, s.b, smat, s.matrix_bytes, cudaMemcpyHostToDevice, CREST_CUDA_STAGE_UPLOAD_S, e)) break;
+            if (!solver_ok(cusolverDnDsygvd(s.solver, CUSOLVER_EIG_TYPE_1,
+                    CUSOLVER_EIG_MODE_VECTOR, CUBLAS_FILL_MODE_UPPER, n,
+                    s.a, n, s.b, n, s.w, s.work, s.lwork, s.info),
+                    CREST_CUDA_STAGE_SOLVE, e)) break;
+            if (!copy(s, &info, s.info, sizeof(int), cudaMemcpyDeviceToHost, CREST_CUDA_STAGE_DOWNLOAD_INFO, e)) break;
+            if (!runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e)) break;
+            if (info != 0) {
+                record(e, CREST_CUDA_DEVICE_INFO_ERROR, CREST_CUDA_STAGE_DEVICE_INFO, info);
+                break;
+            }
+            if (!copy(s, hmat, s.a, s.matrix_bytes, cudaMemcpyDeviceToHost, CREST_CUDA_STAGE_DOWNLOAD_VECTORS, e)) break;
+            if (!copy(s, eval, s.w, static_cast<size_t>(n) * sizeof(double),
+                      cudaMemcpyDeviceToHost, CREST_CUDA_STAGE_DOWNLOAD_VALUES, e)) break;
+            runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e);
+        } while (false);
+        if (e.status)
+            runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e);
+    }
+    restore_device(s, previous, e);
+    if (e.status) ++s.stats.failed_solves;
+    else ++s.stats.successful_solves;
+    s.error = e;
+    return e.status;
+}
+
+extern "C" int crest_cuda_density(void *handle, int n, const double *coeff,
+                                   const double *focc, double *pmat) noexcept {
+    if (!handle) return CREST_CUDA_INVALID_ARGUMENT;
+    Session &s = *static_cast<Session *>(handle);
+    crest_cuda_error e{};
+    if (!coeff || !focc || !pmat) {
+        record(e, CREST_CUDA_INVALID_ARGUMENT, CREST_CUDA_STAGE_ARGUMENT, 0);
+    } else if (n <= 0 || n != s.n) {
+        record(e, CREST_CUDA_INVALID_DIMENSION, CREST_CUDA_STAGE_ARGUMENT, n);
+    }
+    int previous = -1;
+    bool entered = false;
+    if (!e.status) entered = enter_device(s, previous, e);
+    if (entered) {
+        do {
+            if (!prepare_density(s, e)) break;
+            // Host coefficients and weights are authoritative even immediately
+            // after a solve. Reuse storage, never presumed resident input data.
+            if (!copy(s, s.a, coeff, s.matrix_bytes, cudaMemcpyHostToDevice,
+                      CREST_CUDA_STAGE_UPLOAD_COEFFICIENTS, e)) break;
+            if (!copy(s, s.w, focc, static_cast<size_t>(n) * sizeof(double),
+                      cudaMemcpyHostToDevice, CREST_CUDA_STAGE_UPLOAD_OCCUPATIONS, e)) break;
+            if (!blas_ok(cublasDdgmm(s.blas, CUBLAS_SIDE_RIGHT, n, n,
+                                    s.a, n, s.w, 1, s.b, n),
+                         CREST_CUDA_STAGE_DENSITY_SCALE, e)) break;
+            const double one = 1.0;
+            const double zero = 0.0;
+            if (!blas_ok(cublasDgemm(s.blas, CUBLAS_OP_N, CUBLAS_OP_T, n, n, n,
+                                    &one, s.b, n, s.a, n, &zero, s.density, n),
+                         CREST_CUDA_STAGE_DENSITY_GEMM, e)) break;
+            if (!copy(s, pmat, s.density, s.matrix_bytes, cudaMemcpyDeviceToHost,
+                      CREST_CUDA_STAGE_DOWNLOAD_DENSITY, e)) break;
+            runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e);
+        } while (false);
+        if (e.status)
+            runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, e);
+    }
+    restore_device(s, previous, e);
+    s.error = e;
+    return e.status;
+}
+
+extern "C" int crest_cuda_destroy(void *handle) noexcept {
+    return crest_cuda_destroy_ex(handle, nullptr);
+}
+
+extern "C" int crest_cuda_destroy_ex(void *handle, crest_cuda_error *error) noexcept {
+    crest_cuda_error e{};
+    if (handle) {
+        Session *s = static_cast<Session *>(handle);
+        int previous = -1;
+        bool entered = enter_device(*s, previous, e);
+        // Even if querying the caller's device failed, try the known owner
+        // device once so partial cleanup remains possible. Keep the error.
+        if (!entered)
+            entered = runtime_ok(cudaSetDevice(s->device), CREST_CUDA_STAGE_SET_DEVICE, e);
+        if (entered) cleanup(*s, e);
+        restore_device(*s, previous, e);
+        delete s;
+    }
+    if (error) *error = e;
+    return e.status;
+}
+
+extern "C" int crest_cuda_get_stats(void *handle, crest_cuda_stats *out) noexcept {
+    if (!handle || !out) return CREST_CUDA_INVALID_ARGUMENT;
+    *out = static_cast<Session *>(handle)->stats;
+    return CREST_CUDA_SUCCESS;
+}
+
+extern "C" int crest_cuda_get_error(void *handle, crest_cuda_error *out) noexcept {
+    if (!handle || !out) return CREST_CUDA_INVALID_ARGUMENT;
+    *out = static_cast<Session *>(handle)->error;
+    return CREST_CUDA_SUCCESS;
+}
+
+// Additive worker/lease experiment. The legacy implementation above is intact.
+#include <thread>
+
+namespace {
+
+struct Worker {
+    std::thread::id thread;
+    Session *idle = nullptr;
+    int idle_configuration = 0;
+    crest_cuda_worker_receipt receipt{};
+};
+
+struct Lease {
+    Worker *worker = nullptr;
+    Session *session = nullptr;
+    uint64_t generation = 0;
+    int configuration = 0;
+    bool cache_eligible = false;
+    bool tainted = false;
+    crest_cuda_error first_error{};
+};
+
+// Trivial TLS locates an explicit scope; no object/TLS destructor owns cleanup.
+thread_local Worker *current_worker = nullptr;
+thread_local uint64_t worker_generation = 0;
+
+void merge_error(crest_cuda_error &dest, const crest_cuda_error &source) noexcept {
+    if (!source.status) return;
+    record(dest, source.status, source.stage, source.native_code);
+    if (source.secondary_count > 0) {
+        record(dest, source.secondary_status, source.secondary_stage, source.secondary_native_code);
+        dest.secondary_count += source.secondary_count - 1;
+    }
+}
+
+int argument_error(crest_cuda_error *out) noexcept {
+    crest_cuda_error e{};
+    record(e, CREST_CUDA_INVALID_ARGUMENT, CREST_CUDA_STAGE_ARGUMENT, 0);
+    if (out) *out = e;
+    return e.status;
+}
+
+bool same_worker(const Worker *w) noexcept {
+    return w && w->thread == std::this_thread::get_id() && current_worker == w;
+}
+
+bool same_lease(const Lease *lease) noexcept {
+    return lease && same_worker(lease->worker) &&
+        lease->generation == lease->worker->receipt.generation;
+}
+
+void snapshot(const Worker &w, crest_cuda_worker_receipt &out, bool consumed = false) noexcept {
+    out = w.receipt;
+    out.scope_open = consumed ? 0 : 1;
+    out.scope_consumed = consumed ? 1 : 0;
+    out.idle_present = w.idle ? 1 : 0;
+    out.idle_dimension = w.idle ? w.idle->n : 0;
+    out.idle_device = w.idle ? w.idle->device : -1;
+    out.idle_configuration = w.idle ? w.idle_configuration : 0;
+    out.cleanup_complete = consumed && !out.active_leases && !out.physical_live_owners &&
+        !out.cleanup_failures && !out.drain_failures;
+}
+
+void taint(Lease &lease, const crest_cuda_error &error) noexcept {
+    if (!error.status) return;
+    if (!lease.tainted) {
+        lease.tainted = true;
+        ++lease.worker->receipt.tainted_leases;
+    }
+    merge_error(lease.first_error, error);
+    merge_error(lease.worker->receipt.error, error);
+}
+
+void destroy_owner(Worker &w, Session *&s, crest_cuda_error &error) noexcept {
+    if (!s) return;
+    crest_cuda_error cleanup_error{};
+    ++w.receipt.physical_destroy_attempts;
+    crest_cuda_destroy_ex(s, &cleanup_error);
+    s = nullptr; // Legacy destroy consumes its host owner even on failure.
+    ++w.receipt.physical_owners_consumed;
+    --w.receipt.physical_live_owners;
+    if (cleanup_error.status) ++w.receipt.cleanup_failures;
+    else ++w.receipt.physical_destroys_succeeded;
+    merge_error(error, cleanup_error);
+}
+
+void reset_invocation(Session &s) noexcept {
+    s.error = crest_cuda_error{};
+    s.stats = crest_cuda_stats{};
+    s.stats.abi_version = 1;
+    s.stats.dimension = s.n;
+    s.stats.device_ordinal = s.device;
+    s.stats.workspace_elements = s.lwork;
+    // Logical invocation creation, not a claim of new physical allocation.
+    s.stats.session_creations = 1;
+}
+
+} // namespace
+
+extern "C" int crest_cuda_worker_open(void **worker, crest_cuda_worker_receipt *receipt) noexcept {
+    if (!receipt) return CREST_CUDA_INVALID_ARGUMENT;
+    *receipt = crest_cuda_worker_receipt{};
+    if (!worker || *worker || current_worker) return argument_error(&receipt->error);
+    Worker *w = new (std::nothrow) Worker;
+    if (!w) {
+        record(receipt->error, CREST_CUDA_HOST_ALLOCATION_ERROR, CREST_CUDA_STAGE_HOST_ALLOC, 0);
+        return receipt->error.status;
+    }
+    w->thread = std::this_thread::get_id();
+    w->receipt.abi_version = 1;
+    w->receipt.generation = ++worker_generation;
+    current_worker = w;
+    *worker = w;
+    snapshot(*w, *receipt);
+    return CREST_CUDA_SUCCESS;
+}
+
+extern "C" int crest_cuda_worker_get_receipt(void *worker, crest_cuda_worker_receipt *receipt) noexcept {
+    if (!receipt) return CREST_CUDA_INVALID_ARGUMENT;
+    *receipt = crest_cuda_worker_receipt{};
+    Worker *w = static_cast<Worker *>(worker);
+    if (!same_worker(w)) return argument_error(&receipt->error);
+    snapshot(*w, *receipt);
+    return CREST_CUDA_SUCCESS;
+}
+
+extern "C" int crest_cuda_worker_close(void **worker, crest_cuda_worker_receipt *receipt) noexcept {
+    if (!receipt) return CREST_CUDA_INVALID_ARGUMENT;
+    *receipt = crest_cuda_worker_receipt{};
+    if (!worker) return argument_error(&receipt->error);
+    if (!*worker) {
+        receipt->abi_version = 1;
+        receipt->cleanup_complete = 1;
+        return CREST_CUDA_SUCCESS;
+    }
+    Worker *w = static_cast<Worker *>(*worker);
+    if (!same_worker(w)) return argument_error(&receipt->error);
+    if (w->receipt.active_leases) {
+        ++w->receipt.rejected_closes;
+        snapshot(*w, *receipt);
+        record(receipt->error, CREST_CUDA_INVALID_ARGUMENT, CREST_CUDA_STAGE_ARGUMENT, 0);
+        return receipt->error.status;
+    }
+    crest_cuda_error cleanup_error{};
+    destroy_owner(*w, w->idle, cleanup_error);
+    merge_error(w->receipt.error, cleanup_error);
+    snapshot(*w, *receipt, true);
+    current_worker = nullptr;
+    *worker = nullptr;
+    delete w;
+    return receipt->error.status;
+}
+
+extern "C" int crest_cuda_worker_get_current_receipt(crest_cuda_worker_receipt *receipt) noexcept {
+    return crest_cuda_worker_get_receipt(current_worker, receipt);
+}
+
+extern "C" int crest_cuda_worker_latch_error(const crest_cuda_error *error) noexcept {
+    Worker *w = current_worker;
+    if (!same_worker(w) || !error || !error->status) return CREST_CUDA_INVALID_ARGUMENT;
+    if (!w->receipt.error.status) w->receipt.error = *error;
+    return w->receipt.error.status;
+}
+
+extern "C" int crest_cuda_lease_acquire_ex(int n, int configuration, void **out,
+                                          crest_cuda_error *error) noexcept {
+    if (!error) return CREST_CUDA_INVALID_ARGUMENT;
+    *error = crest_cuda_error{};
+    Worker *w = current_worker;
+    if (!out || *out || !same_worker(w) ||
+        configuration != CREST_CUDA_PERSISTENCE_FP64_TYPE1_UPPER) return argument_error(error);
+    const size_t dim = n > 0 ? static_cast<size_t>(n) : 0;
+    if (n <= 0 || dim > std::numeric_limits<size_t>::max() / sizeof(double) / dim) {
+        record(*error, CREST_CUDA_INVALID_DIMENSION, CREST_CUDA_STAGE_ARGUMENT, n);
+        return error->status;
+    }
+    if (w->receipt.error.status) {
+        *error = w->receipt.error;
+        return error->status;
+    }
+    Lease *lease = new (std::nothrow) Lease;
+    if (!lease) {
+        record(*error, CREST_CUDA_HOST_ALLOCATION_ERROR, CREST_CUDA_STAGE_HOST_ALLOC, 0);
+        merge_error(w->receipt.error, *error);
+        return error->status;
+    }
+    int device = -1;
+    if (!runtime_ok(cudaGetDevice(&device), CREST_CUDA_STAGE_GET_DEVICE, *error)) {
+        merge_error(w->receipt.error, *error);
+        delete lease;
+        return error->status;
+    }
+    lease->worker = w;
+    lease->generation = w->receipt.generation;
+    lease->configuration = configuration;
+    lease->cache_eligible = w->receipt.active_leases == 0;
+    if (lease->cache_eligible) {
+        // v11: with multi-device placement the worker's idle owner lives on its
+        // round-robin device, not on the caller's current device; reuse it.
+        if (w->idle && (multi_device_count() > 1 || w->idle->device == device) && w->idle->n == n &&
+            w->idle_configuration == configuration) {
+            lease->session = w->idle;
+            w->idle = nullptr;
+            ++w->receipt.cache_hits;
+        } else {
+            ++w->receipt.cache_misses;
+            if (w->idle) {
+                ++w->receipt.evictions;
+                destroy_owner(*w, w->idle, *error);
+                if (error->status) {
+                    merge_error(w->receipt.error, *error);
+                    delete lease;
+                    return error->status;
+                }
+            }
+        }
+    } else {
+        ++w->receipt.nested_allocations;
+    }
+    if (!lease->session) {
+        ++w->receipt.physical_creation_attempts;
+        void *owner = nullptr;
+        crest_cuda_create_ex(n, &owner, error);
+        if (error->status) {
+            ++w->receipt.failed_creations;
+            // Later errors from legacy creation are its attempted cleanup.
+            if (error->secondary_count) ++w->receipt.cleanup_failures;
+            merge_error(w->receipt.error, *error);
+            delete lease;
+            return error->status;
+        }
+        lease->session = static_cast<Session *>(owner);
+        ++w->receipt.physical_creations;
+        ++w->receipt.physical_live_owners;
+    }
+    reset_invocation(*lease->session);
+    ++w->receipt.logical_acquires;
+    ++w->receipt.active_leases;
+    if (w->receipt.active_leases > w->receipt.peak_leases)
+        w->receipt.peak_leases = w->receipt.active_leases;
+    *out = lease;
+    return CREST_CUDA_SUCCESS;
+}
+
+extern "C" int crest_cuda_lease_solve(void *handle, int n, double *hmat, const double *smat,
+                                     double *eval, crest_cuda_error *error) noexcept {
+    if (!error) return CREST_CUDA_INVALID_ARGUMENT;
+    *error = crest_cuda_error{};
+    Lease *lease = static_cast<Lease *>(handle);
+    if (!same_lease(lease)) return argument_error(error);
+    if (lease->tainted) {
+        *error = lease->first_error;
+        return error->status;
+    }
+    crest_cuda_solve(lease->session, n, hmat, smat, eval);
+    *error = lease->session->error;
+    taint(*lease, *error);
+    return error->status;
+}
+
+extern "C" int crest_cuda_lease_density(void *handle, int n, const double *coeff,
+                                       const double *focc, double *pmat,
+                                       crest_cuda_error *error) noexcept {
+    if (!error) return CREST_CUDA_INVALID_ARGUMENT;
+    *error = crest_cuda_error{};
+    Lease *lease = static_cast<Lease *>(handle);
+    if (!same_lease(lease)) return argument_error(error);
+    if (lease->tainted) {
+        *error = lease->first_error;
+        return error->status;
+    }
+    crest_cuda_density(lease->session, n, coeff, focc, pmat);
+    *error = lease->session->error;
+    taint(*lease, *error);
+    return error->status;
+}
+
+extern "C" int crest_cuda_lease_get_stats(void *handle, crest_cuda_stats *out) noexcept {
+    Lease *lease = static_cast<Lease *>(handle);
+    if (!out || !same_lease(lease)) return CREST_CUDA_INVALID_ARGUMENT;
+    return crest_cuda_get_stats(lease->session, out);
+}
+
+extern "C" int crest_cuda_lease_release_ex(void **handle, crest_cuda_error *error) noexcept {
+    if (!error) return CREST_CUDA_INVALID_ARGUMENT;
+    *error = crest_cuda_error{};
+    if (!handle) return argument_error(error);
+    if (!*handle) return CREST_CUDA_SUCCESS;
+    Lease *lease = static_cast<Lease *>(*handle);
+    if (!same_lease(lease)) return argument_error(error); // Do not consume foreign ownership.
+    Worker &w = *lease->worker;
+    Session &s = *lease->session;
+    crest_cuda_error drain_error{};
+    ++w.receipt.drain_attempts;
+    int previous = -1;
+    bool entered = enter_device(s, previous, drain_error);
+    if (!entered) entered = runtime_ok(cudaSetDevice(s.device), CREST_CUDA_STAGE_SET_DEVICE, drain_error);
+    if (entered) runtime_ok(cudaStreamSynchronize(s.stream), CREST_CUDA_STAGE_SYNCHRONIZE, drain_error);
+    restore_device(s, previous, drain_error);
+    if (drain_error.status) ++w.receipt.drain_failures;
+    taint(*lease, drain_error);
+    *error = lease->first_error;
+    if (lease->tainted || !lease->cache_eligible) {
+        crest_cuda_error cleanup_error{};
+        destroy_owner(w, lease->session, cleanup_error);
+        taint(*lease, cleanup_error);
+        if (lease->tainted) ++w.receipt.tainted_discards;
+        *error = lease->first_error;
+    } else {
+        // Only a cache-eligible outer lease can occupy the one idle slot.
+        w.idle = lease->session;
+        w.idle_configuration = lease->configuration;
+        lease->session = nullptr;
+    }
+    --w.receipt.active_leases;
+    ++w.receipt.logical_releases;
+    *handle = nullptr;
+    delete lease;
+    return error->status;
