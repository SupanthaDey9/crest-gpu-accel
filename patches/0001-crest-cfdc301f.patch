+!========================================================================================!
+  subroutine oloop_journal_open()
+!*****************************************************************
+!* CREST_CKPT (SYNTHESIS B.3, C.3)
+!* Open the journaled pass output in crest_ckpt/step_<id>/.
+!* On resume (header equal: step, nall, nat, optlev, input key)
+!* the finished structures are kept:
+!*  1. records are accepted in order until the first malformed one
+!*     (two integers, 1<=z<=nall, st in {0,2}, no duplicates),
+!*  2. reconciled with the complete frames (M) and energy-log
+!*     lines (L) on disk: nok = min(#st0,M,L); records are kept in
+!*     order up to the nok-th st=0 record; both files are cut back,
+!*  3. the nok kept frames are re-read (m-th frame = m-th st=0 record),
+!*  4. the journal is rewritten (tmp+rename),
+!*  5. all three files are reopened for appending,
+!*  6. only then xyz/ejr/done are set (so any failure above still
+!*     leaves the unmodified input for a fresh pass).
+!* Otherwise: fresh pass. Sets ich, ich2, jch, done(:), nok, ndone,
+!* ejr(:) and the kept xyz(:,:,z) of the host.
+!*****************************************************************
+    implicit none
+    character(len=160) :: hdr
+    character(len=256) :: line
+    character(len=4) :: sym
+    integer :: u,iou,zz,ss,nrec,nacc,nst0,m,ii,jj
+    integer,allocatable :: recz(:),recst(:)
+    real(wp),allocatable :: xr(:,:,:),er(:)
+    logical,allocatable :: seen(:)
+    integer(int64) :: nlx,nll
+    logical :: ok,exj,exx,exl,oa,ob,oc
+    integer :: iom
+
+    write (hdr,'(a,4(1x,i0),3(1x,z16.16))') 'OLOOPJ1',restart_step(),nall,nat,mycalc%optlev,jkey
+    ok = .false.
+    nrec = 0
+    nacc = 0
+    nok = 0
+    ndone = 0
+    inquire (file=fj,exist=exj)
+    inquire (file=fx,exist=exx)
+    inquire (file=fl,exist=exl)
+!>--- 1. parse the journal
+    if (ck_resume.and.exj.and.exx.and.exl) then
+      allocate (recz(nall),recst(nall),seen(nall))
+      seen(:) = .false.
+      open (newunit=u,file=fj,status='old',action='read',iostat=iou)
+      if (iou == 0) then
+        read (u,'(a)',iostat=iou) line
+        ok = (iou == 0.and.trim(line) == trim(hdr))
+        do while (ok)
+          read (u,'(a)',iostat=iou) line
+          if (iou /= 0) exit
+          zz = 0
+          ss = -1
+          read (line,*,iostat=iou) zz,ss
+          if (iou /= 0) exit                   !> torn or malformed line
+          if (zz < 1.or.zz > nall) exit
+          if (ss /= 0.and.ss /= 2) exit
+          if (seen(zz)) exit                   !> duplicate
+          seen(zz) = .true.
+          nrec = nrec+1
+          recz(nrec) = zz
+          recst(nrec) = ss
+        end do
+        close (u)
+      end if
+    end if
+!>--- 2. reconcile with the complete frames (M) and energy-log lines (L) on disk
+    if (ok) then
+      call count_lines(fx,nlx)
+      call count_lines(fl,nll)
+      nst0 = count(recst(1:nrec) == 0)
+      nok = int(max(0_int64,min(int(nst0,int64),nlx/int(nat+2,int64),nll)))
+      !>--- keep records in order up to the nok-th status-0 record
+      !>    (failures journaled before the next status-0 record are kept too)
+      m = 0
+      do ii = 1,nrec
+        if (recst(ii) == 0) then
+          if (m == nok) exit
+          m = m+1
+        end if
+        nacc = ii
+      end do
+      call truncate_lines(fx,int(nok,int64)*int(nat+2,int64),ok)
+      if (ok) call truncate_lines(fl,int(nok,int64),ok)
+    end if
+!>--- 3. re-read the kept frames: the m-th frame belongs to the m-th kept status-0 record
+    if (ok) then
+      allocate (xr(3,nat,max(nok,1)),er(max(nok,1)))
+      open (newunit=u,file=fx,status='old',action='read',iostat=iou)
+      ok = (iou == 0)
+      if (ok) then
+        do m = 1,nok
+          read (u,'(a)',iostat=iou) line            !> atom count
+          if (iou == 0) read (u,'(a)',iostat=iou) line   !> comment with Etot=
+          if (iou == 0) then
+            jj = index(line,'Etot=')
+            if (jj > 0) then
+              read (line(jj+5:),*,iostat=iou) er(m)
+            else
+              iou = 1
+            end if
+          end if
+          do jj = 1,nat
+            if (iou /= 0) exit
+            read (u,'(a)',iostat=iou) line
+            if (iou == 0) read (line,*,iostat=iou) sym,xr(1:3,jj,m)
+          end do
+          if (iou /= 0) then
+            ok = .false.
+            exit
+          end if
+        end do
+        close (u)
+      end if
+    end if
+!>--- 4. rewrite the journal with the kept records only (tmp + fsync + rename)
+    if (ok) then
+      open (newunit=u,file=fj//'.tmp',status='replace',action='write',iostat=iou)
+      if (iou == 0) then
+        write (u,'(a)',iostat=iou) trim(hdr)
+        do ii = 1,nacc
+          if (iou == 0) write (u,'(i0,1x,i0)',iostat=iou) recz(ii),recst(ii)
+        end do
+        call ck_commit(fj,u,iou)
+      end if
+      ok = (iou == 0)
+    end if
+!>--- 5. reopen all three files for appending
+    if (ok) then
+      open (newunit=ich,file=fx,status='old',position='append',action='write',iostat=iou)
+      if (iou == 0) then
+        open (newunit=ich2,file=fl,status='old',position='append',action='write',iostat=iou)
+        if (iou == 0) then
+          open (newunit=jch,file=fj,status='old',position='append',action='write',iostat=iou)
+          if (iou /= 0) close (ich2)
+        end if
+        if (iou /= 0) close (ich)
+      end if
+      ok = (iou == 0) !> should not fail; otherwise the pass starts fresh below
+    end if
+!>--- 6. apply the kept results (xyz in Bohr, Etot) and mark them done
+    if (ok) then
+      allocate (ejr(nall),source=0.0_wp)
+      m = 0
+      do ii = 1,nacc
+        zz = recz(ii)
+        done(zz) = .true.
+        if (recst(ii) == 0) then
+          m = m+1
+          xyz(:,:,zz) = xr(:,:,m)/bohr
+          ejr(zz) = er(m)
+        else
+          ejr(zz) = 1.0_wp
+        end if
+      end do
+      ndone = nacc
+      write (stdout,'(a,i0,a,i0,a,i0,a,i0,a)') 'CREST_CKPT> opt pass resumed: ',ndone,' of ', &
+      &      nall,' structures journaled (',nok,' optimized kept), ',nall-ndone,' to run'
+    else
+      if (ck_resume.and.exj) write (stdout,'(a)') &
+      &  'CREST_CKPT> opt journal not usable for this pass, running it fresh'
+      done(:) = .false.
+      nok = 0
+      ndone = 0
+      !>--- files of an earlier attempt are moved aside, never truncated in place
+      call oloop_move_aside(fx)
+      call oloop_move_aside(fl)
+      call oloop_move_aside(fj)
+      oa = .false.
+      ob = .false.
+      oc = .false.
+      open (newunit=ich,file=fx,status='replace',iostat=iou)
+      oa = (iou == 0)
+      if (oa) then
+        open (newunit=ich2,file=fl,status='replace',iostat=iou)
+        ob = (iou == 0)
+      end if
+      if (ob) then
+        open (newunit=jch,file=fj,status='replace',iostat=iou)
+        oc = (iou == 0)
+      end if
+      if (oc) write (jch,'(a)',iostat=iou) trim(hdr)
+      if (oc.and.iou == 0) flush (jch,iostat=iou)
+      if (iou /= 0) then
+        !>--- cannot journal (e.g. disk full): run this pass exactly as upstream
+        if (oc) close (jch,iostat=iom)
+        if (ob) close (ich2,iostat=iom)
+        if (oa) close (ich,iostat=iom)
+        write (stderr,'(a,i0,a)') 'CREST_CKPT> WARNING: cannot create the opt journal files ('//fx// &
+        &  ', status ',iou,'); this pass runs without journal'
+        jr = .false.
+        call mdckpt_disarm()
+        open (newunit=ich,file=ensemblefile)
+        open (newunit=ich2,file=ensembleelog)
+      end if
+    end if
+  end subroutine oloop_journal_open
+
+  subroutine oloop_move_aside(f)
+!> CREST_CKPT (no deletion): rename an existing file to the first unused <f>.stale[_k]
+    implicit none
+    character(len=*),intent(in) :: f
+    character(len=1100) :: nm
+    logical :: ex
+    integer :: ios
+    inquire (file=f,exist=ex)
+    if (.not.ex) return
+    call ck_unique(f//'.stale',nm)
+    call rename(f,trim(nm),ios)
+    if (ios /= 0) write (stderr,'(a,i0,a)') 'CREST_CKPT> WARNING: could not move aside '//f// &
+    &  ' (status ',ios,')'
+  end subroutine oloop_move_aside
+!========================================================================================!
+!> CREST_DIST_OLOOP internal routines (crest_dist_oloop_v2)
+!========================================================================================!
+  subroutine dist_worker_prepare()
+!*****************************************************************
+!* Worker: read the chunk named by CREST_DIST_OLOOP_WORKER, give
+!* env%calc the optimizer settings of the pass (optlev, hlow_opt,
+!* micro_opt, ... which ancopt_ensemble would otherwise reset) and
+!* require the driver's settings fingerprint. On any mismatch the
+!* worker refuses: no result, a <result>.mismatch file instead.
+!*****************************************************************
+    implicit none
+    character(len=dfplen) :: fpw
+    integer :: nfpw,natc,nc
+    logical :: okc
+    character(len=200) :: b
+    call dist_getenv('CREST_DIST_OLOOP_RESULT',dres,okc)
+    if (.not.okc) then
+      dres = trim(dpath)//'.result'
+      call dist_worker_refuse('CREST_DIST_OLOOP_RESULT is not set')
+      return
+    end if
+    call dist_read_chunk(trim(dpath),dwcid,dwnall,natc,nc,dwtn,dwnest,dfp,dnfp,diov,drov, &
+    &                    dwat,dwidx,dwxyz,dkey,okc)
+    if (.not.okc) then
+      call dist_worker_refuse('cannot read the chunk file '//trim(dpath))
+      return
+    end if
+    if (natc /= nat.or.nc /= nall) then
+      write (b,'(a,i0,a,i0,a,i0,a,i0)') 'chunk has nat=',natc,' n=',nc,'; the ensemble has nat=',nat,' n=',nall
+      call dist_worker_refuse(trim(b))
+      return
+    end if
+    if (any(dwat(:) /= at(:))) then
+      call dist_worker_refuse('atom types of chunk and ensemble differ')
+      return
+    end if
+    call dist_overrides_apply(env%calc,diov,drov)
+    call dist_fingerprint(env%calc,fpw,nfpw)
+    if (nfpw /= dnfp) then
+      call dist_worker_refuse('settings fingerprint differs from the driver',fpw(1:nfpw))
+      return
+    end if
+    if (fpw(1:nfpw) /= dfp(1:dnfp)) then
+      call dist_worker_refuse('settings fingerprint differs from the driver',fpw(1:nfpw))
+      return
+    end if
+    write (stdout,'(a,i0,a,i0,a,i0,a,i0,a,es10.3)') 'CREST_DIST> worker: chunk ',dwcid,' (',nall, &
+    &  ' structures): settings fingerprint matches the driver; optlev ',diov(1),', micro_opt ',diov(2), &
+    &  ', hlow_opt ',drov(4)
+  end subroutine dist_worker_prepare
+
+  subroutine dist_worker_refuse(msg,fpw)
+    implicit none
+    character(len=*),intent(in) :: msg
+    character(len=*),intent(in),optional :: fpw
+    integer :: u,iou
+    dwbad = .true.
+    env%iostatus_meta = status_failed
+    write (stderr,'(a)') '**ERROR** CREST_DIST> worker refuses its chunk: '//msg
+    open (newunit=u,file=trim(dres)//'.mismatch',status='replace',action='write',iostat=iou)
+    if (iou == 0) then
+      write (u,'(a)') msg
+      if (present(fpw)) then
+        write (u,'(a)') '--- driver settings'
+        write (u,'(a)') dfp(1:dnfp)
+        write (u,'(a)') '--- worker settings'
+        write (u,'(a)') fpw
+      end if
+      close (u)
+    end if
+  end subroutine dist_worker_refuse
+
+  subroutine dist_record(zz,st,e,jb)
+!> Worker: keep the result of structure zz exactly as the loop has it
+!> (xyz before molsnew%append rounds it through Angstrom; gnorm is taken
+!> from the loop's own gnorm statement, see the success branch)
+    implicit none
+    integer,intent(in) :: zz,st,jb
+    real(wp),intent(in) :: e
+    dst(zz) = st
+    if (st == 0.or.st == 1) then
+      den(zz) = e
+      dxyz(:,:,zz) = molsnew(jb)%xyz(:,:)
+    else
+      den(zz) = 1.0_wp
+    end if
+    if (st == 0) then
+      if (allocated(calculations(jb)%etmp)) then
+        if (size(calculations(jb)%etmp) == dnetmp) det(:,zz) = calculations(jb)%etmp(:)
+      end if
+    end if
+  end subroutine dist_record
+
+  subroutine dist_worker_finish()
+    implicit none
+    character(len=64) :: cpu,sha
+    character(len=1024) :: exe
+    character(len=32) :: jb
+    integer :: iow
+    if (dwbad) return
+    if (any(dst(:) < 0).or.any(dst(:) > 2)) then
+      env%iostatus_meta = status_failed
+      write (stderr,'(a)') '**ERROR** CREST_DIST> worker: not every structure has a result; no result file written'
+      return
+    end if
+    call dist_cpu_model(cpu)
+    call dist_exe_sha(sha,exe)
+    call dist_jobid(jb)
+    call dist_write_result(trim(dres),dwcid,nall,nat,dnetmp,1,dkey,cpu,sha,jb,dwidx,dst,den,dgn,det,dxyz,iow)
+    if (iow /= 0) then
+      env%iostatus_meta = status_failed
+      write (stderr,'(a,i0,a)') '**ERROR** CREST_DIST> worker: could not write '//trim(dres)//' (status ',iow,')'
+    else
+      write (stdout,'(a,i0,a,i0,a,i0,a,i0,a)') 'CREST_DIST> worker: chunk ',dwcid,' result written (', &
+      &  count(dst == 0),' optimized, ',count(dst == 1),' partial, ',count(dst == 2),' failed)'
+    end if
+  end subroutine dist_worker_finish
+
+  logical function dist_eligible() result(okel)
+    implicit none
+    character(len=120) :: why
+    okel = .false.
+    why = ''
+    if (gpu_active) then
+      why = 'GPU solver active'
+    else if (Tn /= 1) then
+      why = 'more than one thread per structure'
+    else if (mycalc%ncalculations /= 1) then
+      why = 'more than one calculation level'
+    else if (mycalc%calcs(1)%id /= jobtype%tblite) then
+      why = 'the level is not tblite'
+    else if (mycalc%calcs(1)%tblitelvl /= xtblvl%gfn2.and.mycalc%calcs(1)%tblitelvl /= xtblvl%gfn1) then
+      why = 'the tblite level is not GFN2 or GFN1'
+    else if (mycalc%nconstraints /= 0.or.mycalc%nfreeze /= 0.or.mycalc%nscans /= 0) then
+      why = 'constraints, frozen atoms or scans'
+    else if (allocated(mycalc%ONIOM)) then
+      why = 'ONIOM'
+    else
+      okel = .true.
+    end if
+    if (.not.okel) write (stdout,'(a)') 'CREST_DIST> this pass runs in-process: '//trim(why)
+  end function dist_eligible
+
+  subroutine dist_driver(okd)
+!*****************************************************************
+!* Driver (crest_dist_oloop_v2/README.md):
+!*  1. pass folder <workdir>/pass_<id>, id = hash(settings, sha256 of
+!*     this crest binary, input); an existing folder is reused only if
+!*     its PASS.txt names the same binary and settings fingerprint
+!*     (results on disk are not recomputed, e.g. after a preemption)
+!*  2. chunk files: chunk ic holds z = ic+1, ic+1+nch, ... (strided)
+!*  3. one Slurm array of workers; squeue is queried every poll s for
+!*     the whole pass (also after a worker refused); a chunk is
+!*     resubmitted only after it stayed out of squeue without a result
+!*     for lost_wait s (files written on other nodes can stay invisible
+!*     here for a while), at most max_rounds submissions per chunk;
+!*     meanwhile the driver computes chunks that no worker is running
+!*     and cancels their pending tasks
+!*  4. results read back (atomic files with checksum, same binary
+!*     required); bitwise spot check of same-CPU worker results and a
+!*     tolerance check of other-CPU worker results against the driver
+!* okd=.false.: the pass runs in-process as usual.
+!*****************************************************************
+    implicit none
+    logical,intent(out) :: okd
+    character(len=1100) :: pdir,f,f2
+    character(len=16) :: pid,jtag
+    character(len=64) :: mycpu,rcpu,mysha,rsha
+    character(len=1024) :: myexe
+    character(len=32) :: rjob
+    character(len=40) :: c4,rr
+    character(len=32768) :: rl,cmd,ids
+    character(len=4096) :: line,kk
+    character(len=40) :: rbuf
+    character(len=512) :: tl(24)
+    character(len=dfplen) :: fpr
+    integer :: s_,nch,tw,ic,m,zz,pp,ii,u,io2,lr,es,cs,nrounds,nb,nl,nwk,nwko,nlo
+    integer :: rcid,rn,rnat,rnetmp,rwriter,nv,nvok,stp,kexit,nexit,nloc,jid,n1,n2,nhave,lastp
+    integer :: nqfail,nsfail,nunneeded,nfp,lf,aj,nt
+    integer(int64) :: rkey(3),t0,t1,trate,tq,tact,tprint,tnextsub
+    integer,allocatable :: csize(:),list(:),zl(:),ridx(:),rst2(:),vz(:),nsub(:),lastjob(:)
+    integer(int64),allocatable :: gone(:)
+    real(wp),allocatable :: ren(:),rgn(:),ret(:,:),rxyz(:,:,:)
+    real(wp) :: de,rmsd,demax,rmsdmax
+    logical,allocatable :: need(:),have(:),live(:),runn(:),mism(:),sel(:),msk(:)
+    logical :: ex,qok,bad,okr,first,localon,same,opened,okx,newpass
+    character(len=16) :: texit
+    character(len=40) :: g1,g2
+
+    okd = .false.
+    call system_clock(t0,trate)
+    call dist_cpu_model(mycpu)
+    call dist_exe_sha(mysha,myexe)
+    if (mysha == 'unknown') then
+      if (dcfg%submit /= 0) then
+        write (stderr,'(a)') 'CREST_DIST> WARNING: cannot determine the sha256 of this crest binary, so workers '// &
+        &  'cannot be checked against it; this pass runs in-process'
+        return
+      end if
+      write (stderr,'(a)') 'CREST_DIST> WARNING: cannot determine the sha256 of this crest binary (local mode)'
+    end if
+!>--- test-only switch: CREST_DIST_OLOOP_TEST_EXIT=chunks:<n> or merge:<n> ends the process
+!>    abruptly (like a preemption) after n local chunks or n merged structures
+    kexit = 0
+    nexit = 0
+    call dist_getenv('CREST_DIST_OLOOP_TEST_EXIT',texit,ex)
+    if (ex) then
+      ii = index(texit,':')
+      if (ii > 1) then
+        read (texit(ii+1:),*,iostat=io2) nexit
+        if (io2 == 0.and.texit(1:ii-1) == 'chunks') kexit = 1
+        if (io2 == 0.and.texit(1:ii-1) == 'merge') kexit = 2
+      end if
+    end if
+
+!>--- 1. pass identity (settings, binary, input) and folder
+    call dist_overrides_get(mycalc,diov,drov)
+    call dist_fingerprint(mycalc,dfp,dnfp,cpu_solver=opt_cpu) !> hybrid v1: effective solver of the pass
+    dkey = xyz_key(nat,nall,dxyz0)
+    call dist_hash_hex(dfp(1:dnfp)//'exe='//trim(mysha)//achar(10),nat,nall,dkey,pid)
+    pdir = trim(dcfg%workdir)//'/pass_'//pid
+!>--- worker array name cdo_<jtag>, jtag = hash of the pass folder path: drivers of the same pass in
+!>    different workdirs (twin jobs, repeated tests) never take each other's tasks for their own;
+!>    a requeued driver (same folder) finds its tasks again
+    call dist_hash_hex(trim(pdir),nat,nall,dkey,jtag)
+    write (kk,'(3(z16.16,1x))') dkey
+    f = trim(pdir)//'/PASS.txt'
+    inquire (file=trim(f),exist=ex)
+    newpass = .not.ex
+    if (ex) then
+      !>--- reuse only a folder of the same pass: header, input key, binary and settings fingerprint
+      okr = .false.
+      n1 = -1
+      n2 = -1
+      s_ = 0
+      nch = 0
+      tw = 0
+      nfp = 0
+      open (newunit=u,file=trim(f),status='old',action='read',iostat=io2)
+      if (io2 == 0) then
+        read (u,'(a)',iostat=io2) line
+        okr = (io2 == 0.and.trim(line) == 'OLOOPD2 '//pid)
+        if (okr) read (u,'(a)',iostat=io2) line
+        if (okr.and.io2 == 0) read (line,*,iostat=io2) n1,n2,s_,nch,tw
+        okr = okr.and.io2 == 0
+        if (okr) read (u,'(a)',iostat=io2) line
+        okr = okr.and.io2 == 0.and.trim(line) == trim(kk)
+        if (okr) read (u,'(a)',iostat=io2) line
+        okr = okr.and.io2 == 0.and.trim(line) == 'exe '//trim(mysha)
+        if (okr) read (u,'(a)',iostat=io2) line  !> driver cpu (information only)
+        okr = okr.and.io2 == 0
+        fpr = ''
+        do while (okr)
+          read (u,'(a)',iostat=io2) line
+          if (io2 /= 0) exit
+          lf = len_trim(line)
+          if (lf == 0) cycle
+          if (nfp+lf+1 > dfplen) then
+            okr = .false.
+            exit
+          end if
+          fpr(nfp+1:nfp+lf) = line(1:lf)
+          nfp = nfp+lf+1
+          fpr(nfp:nfp) = achar(10)
+        end do
+        close (u)
+        if (okr) okr = (nfp == dnfp)
+        if (okr) okr = (fpr(1:nfp) == dfp(1:dnfp))
+      end if
+      if (okr) okr = (n1 == nall.and.n2 == nat.and.s_ >= 1.and.nch >= 1.and.nch <= 1001.and.tw >= 1)
+      if (.not.okr) then
+        write (stderr,'(a)') 'CREST_DIST> WARNING: '//trim(f)//' is unreadable or names another pass, binary or '// &
+        &  'settings fingerprint; this pass runs in-process'
+        return
+      end if
+      write (stdout,'(a)') 'CREST_DIST> pass '//pid//': reusing '//trim(pdir)
+    else
+      s_ = max(dcfg%chunk,(nall+999)/1000)
+      nch = (nall+s_-1)/s_
+      tw = max(1,min(dcfg%worker_threads,nall/nch))
+      cmd = 'mkdir -p '//trim(pdir)//'/chunks '//trim(pdir)//'/results '//trim(pdir)//'/logs '// &
+      &     trim(pdir)//'/submit'
+      call execute_command_line(trim(cmd),exitstat=es,cmdstat=cs)
+      if (es /= 0.or.cs /= 0) then
+        write (stderr,'(a)') 'CREST_DIST> WARNING: cannot create '//trim(pdir)//'; this pass runs in-process'
+        return
+      end if
+      open (newunit=u,file=trim(pdir)//'/chunks.tsv',status='replace',action='write',iostat=io2)
+      if (io2 == 0) then
+        do ic = 0,nch-1
+          nl = (nall-(ic+1))/nch+1
+          zl = [(ic+1+m*nch,m=0,nl-1)]
+          write (c4,'(i4.4)') ic
+          call dist_write_chunk(trim(pdir)//'/chunks/chunk_'//trim(c4)//'.bin',ic,nall,nat,nl,Tn, &
+          &                     nested,dfp,dnfp,diov,drov,at,zl,dxyz0(:,:,zl),dkey,io2)
+          if (io2 == 0) write (u,'(i0,1x,i0)',iostat=io2) ic,nl
+          if (io2 /= 0) exit
+        end do
+        close (u,iostat=es)
+        if (io2 == 0) io2 = es
+      end if
+!>--- ref.xyz (first input structure, Angstrom): sizes the worker's dummy ensemble
+      if (io2 == 0) open (newunit=u,file=trim(pdir)//'/ref.xyz',status='replace',action='write',iostat=io2)
+      if (io2 == 0) then
+        write (u,'(2x,i0)',iostat=io2) nat
+        if (io2 == 0) write (u,'(a)',iostat=io2) 'crest_dist_oloop pass '//pid
+        do ii = 1,nat
+          if (io2 == 0) write (u,'(1x,a2,1x,3f20.10)',iostat=io2) i2e(at(ii),'nc'),dxyz0(1:3,ii,1)*bohr
+        end do
+        close (u,iostat=es)
+        if (io2 == 0) io2 = es
+      end if
+!>--- worker input: the level of this pass as TOML (dist_eligible: one tblite GFN2/GFN1 level);
+!>    the worker checks the parsed result against the fingerprint
+      nt = 0
+      call dist_tla(tl,nt,'# CREST_DIST_OLOOP worker input for pass '//pid//' (written by the driver)')
+      call dist_tla(tl,nt,'input = "ref.xyz"')
+      call dist_tla(tl,nt,'ensemble_input = "ensemble.xyz"')
+      call dist_tla(tl,nt,'runtype = "ancopt_ensemble"')
+      write (rbuf,'(i0)') tw
+      call dist_tla(tl,nt,'threads = '//trim(rbuf))
+      if (nested) then
+        call dist_tla(tl,nt,'omp_nested = true')
+      else
+        call dist_tla(tl,nt,'omp_nested = false')
+      end if
+      call dist_tla(tl,nt,'')
+      call dist_tla(tl,nt,'[[calculation.level]]')
+      if (mycalc%calcs(1)%tblitelvl == xtblvl%gfn2) then
+        call dist_tla(tl,nt,'method = "gfn2"')
+      else
+        call dist_tla(tl,nt,'method = "gfn1"')
+      end if
+      write (rbuf,'(i0)') mycalc%calcs(1)%chrg
+      call dist_tla(tl,nt,'charge = '//trim(rbuf))
+      write (rbuf,'(i0)') mycalc%calcs(1)%uhf
+      call dist_tla(tl,nt,'uhf = '//trim(rbuf))
+      if (allocated(mycalc%calcs(1)%solvmodel).and.allocated(mycalc%calcs(1)%solvent)) then
+        if (len_trim(mycalc%calcs(1)%solvmodel) > 0.and.len_trim(mycalc%calcs(1)%solvent) > 0) &
+        &  call dist_tla(tl,nt,trim(mycalc%calcs(1)%solvmodel)//' = "'//trim(mycalc%calcs(1)%solvent)//'"')
+      end if
+      write (rbuf,'(es25.17)') mycalc%calcs(1)%etemp
+      call dist_tla(tl,nt,'etemp = '//trim(adjustl(rbuf)))
+      write (rbuf,'(es25.17)') mycalc%calcs(1)%accuracy
+      call dist_tla(tl,nt,'accuracy = '//trim(adjustl(rbuf)))
+      write (rbuf,'(i0)') mycalc%calcs(1)%maxscc
+      call dist_tla(tl,nt,'maxscc = '//trim(rbuf))
+      if (mycalc%calcs(1)%tblite_solver == 1.and..not.opt_cpu) then !> hybrid v1: CPU workers under CREST_OPT_SOLVER=cpu
+        call dist_tla(tl,nt,'tblite_solver = "cuda"')
+      else
+        call dist_tla(tl,nt,'tblite_solver = "cpu"')
+      end if
+      if (mycalc%calcs(1)%tblite_gpu_audit) then
+        call dist_tla(tl,nt,'tblite_gpu_audit = true')
+      else
+        call dist_tla(tl,nt,'tblite_gpu_audit = false')
+      end if
+      if (io2 == 0) open (newunit=u,file=trim(pdir)//'/worker.toml',status='replace',action='write',iostat=io2)
+      if (io2 == 0) then
+        do ii = 1,nt
+          if (io2 == 0) write (u,'(a)',iostat=io2) trim(tl(ii))
+        end do
+        close (u,iostat=es)
+        if (io2 == 0) io2 = es
+      end if
+      if (io2 /= 0) then
+        write (stderr,'(a)') 'CREST_DIST> WARNING: cannot write the pass files in '//trim(pdir)// &
+        &  '; this pass runs in-process'
+        return
+      end if
+    end if
+
+!>--- worker.env (new and reused folders): threads, the worker environment script of the current
+!>    config and this binary (path and sha256; the pass id already contains the sha256)
+    open (newunit=u,file=trim(pdir)//'/worker.env.tmp',status='replace',action='write',iostat=io2)
+    if (io2 == 0) then
+      write (u,'(a)',iostat=io2) 'PASS_ID='//pid
+      if (io2 == 0) write (u,'(a,i0)',iostat=io2) 'TW=',tw
+      if (io2 == 0) write (u,'(a,i0)',iostat=io2) 'NCHUNK=',nch
+      if (io2 == 0) write (u,'(a)',iostat=io2) 'WORKER_ENV='//trim(dcfg%worker_env)
+      if (io2 == 0) write (u,'(a)',iostat=io2) 'CREST_EXE='//trim(myexe)
+      if (io2 == 0) write (u,'(a)',iostat=io2) 'CREST_SHA='//trim(mysha)
+      close (u,iostat=es)
+      if (io2 == 0) io2 = es
+      if (io2 == 0) call rename(trim(pdir)//'/worker.env.tmp',trim(pdir)//'/worker.env',io2)
+    end if
+!>--- PASS.txt last: the folder is complete
+    if (io2 == 0.and.newpass) then
+      open (newunit=u,file=trim(f)//'.tmp',status='replace',action='write',iostat=io2)
+      if (io2 == 0) then
+        write (u,'(a)',iostat=io2) 'OLOOPD2 '//pid
+        if (io2 == 0) write (u,'(i0,4(1x,i0))',iostat=io2) nall,nat,s_,nch,tw
+        if (io2 == 0) write (u,'(a)',iostat=io2) trim(kk)
+        if (io2 == 0) write (u,'(a)',iostat=io2) 'exe '//trim(mysha)
+        if (io2 == 0) write (u,'(a)',iostat=io2) 'driver cpu: '//trim(mycpu)
+        if (io2 == 0) write (u,'(a)',iostat=io2) dfp(1:dnfp)
+        close (u,iostat=es)
+        if (io2 == 0) io2 = es
+        if (io2 == 0) call rename(trim(f)//'.tmp',trim(f),io2)
+      end if
+    end if
+    if (io2 /= 0) then
+      write (stderr,'(a)') 'CREST_DIST> WARNING: cannot write the pass files in '//trim(pdir)// &
+      &  '; this pass runs in-process'
+      return
+    end if
+    if (newpass) write (stdout,'(a,i0,a,i0,a,i0,a,i0,a)') 'CREST_DIST> pass '//pid//': ',nall,' structures in ',nch, &
+    &  ' chunks of ',s_,' (worker -T ',tw,') in '//trim(pdir)
+
+!>--- 2. bookkeeping of chunks and results
+    allocate (csize(0:nch-1),need(0:nch-1),have(0:nch-1),live(0:nch-1),runn(0:nch-1),mism(0:nch-1))
+    allocate (sel(0:nch-1),msk(0:nch-1))
+    allocate (nsub(0:nch-1),lastjob(0:nch-1),source=0)
+    allocate (gone(0:nch-1),source=0_int64)
+    do ic = 0,nch-1
+      csize(ic) = (nall-(ic+1))/nch+1
+    end do
+    need(:) = .false.
+    do zz = 1,nall
+      if (.not.done(zz)) need(mod(zz-1,nch)) = .true.
+    end do
+    have(:) = .false.
+    live(:) = .false.
+    runn(:) = .false.
+    mism(:) = .false.
+    sel(:) = .false.
+    allocate (dst(nall),source=-1)
+    allocate (dsrc(nall),source=0)
+    allocate (den(nall),dgn(nall),source=0.0_wp)
+    allocate (det(dnetmp,nall),source=0.0_wp)
+    allocate (dxyz(3,nat,nall),source=0.0_wp)
+!>--- earlier submissions of this pass (a requeued driver): jobs.txt lines "<round> <array job> <chunks>"
+    nrounds = 0
+    open (newunit=u,file=trim(pdir)//'/jobs.txt',status='old',action='read',iostat=io2)
+    if (io2 == 0) then
+      do
+        read (u,'(a)',iostat=io2) line
+        if (io2 /= 0) exit
+        line = adjustl(line)
+        ii = index(line,' ')
+        if (ii < 2) cycle
+        read (line(1:ii-1),*,iostat=io2) n1
+        if (io2 /= 0) cycle
+        nrounds = max(nrounds,n1)
+        line = adjustl(line(ii+1:))
+        ii = index(line,' ')
+        if (ii < 2) cycle
+        read (line(1:ii-1),*,iostat=io2) jid
+        if (io2 /= 0.or.jid <= 0) cycle
+        rl = adjustl(line(ii+1:))
+        ii = index(rl,' ')
+        if (ii > 0) rl(ii:) = ''
+        call dist_parse_ranges(trim(rl),nch,msk,okr)
+        if (.not.okr) cycle
+        where (msk)
+          nsub = nsub+1
+          lastjob = jid
+        end where
+      end do
+      close (u)
+    end if
+    localon = (dcfg%local /= 0)
+    bad = .false.
+    first = .true.
+    tq = t0
+    tact = t0
+    tprint = t0
+    tnextsub = t0
+    nqfail = 0
+    nsfail = 0
+    nloc = 0
+    lastp = -1
+    nunneeded = 0
+    nb = max(1,(2*T+minval(csize)-1)/minval(csize))
+
+!>--- 3. main loop: query, collect, submit, compute locally or wait
+    do
+      call system_clock(t1)
+      qok = .false.
+      !>--- squeue for the whole pass, also after a worker refused: chunks seen running are not
+      !>    computed locally, so the running state must stay current (review F1)
+      if (dcfg%submit /= 0) then
+        if (first.or.real(t1-tq,wp)/real(trate,wp) >= real(dcfg%poll,wp)) then
+          first = .false.
+          tq = t1
+          cmd = 'squeue -h -r -u "$(id -un)" --name=cdo_'//jtag(1:10)//' -o "%i %T" > '//trim(pdir)// &
+          &     '/squeue.txt 2> '//trim(pdir)//'/squeue.err'
+          call execute_command_line(trim(cmd),exitstat=es,cmdstat=cs)
+          qok = (es == 0.and.cs == 0)
+          live(:) = .false.
+          runn(:) = .false.
+          opened = .false.
+          if (qok) then
+            open (newunit=u,file=trim(pdir)//'/squeue.txt',status='old',action='read',iostat=io2)
+            opened = (io2 == 0)
+            qok = opened
+          end if
+          do while (qok)
+            read (u,'(a)',iostat=io2) line
+            if (io2 /= 0) exit
+            if (len_trim(line) == 0) cycle
+            ii = index(line,'_')
+            ic = -1
+            io2 = 1
+            if (ii > 0) read (line(ii+1:),*,iostat=io2) ic
+            if (io2 /= 0.or.ic < 0.or.ic >= nch) then
+              qok = .false.   !> unexpected line: no submission decision in this round
+              exit
+            end if
+            live(ic) = .true.
+            if (index(line,' RUNNING') > 0.or.index(line,' COMPLETING') > 0.or.index(line,' CONFIGURING') > 0) &
+            &  runn(ic) = .true.
+          end do
+          if (opened) close (u)
+          if (qok) then
+            nqfail = 0
+            if (any(runn)) tact = t1
+            !>--- time a chunk was first seen out of squeue without a result (review F2)
+            do ic = 0,nch-1
+              if (live(ic)) then
+                gone(ic) = 0
+              else if (need(ic).and..not.have(ic).and.gone(ic) == 0) then
+                gone(ic) = max(t1,1_int64)
+              end if
+            end do
+          else
+            nqfail = nqfail+1
+            if (nqfail >= 5.and..not.localon) then
+              localon = .true.
+              write (stdout,'(a,i0,a)') 'CREST_DIST> squeue failed ',nqfail,' times in a row; the driver computes chunks too'
+            end if
+          end if
+        end if
+      end if
+
+      !>--- collect results (atomic files; written by this binary; checksum checked on reading)
+      do ic = 0,nch-1
+        if (.not.need(ic).or.have(ic)) cycle
+        write (c4,'(i4.4)') ic
+        f = trim(pdir)//'/results/chunk_'//trim(c4)//'.bin'
+        inquire (file=trim(f),exist=ex)
+        if (ex) then
+          call dist_read_result(trim(f),rcid,rn,rnat,rnetmp,rwriter,rkey,rcpu,rsha,rjob,ridx,rst2,ren,rgn,ret,rxyz,okr)
+          if (okr) okr = (rcid == ic.and.rn == csize(ic).and.rnat == nat.and.rnetmp == dnetmp.and.all(rkey == dkey))
+          if (okr) okr = (rsha == mysha)
+          if (okr) then
+            do pp = 1,rn
+              if (ridx(pp) /= ic+1+(pp-1)*nch.or.rst2(pp) < 0.or.rst2(pp) > 2) okr = .false.
+            end do
+          end if
+          if (okr) then
+            do pp = 1,rn
+              zz = ridx(pp)
+              dst(zz) = rst2(pp)
+              den(zz) = ren(pp)
+              dgn(zz) = rgn(pp)
+              det(:,zz) = ret(:,pp)
+              dxyz(:,:,zz) = rxyz(:,:,pp)
+              if (rwriter == 2) then
+                dsrc(zz) = 3
+              else if (rcpu == mycpu) then
+                dsrc(zz) = 1
+              else
+                dsrc(zz) = 2
+              end if
+            end do
+            have(ic) = .true.
+            tact = t1
+            if (rwriter == 1) then  !> written by the task of an earlier submission: the last one was unneeded
+              aj = -1
+              ii = index(rjob,'_')
+              if (ii > 1) read (rjob(1:ii-1),*,iostat=io2) aj
+              if (aj > 0.and.lastjob(ic) > 0.and.aj /= lastjob(ic)) nunneeded = nunneeded+1
+            end if
+          else
+            do ii = 1,9999
+              write (f2,'(a,a,i0)') trim(f),'.bad_',ii
+              inquire (file=trim(f2),exist=ex)
+              if (.not.ex) exit
+            end do
+            call rename(trim(f),trim(f2),io2)
+            write (stderr,'(a)') 'CREST_DIST> WARNING: unusable result file (format, checksum, pass or crest binary) '// &
+            &  'moved to '//trim(f2)
+          end if
+        end if
+        if (.not.have(ic).and..not.mism(ic)) then
+          inquire (file=trim(f)//'.mismatch',exist=ex)
+          if (ex) then
+            mism(ic) = .true.
+            if (.not.bad) then
+              bad = .true.
+              write (stderr,'(a)') '**ERROR** CREST_DIST> a worker refused chunk '//trim(c4)//' (see '//trim(f)// &
+              &  '.mismatch): no more submissions; pending worker tasks are cancelled and the driver computes '// &
+              &  'the remaining chunks itself'
+              ids = ''
+              do ii = 0,nch-1
+                if (lastjob(ii) > 0) then
+                  write (rbuf,'(i0)') lastjob(ii)
+                  if (index(' '//trim(ids)//' ',' '//trim(rbuf)//' ') == 0) ids = trim(ids)//' '//trim(rbuf)
+                end if
+              end do
+              if (len_trim(ids) > 0) call dist_scancel(trim(ids))
+            end if
+          end if
+        end if
+      end do
+      if (bad) localon = .true.
+      if (all(have.or..not.need)) exit
+
+      !>--- no worker running and no new result for local_after s: the driver computes too (review F5)
+      if (.not.localon.and.dcfg%local_after > 0) then
+        if (real(t1-tact,wp)/real(trate,wp) >= real(dcfg%local_after,wp)) then
+          localon = .true.
+          write (stdout,'(a,i0,a)') 'CREST_DIST> no worker ran and no result arrived for ',dcfg%local_after, &
+          &  ' s; the driver computes chunks too'
+        end if
+      end if
+
+      !>--- submit chunks that have no result and are not in squeue: never submitted, or out of
+      !>    squeue for at least lost_wait s (review F2); at most max_rounds submissions per chunk
+      if (qok.and..not.bad.and.t1 >= tnextsub) then
+        sel = need.and..not.have.and..not.live.and.nsub < dcfg%max_rounds
+        do ic = 0,nch-1
+          if (sel(ic).and.nsub(ic) > 0) sel(ic) = (gone(ic) > 0.and. &
+          &  real(t1-gone(ic),wp)/real(trate,wp) >= real(dcfg%lost_wait,wp))
+        end do
+        nl = count(sel)
+        if (nl > 0) then
+          list = pack([(ic,ic=0,nch-1)],sel)
+          call dist_ranges(list,nl,rl,lr)
+          nrounds = nrounds+1
+          write (rr,'(i0)') nrounds
+          write (cmd,'(a,i0,a,i0,a)') 'sbatch --parsable --export=NONE --job-name=cdo_'//jtag(1:10)// &
+          &  ' --array='//rl(1:lr)//'%',min(dcfg%throttle,nl),' --cpus-per-task=',tw, &
+          &  ' --output='//trim(pdir)//'/logs/w_%A_%a.out '//trim(dcfg%sbatch_args)//' '// &
+          &  trim(dcfg%worker_script)//' '//trim(pdir)//' > '//trim(pdir)//'/submit/sub_'//trim(rr)// &
+          &  '.out 2> '//trim(pdir)//'/submit/sub_'//trim(rr)//'.err'
+          call execute_command_line(trim(cmd),exitstat=es,cmdstat=cs)
+          jid = -1
+          if (es == 0.and.cs == 0) then
+            open (newunit=u,file=trim(pdir)//'/submit/sub_'//trim(rr)//'.out',status='old',action='read',iostat=io2)
+            if (io2 == 0) then
+              do  !> first line that is a job id (sbatch --parsable: <id> or <id>;<cluster>)
+                read (u,'(a)',iostat=io2) line
+                if (io2 /= 0) exit
+                ii = index(line,';')
+                if (ii > 0) line(ii:) = ''
+                read (line,*,iostat=io2) jid
+                if (io2 == 0.and.jid > 0) exit
+                jid = -1
+              end do
+              close (u)
+            end if
+          end if
+          open (newunit=u,file=trim(pdir)//'/jobs.txt',position='append',action='write',iostat=io2)
+          if (io2 == 0) then
+            if (jid > 0) then
+              write (u,'(i0,1x,i0,1x,a)',iostat=io2) nrounds,jid,rl(1:lr)
+            else
+              write (u,'(i0,1x,i0,1x,a,a)',iostat=io2) nrounds,jid,rl(1:lr),' sbatch-failed'
+            end if
+            close (u)
+          end if
+          if (jid > 0) then
+            write (stdout,'(a,i0,a,i0,a,i0,a,i0,a)') 'CREST_DIST> submitted array job ',jid,' for ',nl, &
+            &  ' chunks (round ',nrounds,', ',count(sel.and.nsub > 0),' resubmitted)'
+            nsub(list) = nsub(list)+1
+            lastjob(list) = jid
+            live(list) = .true.
+            gone(list) = 0
+            nsfail = 0
+          else
+            !>--- a failed sbatch uses no submission of the chunks; back off (review F5)
+            nsfail = nsfail+1
+            tnextsub = t1+int(min(600.0_wp,real(dcfg%poll,wp)*2.0_wp**min(nsfail,10))*real(trate,wp),int64)
+            write (stderr,'(a,i0,a)') 'CREST_DIST> WARNING: sbatch failed (round ',nrounds,'), see '// &
+            &  trim(pdir)//'/submit/sub_'//trim(rr)//'.err'
+            if (nsfail >= 5.and..not.localon) then
+              localon = .true.
+              write (stdout,'(a,i0,a)') 'CREST_DIST> sbatch failed ',nsfail,' times in a row; the driver computes chunks too'
+            end if
+          end if
+        end if
+        if (.not.localon) then
+          if (any(need.and..not.have.and..not.live.and.nsub >= dcfg%max_rounds)) then
+            localon = .true.
+            write (stdout,'(a)') 'CREST_DIST> a chunk used up its max_rounds submissions; the driver computes chunks too'
+          end if
+        end if
+      end if
+
+      !>--- progress line when something changed, else every 10 min
+      nhave = count(have.and.need)
+      if (nhave /= lastp.or.real(t1-tprint,wp)/real(trate,wp) >= 600.0_wp) then
+        lastp = nhave
+        tprint = t1
+        write (stdout,'(a,i0,a,i0,a,i0,a,i0,a,f10.1,a)') 'CREST_DIST> ',nhave,' of ',count(need), &
+        &  ' chunks done (',count(runn.and..not.have),' running in workers, ',nloc,' computed here), ', &
+        &  real(t1-t0,wp)/real(trate,wp),' s'
+        flush (stdout)
+      end if
+
+      !>--- compute chunks locally that no worker is running (highest index first); a chunk whose
+      !>    task left squeue less than lost_wait s ago is skipped (its result may not be visible yet)
+      if (localon) then
+        sel = need.and..not.have.and..not.runn
+        do ic = 0,nch-1
+          if (sel(ic).and..not.mism(ic).and.nsub(ic) > 0.and.gone(ic) > 0) &
+          &  sel(ic) = (real(t1-gone(ic),wp)/real(trate,wp) >= real(dcfg%lost_wait,wp))
+        end do
+        nl = count(sel)
+        if (nl > 0) then
+          list = pack([(ic,ic=nch-1,0,-1)],[(sel(ic),ic=nch-1,0,-1)])
+          nl = min(nb,nl)
+          !>--- their pending worker tasks are cancelled (review F9)
+          ids = ''
+          do ii = 1,nl
+            ic = list(ii)
+            if (live(ic).and.lastjob(ic) > 0) then
+              write (rbuf,'(i0,a,i0)') lastjob(ic),'_',ic
+              ids = trim(ids)//' '//trim(rbuf)
+            end if
+          end do
+          if (len_trim(ids) > 0) call dist_scancel(trim(ids))
+          call dist_chunks_local(trim(pdir),nch,csize,list(1:nl),mycpu,mysha,.false.,nloc,kexit,nexit)
+          have(list(1:nl)) = .true.
+          live(list(1:nl)) = .false.
+          cycle
+        end if
+      end if
+      call sleep(dcfg%poll)
+    end do
+
+!>--- 4. summary, bitwise spot check of same-CPU worker results, tolerance check of other-CPU ones
+    if (any(dst(todo) < 0)) then
+      write (stderr,'(a)') '**ERROR** CREST_DIST> internal: a structure of the pass has no result; the pass runs in-process'
+      return
+    end if
+    call system_clock(t1)
+    nwk = count(dsrc == 1.and..not.done)
+    nwko = count(dsrc == 2.and..not.done)
+    nlo = count(dsrc == 3.and..not.done)
+    write (stdout,'(a,i0,a,i0,a,i0,a,i0,a,i0,a,i0,a,f10.1,a)') 'CREST_DIST> pass '//pid//': all ',count(need), &
+    &  ' chunks done; structures from workers (same CPU model) ',nwk,', workers (other CPU model) ',nwko, &
+    &  ', this driver ',nlo,'; ',nrounds,' array submissions (',nunneeded,' unneeded); ', &
+    &  real(t1-t0,wp)/real(trate,wp),' s'
+    nv = min(dcfg%verify,nwk)
+    if (nv > 0) then
+      list = pack([(zz,zz=1,nall)],dsrc == 1.and..not.done)
+      stp = max(1,nwk/nv)
+      vz = [(list(1+(ii-1)*stp),ii=1,nv)]
+      call dist_local(nv,vz,rst2,ren,rgn,ret,rxyz)
+      nvok = 0
+      do ii = 1,nv
+        zz = vz(ii)
+        same = (rst2(ii) == dst(zz))
+        if (same.and.rst2(ii) /= 2) then
+          same = dist_bits_equal([ren(ii)],[den(zz)]).and. &
+          &      dist_bits_equal(reshape(rxyz(:,:,ii),[3*nat]),reshape(dxyz(:,:,zz),[3*nat]))
+          if (same.and.rst2(ii) == 0) then
+            same = dist_bits_equal(ret(:,ii),det(:,zz))
+            write (g1,'(f12.8,e20.5)') rgn(ii),rgn(ii)
+            write (g2,'(f12.8,e20.5)') dgn(zz),dgn(zz)
+            same = same.and.(g1 == g2)
+          end if
+        end if
+        if (same) then
+          nvok = nvok+1
+        else
+          write (stderr,'(a,i0,a,i0,a,i0)') 'CREST_DIST> verify: structure ',zz,' differs (status worker ', &
+          &  dst(zz),', driver ',rst2(ii)
+        end if
+      end do
+      write (stdout,'(a,i0,a,i0,a)') 'CREST_DIST> verify: ',nvok,' of ',nv, &
+      &  ' worker structures recomputed by the driver are bitwise identical'
+      if (nvok /= nv) then
+        write (stderr,'(a)') '**ERROR** CREST_DIST> verification failed: the distributed results of this pass are '// &
+        &  'discarded and the pass runs in-process'
+        open (newunit=u,file=trim(pdir)//'/VERIFY_FAILED.txt',status='replace',action='write',iostat=io2)
+        if (io2 == 0) then
+          write (u,'(i0,a,i0,a)') nvok,' of ',nv,' identical'
+          close (u)
+        end if
+        return
+      end if
+    end if
+!>--- results of workers on another CPU model (review F3): accepted only after a tolerance check
+!>    (same status, |dE| < dtol_e Eh, coordinate RMSD < dtol_rmsd A) of verify_other of them;
+!>    otherwise (or with same_cpu = 1, or verify_other = 0) the driver recomputes those chunks
+    if (nwko > 0) then
+      if (nwk == 0) then
+        write (stderr,'(a,i0,a)') '**WARNING** CREST_DIST> no worker of this pass ran on the driver''s CPU model ('// &
+        &  trim(mycpu)//'); ',nwko,' worker structures come from other CPU models and cannot be checked bitwise'
+        write (stdout,'(a,i0,a)') 'CREST_DIST> WARNING: no worker ran on the driver''s CPU model; ',nwko, &
+        &  ' structures come from other CPU models'
+      end if
+      okx = .false.
+      if (dcfg%same_cpu /= 0) then
+        write (stdout,'(a,i0,a)') 'CREST_DIST> same_cpu = 1: the driver recomputes the ',nwko, &
+        &  ' structures from workers on other CPU models'
+      else if (dcfg%verify_other <= 0) then
+        write (stdout,'(a,i0,a)') 'CREST_DIST> verify_other = 0: the driver recomputes the ',nwko, &
+        &  ' structures from workers on other CPU models'
+      else
+        nv = min(dcfg%verify_other,nwko)
+        list = pack([(zz,zz=1,nall)],dsrc == 2.and..not.done)
+        stp = max(1,nwko/nv)
+        vz = [(list(1+(ii-1)*stp),ii=1,nv)]
+        call dist_local(nv,vz,rst2,ren,rgn,ret,rxyz)
+        nvok = 0
+        demax = 0.0_wp
+        rmsdmax = 0.0_wp
+        do ii = 1,nv
+          zz = vz(ii)
+          same = (rst2(ii) == dst(zz))
+          de = 0.0_wp
+          rmsd = 0.0_wp
+          if (same.and.rst2(ii) /= 2) then
+            de = abs(ren(ii)-den(zz))
+            rmsd = sqrt(sum((rxyz(:,:,ii)-dxyz(:,:,zz))**2)/real(nat,wp))*bohr
+            demax = max(demax,de)
+            rmsdmax = max(rmsdmax,rmsd)
+            same = (de < dtol_e.and.rmsd < dtol_rmsd)
+          end if
+          if (same) then
+            nvok = nvok+1
+          else
+            write (stderr,'(a,i0,a,i0,a,i0,a,es10.3,a,es10.3,a)') 'CREST_DIST> verify (other CPU model): structure ', &
+            &  zz,' differs (status worker ',dst(zz),', driver ',rst2(ii),'; |dE| ',de,' Eh, RMSD ',rmsd,' A)'
+          end if
+        end do
+        write (stdout,'(a,i0,a,i0,a,es10.3,a,es10.3,a)') 'CREST_DIST> verify (other CPU model): ',nvok,' of ',nv, &
+        &  ' worker structures agree with the driver within tolerance (max |dE| ',demax,' Eh, max RMSD ',rmsdmax,' A)'
+        okx = (nvok == nv)
+        if (.not.okx) then
+          write (stderr,'(a)') '**WARNING** CREST_DIST> results of workers on other CPU models exceed the tolerance '// &
+          &  '(|dE| < 1e-7 Eh, RMSD < 1e-4 A); the driver recomputes them'
+          write (stdout,'(a)') 'CREST_DIST> WARNING: other-CPU worker results exceed the tolerance; the driver recomputes them'
+        end if
+      end if
+      if (.not.okx) then
+        msk = .false.
+        do zz = 1,nall
+          if (dsrc(zz) == 2.and..not.done(zz)) msk(mod(zz-1,nch)) = .true.
+        end do
+        list = pack([(ic,ic=0,nch-1)],msk)
+        n1 = 0
+        do while (n1 < size(list))
+          n2 = min(n1+nb,size(list))
+          call dist_chunks_local(trim(pdir),nch,csize,list(n1+1:n2),mycpu,mysha,.true.,nloc,0,0)
+          n1 = n2
+        end do
+        write (stdout,'(a,i0,a,i0,a)') 'CREST_DIST> recomputed ',size(list),' chunks (',nwko, &
+        &  ' structures) from workers on other CPU models'
+      end if
+    end if
+    dmexit = 0
+    if (kexit == 2) dmexit = nexit
+    okd = .true.
+  end subroutine dist_driver
+
+  subroutine dist_tla(tl,nt,s)
+!> Driver: append one line to the worker.toml text
+    implicit none
+    character(len=512),intent(inout) :: tl(:)
+    integer,intent(inout) :: nt
+    character(len=*),intent(in) :: s
+    nt = nt+1
+    tl(nt) = s
+  end subroutine dist_tla
+
+  subroutine dist_chunks_local(pd,nchx,csz,lst,cpu,sha,aside,nloc,kexit,nexit)
+!> Driver: compute whole chunks lst(:) itself (one OpenMP batch), write them as result files
+!> (writer 2; aside: an existing result file is first moved to <file>.othercpu_<k>) and take
+!> them into the pass result arrays
+    implicit none
+    character(len=*),intent(in) :: pd
+    integer,intent(in) :: nchx,csz(0:nchx-1),lst(:),kexit,nexit
+    character(len=64),intent(in) :: cpu,sha
+    logical,intent(in) :: aside
+    integer,intent(inout) :: nloc
+    integer,allocatable :: zl2(:),rs(:)
+    real(wp),allocatable :: re(:),rg(:),rt(:,:),rx(:,:,:)
+    integer :: ii,ic,m,p0,n1,n2,pp,zz,io3,ntot
+    character(len=40) :: c4
+    character(len=32) :: jb
+    character(len=1100) :: fr,f2
+    logical :: ex
+    ntot = sum(csz(lst))
+    allocate (zl2(ntot))
+    p0 = 0
+    do ii = 1,size(lst)
+      ic = lst(ii)
+      zl2(p0+1:p0+csz(ic)) = [(ic+1+m*nchx,m=0,csz(ic)-1)]
+      p0 = p0+csz(ic)
+    end do
+    call dist_local(ntot,zl2,rs,re,rg,rt,rx)
+    call dist_jobid(jb)
+    jb = 'driver_'//trim(jb)
+    p0 = 0
+    do ii = 1,size(lst)
+      ic = lst(ii)
+      n1 = p0+1
+      n2 = p0+csz(ic)
+      write (c4,'(i4.4)') ic
+      fr = pd//'/results/chunk_'//trim(c4)//'.bin'
+      if (aside) then
+        inquire (file=trim(fr),exist=ex)
+        if (ex) then
+          do m = 1,9999
+            write (f2,'(a,a,i0)') trim(fr),'.othercpu_',m
+            inquire (file=trim(f2),exist=ex)
+            if (.not.ex) exit
+          end do
+          call rename(trim(fr),trim(f2),io3)
+        end if
+      end if
+      call dist_write_result(trim(fr),ic,csz(ic),nat,dnetmp,2,dkey,cpu,sha,jb,zl2(n1:n2),rs(n1:n2),re(n1:n2), &
+      &    rg(n1:n2),rt(:,n1:n2),rx(:,:,n1:n2),io3)
+      if (io3 /= 0) write (stderr,'(a,i0,a)') 'CREST_DIST> WARNING: could not write the local result of chunk ', &
+      &  ic,' (kept in memory)'
+      do pp = n1,n2
+        zz = zl2(pp)
+        dst(zz) = rs(pp)
+        den(zz) = re(pp)
+        dgn(zz) = rg(pp)
+        det(:,zz) = rt(:,pp)
+        dxyz(:,:,zz) = rx(:,:,pp)
+        dsrc(zz) = 3
+      end do
+      nloc = nloc+1
+      p0 = n2
+      if (kexit == 1.and.nloc >= nexit) then
+        write (stdout,'(a,i0,a)') 'CREST_DIST> TEST: exiting abruptly after ',nloc,' local chunks'
+        flush (stdout)
+        call dist_c_exit(97_c_int)
+      end if
+    end do
+  end subroutine dist_chunks_local
+
+  subroutine dist_scancel(ids)
+!> Driver: cancel PENDING tasks of this pass's own worker arrays (ids: "<job>" or "<job>_<task>" list)
+    implicit none
+    character(len=*),intent(in) :: ids
+    integer :: es,cs
+    call execute_command_line('scancel --state=PENDING '//ids//' > /dev/null 2>&1',exitstat=es,cmdstat=cs)
+    write (stdout,'(a)') 'CREST_DIST> cancelled pending worker tasks:'//ids
+  end subroutine dist_scancel
+
+  subroutine dist_local(nz,zl,rst,ren,rgn,ret,rxyz)
+!> Driver: optimize structures zl(:) of the pass input itself, with the same
+!> calculation objects and per-structure calls as the OpenMP loop above
+    implicit none
+    integer,intent(in) :: nz,zl(nz)
+    integer,allocatable,intent(out) :: rst(:)
+    real(wp),allocatable,intent(out) :: ren(:),rgn(:),ret(:,:),rxyz(:,:,:)
+    integer :: ii,vz,jb,io2,zc,pp,tid
+    real(wp) :: e2
+    allocate (rst(nz),source=2)
+    allocate (ren(nz),source=1.0_wp)
+    allocate (rgn(nz),source=0.0_wp)
+    allocate (ret(dnetmp,nz),source=0.0_wp)
+    allocate (rxyz(3,nat,nz),source=0.0_wp)
+    zc = 0
+    !$omp parallel &
+    !$omp shared(calculations,mols,molsnew,grads,dxyz0,nat,at,nested,Tn,zl,nz,rst,ren,rgn,ret,rxyz,zc,dnetmp)
+    !$omp single
+    do ii = 1,nz
+      call initsignal()
+      vz = ii
+      !$omp task firstprivate(vz) private(jb,io2,e2,pp,tid)
+      call initsignal()
+      if (nested) call ompmklset(Tn)
+      tid = OMP_GET_THREAD_NUM()
+      jb = tid+1
+      !$omp critical
+      zc = zc+1
+      pp = zc
+      mols(jb)%nat = nat
+      mols(jb)%at(:) = at(:)
+      mols(jb)%xyz(:,:) = dxyz0(:,:,zl(pp))
+      molsnew(jb)%nat = nat
+      molsnew(jb)%at(:) = at(:)
+      molsnew(jb)%xyz(:,:) = dxyz0(:,:,zl(pp))
+      !$omp end critical
+      e2 = 0.0_wp
+      call optimize_geometry(mols(jb),molsnew(jb),calculations(jb),e2,grads(:,:,jb),.false.,.false.,io2)
+      !$omp critical
+      if (io2 == 0) then
+        rst(pp) = 0
+        ren(pp) = e2
+        rgn(pp) = norm2(grads(:,:,jb))
+        rxyz(:,:,pp) = molsnew(jb)%xyz(:,:)
+        if (allocated(calculations(jb)%etmp)) then
+          if (size(calculations(jb)%etmp) == dnetmp) ret(:,pp) = calculations(jb)%etmp(:)
+        end if
+      else if (io2 == calculations(jb)%maxcycle.and.calculations(jb)%anopt) then
+        rst(pp) = 1
+        ren(pp) = e2
+        rxyz(:,:,pp) = molsnew(jb)%xyz(:,:)
+      else
+        rst(pp) = 2
+        ren(pp) = 1.0_wp
+      end if
+      !$omp end critical
+      !$omp end task
+    end do
+    !$omp taskwait
+    !$omp end single
+    !$omp end parallel
+  end subroutine dist_local
+
+  subroutine dist_merge()
+!> Driver: what the critical section of the OpenMP loop does per structure,
+!> applied to the chunk results in input order (pass output, energy log,
+!> CREST_CKPT journal, eread/xyz and the counters c and k)
+    implicit none
+    integer :: iz,zz,jio2,nm
+    real(wp) :: e2,g2
+    character(len=80) :: a2
+    nm = 0
+    do iz = 1,nall-ndone
+      zz = todo(iz)
+      if (dst(zz) == 0) then
+        c = c+1
+        e2 = den(zz)
+        g2 = dgn(zz)
+        molsnew(1)%nat = nat
+        molsnew(1)%at(:) = at(:)
+        molsnew(1)%xyz(:,:) = dxyz(:,:,zz)
+        write (a2,'(1x,"Etot=",f16.10,1x,"g norm=",f12.8)') e2,g2
+        molsnew(1)%comment = trim(a2)
+        call molsnew(1)%append(ich)
+        call calc_eprint(calculations(1),e2,det(:,zz),g2,ich2)
+        if (jr.and.jok) then
+          flush (ich,iostat=jio2)
+          if (jio2 == 0) flush (ich2,iostat=jio2)
+          if (jio2 == 0) write (jch,'(i0,1x,i0)',iostat=jio2) zz,0
+          if (jio2 == 0) flush (jch,iostat=jio2)
+          if (jio2 /= 0) then
+            jok = .false.
+            write (stderr,'(a,i0,a)') 'CREST_CKPT> WARNING: opt journal write failed (status ',jio2, &
+            &  '); journaling stopped for the rest of this pass'
+          end if
+        end if
+        eread(zz) = e2
+        xyz(:,:,zz) = molsnew(1)%xyz(:,:)
+      else if (dst(zz) == 1) then
+        c = c+1
+        eread(zz) = den(zz)
+        xyz(:,:,zz) = dxyz(:,:,zz)
+      else
+        eread(zz) = 1.0_wp
+        if (jr.and.jok) then
+          flush (ich,iostat=jio2)
+          if (jio2 == 0) flush (ich2,iostat=jio2)
+          if (jio2 == 0) write (jch,'(i0,1x,i0)',iostat=jio2) zz,2
+          if (jio2 == 0) flush (jch,iostat=jio2)
+          if (jio2 /= 0) then
+            jok = .false.
+            write (stderr,'(a,i0,a)') 'CREST_CKPT> WARNING: opt journal write failed (status ',jio2, &
+            &  '); journaling stopped for the rest of this pass'
+          end if
+        end if
+      end if
+      k = k+1
+      call crest_oloop_pr_progress(env,nall,k)
+      nm = nm+1
+      if (dmexit > 0.and.nm >= dmexit) then
+        write (stdout,'(a,i0,a)') 'CREST_DIST> TEST: exiting abruptly after ',nm,' merged structures'
+        flush (stdout)
+        call dist_c_exit(97_c_int)
+      end if
+    end do
+  end subroutine dist_merge
+
+  subroutine dist_dump_arrays()
+!> CREST_DIST_OLOOP_DUMP=<file>: exact pass result (eread, xyz in Bohr) for validation
+    implicit none
+    character(len=1024) :: fd
+    logical :: okd2
+    integer :: u,iou
+    call dist_getenv('CREST_DIST_OLOOP_DUMP',fd,okd2)
+    if (.not.okd2) return
+    open (newunit=u,file=trim(fd),access='stream',form='unformatted',status='replace',action='write',iostat=iou)
+    if (iou /= 0) return
+    write (u,iostat=iou) 'CRDOLDMP',int(nall,int32),int(nat,int32),eread,xyz
+    close (u)
+    write (stdout,'(a)') 'CREST_DIST> pass result (eread, xyz in Bohr) written to '//trim(fd)
+  end subroutine dist_dump_arrays
 end subroutine crest_oloop
 
