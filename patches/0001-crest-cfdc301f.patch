+# Append after the unchanged ordinary-density overlay in a fresh matched tree.
+# No active/frozen search tree or production scheduler is changed.
+option(WITH_TBLITE_GPU_PERSISTENCE_EXPERIMENT "Explicit lexical worker CUDA scratch leases" OFF)
+if(WITH_TBLITE_GPU_PERSISTENCE_EXPERIMENT AND
+   (NOT WITH_TBLITE_GPU OR NOT WITH_TBLITE_GPU_DENSITY_EXPERIMENT))
+  message(FATAL_ERROR "Persistence experiment requires GPU and ordinary density")
+endif()
+if(WITH_TBLITE_GPU)
+  find_package(Threads REQUIRED)
+  target_link_libraries(crest-cuda-bridge PUBLIC Threads::Threads)
+  target_compile_features(crest-cuda-bridge PRIVATE cxx_std_14)
+endif()
+if(WITH_TBLITE_GPU_PERSISTENCE_EXPERIMENT)
+  foreach(_persistence_target crest-object lib-crest-static lib-crest-shared crest-tester)
+    if(TARGET ${_persistence_target})
+      target_compile_definitions(${_persistence_target} PRIVATE WITH_TBLITE_GPU_PERSISTENCE_EXPERIMENT)
+    endif()
+  endforeach()
+endif()
+
+# D4 three-body (ATM) dispersion kernel used by the dftd4 hook and the crest_oloop phase switch.
+# The default flags and architectures reproduce the object of the validated v2 binary. Other GPU generations run the
+# sm_80 code (8.x) or fall back to the CPU routine at run time; extend CREST_ATM_CUDA_GENCODE to add SASS targets.
+if(WITH_TBLITE_GPU)
+  set(CREST_ATM_CUDA_GENCODE "-gencode;arch=compute_80,code=sm_80;-gencode;arch=compute_90,code=sm_90"
+      CACHE STRING "nvcc -gencode arguments for the GPU ATM kernel")
+  set(_atm_src "${PROJECT_SOURCE_DIR}/src/cuda_atm/crest_atm_gpu.cu")
+  set(_atm_obj "${CMAKE_CURRENT_BINARY_DIR}/crest_atm_gpu.o")
+  add_custom_command(
+    OUTPUT "${_atm_obj}"
+    COMMAND "${CUDAToolkit_NVCC_EXECUTABLE}" -O3 -std=c++14 --fmad=false -Xcompiler -fPIC -Xcompiler -ffp-contract=off
+            -ccbin "${CMAKE_CXX_COMPILER}" ${CREST_ATM_CUDA_GENCODE}
+            -I "${PROJECT_SOURCE_DIR}/src/cuda_atm" -c "${_atm_src}" -o "${_atm_obj}"
+    DEPENDS "${_atm_src}" "${PROJECT_SOURCE_DIR}/src/cuda_atm/crest_atm_gpu.h"
+            "${PROJECT_SOURCE_DIR}/src/cuda_atm/crest_atm_triple.inc"
+    COMMENT "nvcc: GPU ATM kernel"
+    VERBATIM)
+  set_source_files_properties("${_atm_obj}" PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
+  target_sources(crest-cuda-bridge PRIVATE "${_atm_obj}")
 endif()
