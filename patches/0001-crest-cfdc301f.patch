+!================================================================================!
+! module crest_mdckpt   (CREST_CKPT, SYNTHESIS C.1)
+!
+! Leaf helper module for the opt-in MD/MTD checkpoint feature.
+! Everything here is inert unless the environment variable CREST_CKPT
+! is set to a positive integer (ckpt_steps() > 0) and a tracked step
+! has been armed with mdckpt_arm().
+!
+! - .F90 so that the tblite wavefunction access can sit under WITH_TBLITE
+! - uses only iso_fortran_env, iso_c_binding, crest_calculator and iomod
+!   (it must NOT use crest_restartlog; crest_restartlog may use this module)
+! - the tblite wavefunction is reached via calc%calcs(j)%tblite%wfn
+!   (calc_type: type(tblite_data),allocatable :: tblite;
+!    tblite_api: type(wavefunction_type) :: wfn, both public)
+!
+! LOCKING: ck_commit, truncate_lines and count_lines wrap their own
+! open/close calls in the named lock crest_ckpt_io. Do NOT call them while
+! holding "!$omp critical (crest_ckpt_io)" (nesting a critical region of
+! the same name deadlocks). ck_sync, xyz_key, itoa, ck_path, ck_epoch,
+! ck_mdfile, ck_unique, wfn_* take no lock. ckpt_steps uses its own lock
+! (crest_ckpt_env).
+!
+! THREADS (Round 2): itoa and ck_path return deferred-length strings
+! (character(len=:),allocatable). gfortran's code for such function results
+! is not thread-safe: called concurrently they returned empty or truncated
+! names (e.g. 'crest_ckpt/step_1/md_.ckpt') and corrupted the heap. They are
+! for serial driver code only. Code that runs inside OpenMP regions (the MD
+! routines in dynamics_module) uses ck_mdfile and ck_unique, which write into
+! a fixed-length buffer of the caller, and no deferred-length strings at all.
+!================================================================================!
+module crest_mdckpt
+  use iso_fortran_env,only:wp => real64,int64,stderr => error_unit,stdout => output_unit
+  use iso_c_binding,only:c_int,c_long_long,c_char,c_null_char
+  use crest_calculator,only:calcdata,jobtype
+  use iomod,only:makedir,directory_exist
+  implicit none
+  private
+
+!>--- CREST_CKPT file identity (SYNTHESIS B.1)
+  integer,parameter,public :: CK_MAGIC = 1129008177
+  integer,parameter,public :: CK_VER = 1
+
+!>--- armed state; ck_every > 0 only while a tracked step is armed
+  integer,public :: ck_every = 0
+  integer,public :: ck_step = 0
+  logical,public :: ck_resume = .false.
+  logical,public :: ck_nowfn = .false.
+  logical,public :: ck_fullwfn = .false.
+  character(len=256),public :: ck_dir = ' '
+
+!>--- temporary storage of one tblite wavefunction record (SYNTHESIS B.1 (8))
+  type,public :: wfnbuf
+    integer :: j = 0
+    integer :: nspin = 0
+    real(wp) :: kt = 0.0_wp
+    real(wp) :: nocc = 0.0_wp
+    real(wp) :: nuhf = 0.0_wp
+    real(wp),allocatable :: nel(:),n0at(:),n0sh(:)
+    real(wp),allocatable :: emo(:,:),focc(:,:),qat(:,:),qsh(:,:)
+    real(wp),allocatable :: dpat(:,:,:),qpat(:,:,:),den(:,:,:),cof(:,:,:)
+  end type wfnbuf
+
+  public :: ckpt_steps,mdckpt_arm,mdckpt_disarm,ck_path,ck_sync,ck_commit,itoa
+  public :: truncate_lines,count_lines,xyz_key,ck_epoch,ck_unique,ck_mdfile
+  public :: wfn_write,wfn_read,wfn_apply,wfn_needs_init
+
+!>--- private state
+  logical,save :: env_done = .false.
+  integer,save :: env_steps = 0
+  logical,save :: warned_commit = .false.  !> first failed commit of the armed step was reported
+  integer,save :: nfail_commit = 0         !> failed commits while armed, reported by mdckpt_disarm
+  !> number of dimension entries in a wavefunction record header
+  integer,parameter :: ndims = 23
+  !> max. number of wavefunction records and elements per array (corrupt-file guard)
+  integer,parameter :: maxwfn = 64
+  integer(int64),parameter :: maxelem = 200000000_int64
+
+  interface same_shape
+    module procedure same_shape1
+    module procedure same_shape2
+    module procedure same_shape3
+  end interface same_shape
+
+  interface
+    integer(c_int) function c_truncate(path,length) bind(C,name='truncate')
+      import :: c_int,c_long_long,c_char
+      character(kind=c_char),intent(in) :: path(*)
+      integer(c_long_long),value :: length   !> off_t is 64 bit on x86_64 Linux
+    end function c_truncate
+    integer(c_int) function c_fsync(fd) bind(C,name='fsync')
+      import :: c_int
+      integer(c_int),value :: fd
+    end function c_fsync
+  end interface
+
+!========================================================================================!
+!========================================================================================!
+contains  !> MODULE PROCEDURES START HERE
+!========================================================================================!
+!========================================================================================!
+
+  integer function ckpt_steps() result(n)
+!***************************************************************
+!* CREST_CKPT=<MD steps>; read once and cached.
+!* 0 (unset, empty, "0" or invalid) means everything new is off.
+!***************************************************************
+    character(len=64) :: v
+    integer :: l,st,io,val
+    !$omp critical (crest_ckpt_env)
+    if (.not.env_done) then
+      val = 0
+      v = ' '
+      call get_environment_variable('CREST_CKPT',v,length=l,status=st)
+      if (st /= 1 .and. l > 0) then
+        io = 1
+        if (st == 0) read (v,*,iostat=io) val
+        if (io /= 0 .or. val < 0) then
+          write (stderr,'(a)') 'CREST_CKPT> invalid CREST_CKPT value "'//trim(v)// &
+          &                    '"; checkpointing stays off'
+          val = 0
+        end if
+      end if
+      env_steps = val
+      env_done = .true.
+    end if
+    n = env_steps
+    !$omp end critical (crest_ckpt_env)
+  end function ckpt_steps
+
+!========================================================================================!
+
+  logical function env_flag(name) result(on)
+!********************************************************
+!* .true. if the variable is set, non-empty and not "0"
+!********************************************************
+    character(len=*),intent(in) :: name
+    character(len=64) :: v
+    integer :: l,st
+    v = ' '
+    call get_environment_variable(name,v,length=l,status=st)
+    on = (st /= 1 .and. l > 0)
+    if (on .and. st == 0) on = (trim(adjustl(v)) /= '0')
+  end function env_flag
+
+!========================================================================================!
+
+  subroutine mdckpt_arm(stepid,resume)
+!*************************************************************************
+!* Arm tracked step <stepid> (serial driver context only).
+!* Creates crest_ckpt/ and crest_ckpt/step_<stepid>/ and then purges only
+!* the feature's own folders crest_ckpt/step_k with k < stepid
+!* (SYNTHESIS B.0 purge rule; deviation D1: plain Fortran loop over the
+!*  existing directories with CREST's rmrf, no shell 'for' loop).
+!*************************************************************************
+    integer,intent(in) :: stepid
+    logical,intent(in) :: resume
+    character(len=64) :: v
+    character(len=:),allocatable :: d
+    integer :: io,l,st,k
+    external :: rmrf    !> cleanup.f90
+
+    ck_every = ckpt_steps()
+    if (ck_every <= 0) then
+      call mdckpt_disarm()
+      return
+    end if
+    ck_step = stepid
+    ck_resume = resume
+    ck_nowfn = env_flag('CREST_CKPT_NOWFN')
+    v = ' '
+    call get_environment_variable('CREST_CKPT_WFN',v,length=l,status=st)
+    ck_fullwfn = (st == 0 .and. trim(adjustl(v)) == 'full')
+
+    warned_commit = .false.
+    nfail_commit = 0
+
+    write (ck_dir,'(a,i0)') 'crest_ckpt/step_',stepid
+    if (.not.directory_exist('crest_ckpt')) io = makedir('crest_ckpt')
+    if (.not.directory_exist(trim(ck_dir))) io = makedir(trim(ck_dir))
+    !>--- the step folder must exist, otherwise every later open in it would abort CREST:
+    !>    run this step without checkpoints/journal (callers test ck_every after arming)
+    if (.not.directory_exist(trim(ck_dir))) then
+      write (stderr,'(a)') 'CREST_CKPT> WARNING: cannot create '//trim(ck_dir)// &
+      &  '; this step runs without checkpoints'
+      call mdckpt_disarm()
+      return
+    end if
+
+    !>--- CREST_CKPT D1: remove only existing lower-numbered step folders
+    do k = 1,stepid-1
+      d = 'crest_ckpt/step_'//itoa(k)
+      if (directory_exist(d)) call rmrf(d)
+    end do
+
+    write (stdout,'(a,i0,a,l1,a,i0)') 'CREST_CKPT> step ',stepid,' armed, resume=',resume, &
+    &  ', epoch ',ck_epoch()
+  end subroutine mdckpt_arm
+
+!========================================================================================!
+
+  subroutine mdckpt_disarm()
+    !>--- report every failed commit of the armed step, not only the first one
+    if (nfail_commit > 0) write (stderr,'(a,i0,a,i0,a)') 'CREST_CKPT> WARNING: ',nfail_commit, &
+    &  ' checkpoint/journal commit(s) failed during step ',ck_step,'; the previous files stayed valid'
+    nfail_commit = 0
+    ck_every = 0
+    ck_step = 0
+    ck_resume = .false.
+    ck_nowfn = .false.
+    ck_fullwfn = .false.
+    ck_dir = ' '
+  end subroutine mdckpt_disarm
+
+!========================================================================================!
+
+  function ck_path(name) result(p)
+!> serial driver code only (deferred-length result, see THREADS above)
+    character(len=*),intent(in) :: name
+    character(len=:),allocatable :: p
+    p = trim(ck_dir)//'/'//name
+  end function ck_path
+
+!========================================================================================!
+
+  function itoa(i) result(s)
+!> serial driver code only (deferred-length result, see THREADS above)
+    integer,intent(in) :: i
+    character(len=:),allocatable :: s
+    character(len=24) :: b
+    write (b,'(i0)') i
+    s = trim(b)
+  end function itoa
+
+!========================================================================================!
+
+  function ck_epoch() result(e)
+!> wall-clock time in Unix seconds (GNU time8), printed on the 'armed' and
+!> 'resumed after step' lines so that per-requeue loss can be measured (F3)
+    integer(int64) :: e
+    e = int(time8(),int64)
+  end function ck_epoch
+
+!========================================================================================!
+
+  subroutine ck_mdfile(idx,ext,f)
+!*******************************************************************
+!* f = <armed step folder>/md_<idx><ext>, e.g. ext='.ckpt'.
+!* Thread-safe (fixed-length buffer of the caller, see THREADS).
+!*******************************************************************
+    integer,intent(in) :: idx
+    character(len=*),intent(in) :: ext
+    character(len=*),intent(out) :: f
+    write (f,'(a,a,i0,a)') trim(ck_dir),'/md_',idx,ext
+  end subroutine ck_mdfile
+
+!========================================================================================!
+
+  subroutine ck_unique(base,nm)
+!*******************************************************************
+!* nm = <base>, or <base>_2, <base>_3, ... : the first name not in
+!* use. Used for move-aside renames (.stale), so nothing is
+!* overwritten. Thread-safe (fixed-length buffer of the caller);
+!* takes no lock, callers inside OpenMP regions hold crest_ckpt_io.
+!*******************************************************************
+    character(len=*),intent(in) :: base
+    character(len=*),intent(out) :: nm
+    integer :: kk
+    logical :: ex
+    nm = base
+    kk = 1
+    do
+      inquire (file=trim(nm),exist=ex)
+      if (.not.(ex.or.directory_exist(trim(nm)))) exit
+      kk = kk+1
+      write (nm,'(a,a,i0)') base,'_',kk
+    end do
+  end subroutine ck_unique
+
+!========================================================================================!
+
+  subroutine ck_sync(u,io)
+!*************************************************************
+!* flush unit u and fsync its file descriptor (GNU fnum).
+!* io = flush iostat, or -1 if fsync failed, 0 on success.
+!*************************************************************
+    integer,intent(in) :: u
+    integer,intent(out) :: io
+    integer(c_int) :: rc
+    flush (u,iostat=io)
+    if (io /= 0) return
+    rc = c_fsync(int(fnum(u),c_int))
+    if (rc /= 0) io = -1
+  end subroutine ck_sync
+
+!========================================================================================!
+
+  subroutine ck_commit(f,u,io)
+!*****************************************************************
+!* Commit f//'.tmp' (open on unit u) to f: sync, close, rename.
+!* If io /= 0 on entry (failed write) or the sync/close/rename
+!* fails, the temporary is discarded/left and the previous f stays
+!* valid; a warning is printed for the first failure of each armed
+!* step and mdckpt_disarm reports how many failed. io returns the
+!* final status (0 = committed).
+!*****************************************************************
+    character(len=*),intent(in) :: f
+    integer,intent(in) :: u
+    integer,intent(inout) :: io
+    integer :: ios
+    if (io == 0) call ck_sync(u,io)
+    !$omp critical (crest_ckpt_io)
+    if (io == 0) then
+      close (u,iostat=io)
+      if (io == 0) call rename(trim(f)//'.tmp',trim(f),io)
+    else
+      close (u,status='delete',iostat=ios)
+    end if
+    if (io /= 0) then
+      if (ck_every > 0) nfail_commit = nfail_commit+1
+      if (.not.warned_commit) then
+        warned_commit = .true.
+        write (stderr,'(a,i0,a)') 'CREST_CKPT> WARNING: could not commit '//trim(f)//' (status ',io, &
+        &  '); the previous file stays valid and the run continues'
+      end if
+    end if
+    !$omp end critical (crest_ckpt_io)
+  end subroutine ck_commit
+
+!========================================================================================!
+
+  subroutine scan_newlines(f,stopat,nfound,nbytes,ok)
+!***************************************************************
+!* Byte-exact scan of file f for newline characters.
+!* stopat < 0: count all newlines (nfound)
+!* stopat > 0: stop at the stopat-th newline; nbytes = number of
+!*             bytes up to and including it
+!* ok = .false. on open/read failure
+!***************************************************************
+    character(len=*),intent(in) :: f
+    integer(int64),intent(in) :: stopat
+    integer(int64),intent(out) :: nfound,nbytes
+    logical,intent(out) :: ok
+    integer,parameter :: chunk = 1048576
+    character(len=chunk),allocatable :: buf   !> fixed length (no deferred-length string, see THREADS)
+    integer(int64) :: fsz,pos
+    integer :: u,io,ios,i,k,n,nl
+
+    ok = .false.
+    nfound = 0
+    nbytes = 0
+    if (stopat == 0) then
+      ok = .true.
+      return
+    end if
+    !$omp critical (crest_ckpt_io)
+    open (newunit=u,file=trim(f),access='stream',form='unformatted', &
+    &     status='old',action='read',iostat=io)
+    !$omp end critical (crest_ckpt_io)
+    if (io /= 0) return
+    fsz = -1
+    inquire (unit=u,size=fsz)
+    if (fsz >= 0) then
+      allocate (buf)
+      pos = 1
+      io = 0
+      chunks: do while (pos <= fsz)
+        n = int(min(int(chunk,int64),fsz-pos+1))
+        read (u,pos=pos,iostat=io) buf(1:n)
+        if (io /= 0) exit chunks
+        i = 1
+        do while (i <= n)
+          k = index(buf(i:n),achar(10))
+          if (k == 0) exit
+          nl = i+k-1               !> position of the newline in buf
+          nfound = nfound+1
+          if (stopat > 0 .and. nfound == stopat) then
+            nbytes = (pos-1)+int(nl,int64)
+            exit chunks
+          end if
+          i = nl+1
+        end do
+        pos = pos+int(n,int64)
+      end do chunks
+      ok = (io == 0)
+    end if
+    !$omp critical (crest_ckpt_io)
+    close (u,iostat=ios)
+    !$omp end critical (crest_ckpt_io)
+  end subroutine scan_newlines
+
+!========================================================================================!
+
+  subroutine truncate_lines(f,nl,ok)
+!*****************************************************************
+!* Keep exactly the first nl newline-terminated lines of file f
+!* (byte offset + truncate(2)); a torn last line is never counted.
+!* ok = .false. if fewer than nl complete lines exist or on error.
+!* A missing file is acceptable only for nl == 0.
+!*****************************************************************
+    character(len=*),intent(in) :: f
+    integer(int64),intent(in) :: nl
+    logical,intent(out) :: ok
+    integer(int64) :: nfound,nbytes
+    logical :: ex
+    ok = .false.
+    if (nl < 0) return
+    inquire (file=trim(f),exist=ex)
+    if (.not.ex) then
+      ok = (nl == 0)
+      return
+    end if
+    if (nl > 0) then
+      call scan_newlines(f,nl,nfound,nbytes,ok)
+      if (.not.ok) return
+      ok = .false.
+      if (nfound < nl) return
+    else
+      nbytes = 0
+    end if
+    ok = (c_truncate(trim(f)//c_null_char,int(nbytes,c_long_long)) == 0)
+  end subroutine truncate_lines
+
+!========================================================================================!
+
+  subroutine count_lines(f,n)
+!******************************************************************
+!* number of newline-terminated lines in f (0 if missing/unreadable)
+!******************************************************************
+    character(len=*),intent(in) :: f
+    integer(int64),intent(out) :: n
+    integer(int64) :: nb
+    logical :: ex,ok
+    n = 0
+    inquire (file=trim(f),exist=ex)
+    if (.not.ex) return
+    call scan_newlines(f,-1_int64,n,nb,ok)
+    if (.not.ok) n = 0
+  end subroutine count_lines
+
+!========================================================================================!
+
+  function xyz_key(nat,nall,xyz) result(k)
+!*****************************************************************
+!* exact content key of an ensemble (SYNTHESIS B.3):
+!* bit patterns of s1 = sum(xyz), s2 = sum(xyz**2) and
+!* s3 = sum_z z*sum(xyz(:,:,z)), all summed serially.
+!*****************************************************************
+    integer,intent(in) :: nat,nall
+    real(wp),intent(in) :: xyz(3,nat,nall)
+    integer(int64) :: k(3)
+    real(wp) :: s1,s2,s3,sz,x
+    integer :: i,j,z
+    s1 = 0.0_wp
+    s2 = 0.0_wp
+    s3 = 0.0_wp
+    do z = 1,nall
+      sz = 0.0_wp
+      do i = 1,nat
+        do j = 1,3
+          x = xyz(j,i,z)
+          s1 = s1+x
+          s2 = s2+x*x
+          sz = sz+x
+        end do
+      end do
+      s3 = s3+real(z,wp)*sz
+    end do
+    k(1) = transfer(s1,0_int64)
+    k(2) = transfer(s2,0_int64)
+    k(3) = transfer(s3,0_int64)
+  end function xyz_key
+
+!========================================================================================!
+
+  subroutine wfn_write(calc,u,io)
+!*********************************************************************
+!* Write the tblite wavefunction of every allocated tblite level.
+!* Record per level j (stream):
+!*   j, nspin, full, dims(23)
+!*   kt, nocc, nuhf, nel, n0at, n0sh, emo, focc, qat, qsh, dpat, qpat
+!*   [density, coeff]            only with CREST_CKPT_WFN=full
+!* The list is terminated by -1. Nothing is written if io /= 0.
+!*********************************************************************
+    type(calcdata),intent(in) :: calc
+    integer,intent(in) :: u
+    integer,intent(inout) :: io
+#ifdef WITH_TBLITE
+    integer :: j,full
+    integer :: d(ndims)
+#endif
+    if (io /= 0) return
+#ifdef WITH_TBLITE
+    if (allocated(calc%calcs)) then
+      do j = 1,calc%ncalculations
+        if (.not.allocated(calc%calcs(j)%tblite)) cycle
+        associate (w => calc%calcs(j)%tblite%wfn)
+          if (.not.(allocated(w%nel).and.allocated(w%n0at).and.allocated(w%n0sh).and. &
+          &    allocated(w%emo).and.allocated(w%focc).and.allocated(w%qat).and. &
+          &    allocated(w%qsh).and.allocated(w%dpat).and.allocated(w%qpat))) cycle
+          full = 0
+          if (ck_fullwfn) then
+            if (allocated(w%density).and.allocated(w%coeff)) full = 1
+          end if
+          d = 0
+          d(1) = size(w%nel)
+          d(2) = size(w%n0at)
+          d(3) = size(w%n0sh)
+          d(4:5) = shape(w%emo)
+          d(6:7) = shape(w%focc)
+          d(8:9) = shape(w%qat)
+          d(10:11) = shape(w%qsh)
+          d(12:14) = shape(w%dpat)
+          d(15:17) = shape(w%qpat)
+          if (full == 1) then
+            d(18:20) = shape(w%density)
+            d(21:23) = shape(w%coeff)
+          end if
+          write (u,iostat=io) j,w%nspin,full,d
+          if (io == 0) write (u,iostat=io) w%kt,w%nocc,w%nuhf,w%nel,w%n0at,w%n0sh, &
+          &                    w%emo,w%focc,w%qat,w%qsh,w%dpat,w%qpat
+          if (io == 0.and.full == 1) write (u,iostat=io) w%density,w%coeff
+        end associate
+        if (io /= 0) return
+      end do
+    end if
+#endif
+    write (u,iostat=io) -1
+  end subroutine wfn_write
+
+!========================================================================================!
+
+  subroutine wfn_read(u,buf,nbuf,io)
+!*************************************************************
+!* Read the wavefunction list written by wfn_write into
+!* temporaries (dimensions taken from each record).
+!* io /= 0 on a read error or an implausible record.
+!*************************************************************
+    integer,intent(in) :: u
+    type(wfnbuf),allocatable,intent(inout) :: buf(:)
+    integer,intent(out) :: nbuf
+    integer,intent(out) :: io
+    integer :: j,nspin,full,d(ndims),ia,m
+
+    nbuf = 0
+    if (allocated(buf)) deallocate (buf)
+    allocate (buf(maxwfn))
+    do
+      read (u,iostat=io) j
+      if (io /= 0) return
+      if (j == -1) exit
+      if (j < 1.or.nbuf >= maxwfn) then
+        io = 1
+        return
+      end if
+      read (u,iostat=io) nspin,full,d
+      if (io /= 0) return
+      if (full < 0.or.full > 1.or.any(d < 0)) then
+        io = 2
+        return
+      end if
+      if (full == 0) d(18:23) = 0
+      if (n_elem(d(1:1)) > maxelem.or.n_elem(d(2:2)) > maxelem.or. &
+      &   n_elem(d(3:3)) > maxelem.or.n_elem(d(4:5)) > maxelem.or. &
+      &   n_elem(d(6:7)) > maxelem.or.n_elem(d(8:9)) > maxelem.or. &
+      &   n_elem(d(10:11)) > maxelem.or.n_elem(d(12:14)) > maxelem.or. &
+      &   n_elem(d(15:17)) > maxelem.or.n_elem(d(18:20)) > maxelem.or. &
+      &   n_elem(d(21:23)) > maxelem) then
+        io = 3
+        return
+      end if
+      m = nbuf+1
+      buf(m)%j = j
+      buf(m)%nspin = nspin
+      allocate (buf(m)%nel(d(1)),buf(m)%n0at(d(2)),buf(m)%n0sh(d(3)), &
+      &         buf(m)%emo(d(4),d(5)),buf(m)%focc(d(6),d(7)), &
+      &         buf(m)%qat(d(8),d(9)),buf(m)%qsh(d(10),d(11)), &
+      &         buf(m)%dpat(d(12),d(13),d(14)),buf(m)%qpat(d(15),d(16),d(17)),stat=ia)
+      if (ia /= 0) then
+        io = 4
+        return
+      end if
+      read (u,iostat=io) buf(m)%kt,buf(m)%nocc,buf(m)%nuhf,buf(m)%nel,buf(m)%n0at, &
+      &                  buf(m)%n0sh,buf(m)%emo,buf(m)%focc,buf(m)%qat,buf(m)%qsh, &
+      &                  buf(m)%dpat,buf(m)%qpat
+      if (io /= 0) return
+      if (full == 1) then
+        allocate (buf(m)%den(d(18),d(19),d(20)),buf(m)%cof(d(21),d(22),d(23)),stat=ia)
+        if (ia /= 0) then
+          io = 4
+          return
+        end if
+        read (u,iostat=io) buf(m)%den,buf(m)%cof
+        if (io /= 0) return
+      end if
+      nbuf = m
+    end do
+    io = 0
+  end subroutine wfn_read
+
+!========================================================================================!
+
+  subroutine wfn_apply(calc,buf,nbuf,ok)
+!*****************************************************************
+!* Copy buffered wavefunctions into calc (all or nothing).
+!* ok = .false. (nothing copied) if a buffered level has no live
+!* tblite object, any shape differs, or a live tblite level has no
+!* buffer. density/coeff are copied only if they were stored.
+!*****************************************************************
+    type(calcdata),intent(inout) :: calc
+    type(wfnbuf),intent(in) :: buf(:)
+    integer,intent(in) :: nbuf
+    logical,intent(out) :: ok
+#ifdef WITH_TBLITE
+    integer :: k,j
+    logical :: good
+#endif
+    ok = .false.
+#ifdef WITH_TBLITE
+    if (.not.allocated(calc%calcs)) return
+    if (nbuf < 0.or.nbuf > size(buf)) return
+    !>--- pass 1: validate every buffer against the live wavefunction
+    do k = 1,nbuf
+      j = buf(k)%j
+      if (j < 1.or.j > calc%ncalculations) return
+      if (.not.allocated(calc%calcs(j)%tblite)) return
+      if (count(buf(1:nbuf)%j == j) /= 1) return
+      associate (w => calc%calcs(j)%tblite%wfn)
+        good = (w%nspin == buf(k)%nspin)
+        good = good.and.same_shape(w%nel,buf(k)%nel)
+        good = good.and.same_shape(w%n0at,buf(k)%n0at)
+        good = good.and.same_shape(w%n0sh,buf(k)%n0sh)
+        good = good.and.same_shape(w%emo,buf(k)%emo)
+        good = good.and.same_shape(w%focc,buf(k)%focc)
+        good = good.and.same_shape(w%qat,buf(k)%qat)
+        good = good.and.same_shape(w%qsh,buf(k)%qsh)
+        good = good.and.same_shape(w%dpat,buf(k)%dpat)
+        good = good.and.same_shape(w%qpat,buf(k)%qpat)
+        if (allocated(buf(k)%den)) good = good.and.same_shape(w%density,buf(k)%den)
+        if (allocated(buf(k)%cof)) good = good.and.same_shape(w%coeff,buf(k)%cof)
+      end associate
+      if (.not.good) return
+    end do
+    !>--- coverage: every live tblite level must have been stored
+    do j = 1,calc%ncalculations
+      if (.not.allocated(calc%calcs(j)%tblite)) cycle
+      if (count(buf(1:nbuf)%j == j) /= 1) return
+    end do
+    !>--- pass 2: copy
+    do k = 1,nbuf
+      j = buf(k)%j
+      associate (w => calc%calcs(j)%tblite%wfn)
+        w%kt = buf(k)%kt
+        w%nocc = buf(k)%nocc
+        w%nuhf = buf(k)%nuhf
+        w%nel(:) = buf(k)%nel(:)
+        w%n0at(:) = buf(k)%n0at(:)
+        w%n0sh(:) = buf(k)%n0sh(:)
+        w%emo(:,:) = buf(k)%emo(:,:)
+        w%focc(:,:) = buf(k)%focc(:,:)
+        w%qat(:,:) = buf(k)%qat(:,:)
+        w%qsh(:,:) = buf(k)%qsh(:,:)
+        w%dpat(:,:,:) = buf(k)%dpat(:,:,:)
+        w%qpat(:,:,:) = buf(k)%qpat(:,:,:)
+        if (allocated(buf(k)%den)) w%density(:,:,:) = buf(k)%den(:,:,:)
+        if (allocated(buf(k)%cof)) w%coeff(:,:,:) = buf(k)%cof(:,:,:)
+      end associate
+    end do
+    ok = .true.
+#else
+    ok = (nbuf == 0)
+#endif
+  end subroutine wfn_apply
+
+!========================================================================================!
+
+  logical function wfn_needs_init(calc) result(need)
+!*******************************************************************
+!* .true. if some active tblite level has no tblite object yet
+!* (e.g. the multimd2 path has no per-thread start engrad); the
+!* caller then runs one engrad at the restored geometry first.
+!*******************************************************************
+    type(calcdata),intent(in) :: calc
+    integer :: j
+    need = .false.
+#ifdef WITH_TBLITE
+    if (.not.allocated(calc%calcs)) return
+    do j = 1,calc%ncalculations
+      if (calc%calcs(j)%id /= jobtype%tblite) cycle
+      if (.not.calc%calcs(j)%active) cycle
+      if (.not.allocated(calc%calcs(j)%tblite)) need = .true.
+    end do
+#endif
+  end function wfn_needs_init
+
+!========================================================================================!
+!>--- private helpers
+
+  integer(int64) function n_elem(d) result(n)
+    integer,intent(in) :: d(:)
+    integer :: i
+    n = 1
+    do i = 1,size(d)
+      n = n*int(d(i),int64)
+      if (n > maxelem) return
+    end do
+  end function n_elem
+
+  logical function same_shape1(a,b) result(ok)
+    real(wp),allocatable,intent(in) :: a(:)
+    real(wp),allocatable,intent(in) :: b(:)
+    ok = allocated(a).and.allocated(b)
+    if (ok) ok = all(shape(a) == shape(b))
+  end function same_shape1
+
+  logical function same_shape2(a,b) result(ok)
+    real(wp),allocatable,intent(in) :: a(:,:)
+    real(wp),allocatable,intent(in) :: b(:,:)
+    ok = allocated(a).and.allocated(b)
+    if (ok) ok = all(shape(a) == shape(b))
+  end function same_shape2
+
+  logical function same_shape3(a,b) result(ok)
+    real(wp),allocatable,intent(in) :: a(:,:,:)
+    real(wp),allocatable,intent(in) :: b(:,:,:)
+    ok = allocated(a).and.allocated(b)
+    if (ok) ok = all(shape(a) == shape(b))
+  end function same_shape3
+
+!========================================================================================!
+!========================================================================================!
+end module crest_mdckpt
