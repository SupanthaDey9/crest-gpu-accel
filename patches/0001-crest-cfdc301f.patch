+!* the same env as the uninterrupted one.
+!* ok=.false. (trial MTD runs as upstream) if a file is missing or
+!* unreadable, or if there are frozen atoms and no reference WBOs:
+!* then crest_search_multimd_init would take its freeze-pointer
+!* branch, which upstream never reaches after a trial MTD.
+!**********************************************************************
+    implicit none
+    logical,intent(out) :: ok
+    character(len=*),parameter :: ftrial = 'crest_ckpt/trialmd.txt'
+    character(len=*),parameter :: fwbo = 'crest_ckpt/trialmd_wbo.bin'
+    integer,parameter :: wbomagic = 1464095281
+    character(len=80) :: line
+    integer :: u,iot,smode,wflag,m1,m2,n1,n2
+    integer(int64) :: bits
+    real(wp) :: tstep
+    real(wp),allocatable :: wbo(:,:)
+    logical :: ex
+    ok = .false.
+    inquire (file=ftrial,exist=ex)
+    if (.not.ex) return
+    open (newunit=u,file=ftrial,status='old',action='read',iostat=iot)
+    if (iot /= 0) return
+    read (u,'(a)',iostat=iot) line
+    close (u)
+    if (iot /= 0) return
+    read (line,'(z16)',iostat=iot) bits
+    if (iot == 0) read (line(17:),*,iostat=iot) smode
+    if (iot /= 0) return
+    wflag = 0
+    read (line(17:),*,iostat=iot) smode,wflag   !> records without the <wbo> field: 0
+    if (iot /= 0) wflag = 0
+    tstep = transfer(bits,tstep)
+    if (.not.(tstep > 0.0_wp).or.smode < 0.or.smode > 2) return
+    !>--- reference WBOs the trial MTD computed (only if the main program provided none)
+    if (wflag == 1.and..not.allocated(env%ref%wbo)) then
+      open (newunit=u,file=fwbo,access='stream',form='unformatted',status='old',action='read',iostat=iot)
+      if (iot /= 0) return
+      read (u,iostat=iot) m1,n1,n2
+      if (iot == 0.and.(m1 /= wbomagic.or.n1 /= env%ref%nat.or.n2 /= env%ref%nat)) iot = 1
+      if (iot == 0) then
+        allocate (wbo(n1,n2))
+        read (u,iostat=iot) wbo,m2
+        if (iot == 0.and.m2 /= wbomagic) iot = 1
+      end if
+      close (u)
+      if (iot /= 0) return
+      call move_alloc(wbo,env%ref%wbo)
+    end if
+    if (.not.allocated(env%ref%wbo).and.env%calc%nfreeze > 0) return
+    !>--- transfer final settings to global settings (P setuptest.f90:214-218)
+    env%mdstep = tstep
+    env%mddat%tstep = tstep
+    env%shake = smode
+    env%mddat%shk%shake_mode = smode
+    env%mddat%shake = (smode > 0)
+    ok = .true.
+    write (stdout,'(a,f6.2,a,i0,a,i0,a)') 'CREST_CKPT> trial MTD skipped on resume (recorded tstep=', &
+    &  tstep,' fs, shake mode ',smode,', reference WBOs restored ',wflag,')'
+  end subroutine trialmd_reuse
+
+  subroutine trialmd_record(wbo_before)
+!**********************************************************************
+!* CREST_CKPT (SYNTHESIS B.5, C.5 A5): record the trial-MTD result
+!* (as transferred to env by trialmd) in crest_ckpt/trialmd.txt,
+!* written as .tmp + fsync + rename. Round 2: if trialmd computed the
+!* reference WBOs (none before it), they go to trialmd_wbo.bin first
+!* (also .tmp + fsync + rename), and <wbo>=1 is recorded only if that
+!* commit succeeded.
+!**********************************************************************
+    implicit none
+    logical,intent(in) :: wbo_before
+    character(len=*),parameter :: ftrial = 'crest_ckpt/trialmd.txt'
+    character(len=*),parameter :: fwbo = 'crest_ckpt/trialmd_wbo.bin'
+    integer,parameter :: wbomagic = 1464095281
+    integer :: u,iot,wflag
+    iot = makedir('crest_ckpt')
+    wflag = 0
+    if (.not.wbo_before.and.allocated(env%ref%wbo)) then
+      open (newunit=u,file=fwbo//'.tmp',access='stream',form='unformatted',status='replace', &
+      &     action='write',iostat=iot)
+      if (iot == 0) then
+        write (u,iostat=iot) wbomagic,size(env%ref%wbo,1),size(env%ref%wbo,2),env%ref%wbo,wbomagic
+        call ck_commit(fwbo,u,iot)
+        if (iot == 0) wflag = 1
+      end if
+    end if
+    open (newunit=u,file=ftrial//'.tmp',status='replace',action='write',iostat=iot)
+    if (iot /= 0) return
+    write (u,'(z16.16,1x,i0,1x,i0)',iostat=iot) transfer(env%mddat%tstep,0_int64),env%mddat%shk%shake_mode,wflag
+    call ck_commit(ftrial,u,iot)
+  end subroutine trialmd_record
+
+  subroutine snapshot_cre()
+!**********************************************************************
+!* CREST_CKPT (SYNTHESIS B.5, C.5): post-loop entry snapshot.
+!* The .cre_<n>.xyz files (n = 0,1,... as collectcre sees them) are
+!* copied byte-exactly into crest_ckpt/postloop.tmp/, their number is
+!* written last to cre.count (tmp+rename), then the directories are
+!* swapped: the previous crest_ckpt/postloop/ becomes
+!* postloop/superseded_<tracker>/ inside the new one. A leftover
+!* postloop.tmp/ from an interrupted snapshot is moved to
+!* crest_ckpt/postloop_incomplete_<tracker>/. Nothing is deleted.
+!* The crest.restart of this entry is added to postloop/ by the
+!* following 'collect' trackrestart (dump_restart).
+!**********************************************************************
+    implicit none
+    character(len=*),parameter :: dnew = 'crest_ckpt/postloop.tmp'
+    character(len=*),parameter :: dpost = 'crest_ckpt/postloop'
+    character(len=80) :: fname
+    integer :: n,iot,u
+    logical :: ex,good
+    iot = makedir('crest_ckpt')
+    inquire (file=dnew,exist=ex)
+    if (ex.or.directory_exist(dnew)) &
+    &  call rename(dnew,ckpt_unique('crest_ckpt/postloop_incomplete_'//itoa(restart_step())))
+    iot = makedir(dnew)
+    good = directory_exist(dnew)
+    n = 0
+    do while (good)
+      write (fname,'(a,i0,a)') '.cre_',n,'.xyz'
+      inquire (file=trim(fname),exist=ex)
+      if (.not.ex) exit
+      call ckpt_copyfile(trim(fname),dnew//'/'//trim(fname),iot)
+      good = (iot == 0)
+      if (good) n = n+1
+    end do
+    if (good) then
+      open (newunit=u,file=dnew//'/cre.count.tmp',status='replace',action='write',iostat=iot)
+      if (iot == 0) then
+        write (u,'(i0)',iostat=iot) n
+        call ck_commit(dnew//'/cre.count',u,iot)
+      end if
+      good = (iot == 0)
+    end if
+    !>--- swap: the old snapshot must not stay paired with the new crest.restart
+    inquire (file=dpost,exist=ex)
+    if (ex.or.directory_exist(dpost)) then
+      if (directory_exist(dnew)) then
+        call rename(dpost,ckpt_unique(dnew//'/superseded_'//itoa(restart_step())),iot)
+      else
+        call rename(dpost,ckpt_unique('crest_ckpt/postloop_superseded_'//itoa(restart_step())),iot)
+      end if
+      if (iot /= 0) good = .false.
+    end if
+    if (directory_exist(dnew)) then
+      call rename(dnew,dpost,iot)
+      if (iot /= 0) good = .false.
+    end if
+    if (good) then
+      write (stdout,'(a,i0,a)') 'CREST_CKPT> post-loop entry snapshot: ',n, &
+      &  ' .cre_*.xyz file(s) saved to '//dpost
+    else
+      write (stderr,'(a)') 'CREST_CKPT> WARNING: post-loop snapshot failed or incomplete; '// &
+      &  'a later resume at the post-loop stage will be refused'
+    end if
+  end subroutine snapshot_cre
+
+  subroutine restore_cre()
+!**********************************************************************
+!* CREST_CKPT (SYNTHESIS C.5, D.5/D.6): resume at the post-loop entry.
+!* The snapshot in crest_ckpt/postloop/ is checked first (cre.count and
+!* every listed file); if it is incomplete CREST stops with exit code 3
+!* before any .cre_* file is touched. Then the current .cre_<n>.xyz files
+!* (n = 0..count, and contiguous ones above) are moved aside to
+!* crest_ckpt/postloop_aside_<tracker>/ (never deleted) and the snapshot
+!* is copied back, so collectcre sees exactly its original input.
+!**********************************************************************
+    implicit none
+    character(len=*),parameter :: dpost = 'crest_ckpt/postloop'
+    character(len=80) :: fname
+    character(len=:),allocatable :: aside
+    integer :: n,ii,iot,u
+    logical :: ex
+    n = -1
+    open (newunit=u,file=dpost//'/cre.count',status='old',action='read',iostat=iot)
+    if (iot == 0) then
+      read (u,*,iostat=iot) n
+      close (u)
+    end if
+    if (iot /= 0) n = -1
+    do ii = 0,n-1
+      write (fname,'(a,i0,a)') '.cre_',ii,'.xyz'
+      inquire (file=dpost//'/'//trim(fname),exist=ex)
+      if (.not.ex) then
+        n = -1
+        exit
+      end if
+    end do
+    if (n < 0) then
+      write (stderr,'(a)') '**ERROR** CREST_RESTART> post-loop snapshot '//dpost//' is missing or '// &
+      &  'incomplete; cannot resume at the post-loop entry (no .cre_* file was modified)'
+      error stop 3
+    end if
+    !>--- move the current .cre_<n>.xyz files aside
+    ii = 0
+    do
+      write (fname,'(a,i0,a)') '.cre_',ii,'.xyz'
+      inquire (file=trim(fname),exist=ex)
+      if (.not.ex.and.ii >= n) exit
+      if (ex) then
+        if (.not.allocated(aside)) then
+          aside = ckpt_unique('crest_ckpt/postloop_aside_'//itoa(restart_step()))
+          iot = makedir(aside)
+        end if
+        call rename(trim(fname),aside//'/'//trim(fname),iot)
+        if (iot /= 0) then
+          write (stderr,'(a)') '**ERROR** CREST_RESTART> could not move '//trim(fname)//' to '//aside
+          error stop 3
+        end if
+      end if
+      ii = ii+1
+    end do
+    !>--- copy the snapshot back
+    do ii = 0,n-1
+      write (fname,'(a,i0,a)') '.cre_',ii,'.xyz'
+      call ckpt_copyfile(dpost//'/'//trim(fname),trim(fname),iot)
+      if (iot /= 0) then
+        write (stderr,'(a)') '**ERROR** CREST_RESTART> could not restore '//trim(fname)//' from '// &
+        &  dpost//'; previous .cre_* files are in crest_ckpt/postloop_aside_*'
+        error stop 3
+      end if
+    end do
+    write (stdout,'(a,i0,a)') 'CREST_CKPT> post-loop entry restored: ',n,' .cre_*.xyz file(s) from '//dpost
+    if (allocated(aside)) write (stdout,'(a)') 'CREST_CKPT> previous .cre_*.xyz files moved to '//aside
+  end subroutine restore_cre
+
+  subroutine ckpt_copyfile(from,to,iot)
+!**********************************************************************
+!* CREST_CKPT: byte-exact copy of <from> to <to>, written as <to>.tmp,
+!* then fsync and rename (ck_commit). iot /= 0 on failure (no <to>).
+!**********************************************************************
+    implicit none
+    character(len=*),intent(in) :: from,to
+    integer,intent(out) :: iot
+    integer,parameter :: chunk = 1048576
+    character(len=:),allocatable :: buf
+    integer(int64) :: fsz,pos
+    integer :: ui,uo,nb,ios
+    open (newunit=ui,file=from,access='stream',form='unformatted',status='old', &
+    &     action='read',iostat=iot)
+    if (iot /= 0) return
+    fsz = -1
+    inquire (unit=ui,size=fsz)
+    open (newunit=uo,file=to//'.tmp',access='stream',form='unformatted',status='replace', &
+    &     action='write',iostat=iot)
+    if (iot /= 0) then
+      close (ui,iostat=ios)
+      return
+    end if
+    if (fsz < 0) iot = 1
+    allocate (character(len=chunk) :: buf)
+    pos = 1
+    do while (iot == 0.and.pos <= fsz)
+      nb = int(min(int(chunk,int64),fsz-pos+1))
+      read (ui,pos=pos,iostat=iot) buf(1:nb)
+      if (iot == 0) write (uo,iostat=iot) buf(1:nb)
+      pos = pos+int(nb,int64)
+    end do
+    close (ui,iostat=ios)
+    call ck_commit(to,uo,iot)
+  end subroutine ckpt_copyfile
+
+  function ckpt_unique(base) result(nm)
+!> CREST_CKPT: <base>, or <base>_2, <base>_3, ... (first name not in use)
+    implicit none
+    character(len=*),intent(in) :: base
+    character(len=:),allocatable :: nm
+    integer :: kk
+    logical :: ex
+    nm = base
+    kk = 1
+    do
+      inquire (file=nm,exist=ex)
+      if (.not.(ex.or.directory_exist(nm))) exit
+      kk = kk+1
+      nm = base//'_'//itoa(kk)
+    end do
+  end function ckpt_unique
 end subroutine crest_search_imtdgc
 
