+!>--- CREST_CKPT internal procedures of dynamics (SYNTHESIS C.2h, file format B.1).
+!>    Internal, so the public interface and dynamics_module.mod are unchanged.
+  contains
+
+    logical function md_ckpt_supported() result(ok)
+!>--- CREST_CKPT: only potentials whose full state is in B.1 (RMSD MTD) are checkpointed
+      integer :: k
+      ok = allocated(dat%blocke).and.allocated(dat%blockt).and.allocated(dat%blockrege)
+      if (dat%npot > 0) then
+        if (.not.allocated(dat%mtd)) then
+          ok = .false.
+        else if (size(dat%mtd) < dat%npot) then
+          ok = .false.
+        else
+          do k = 1,dat%npot
+            select case (dat%mtd(k)%mtdtype)
+            case (cv_rmsd,cv_rmsd_static)
+              if (.not.allocated(dat%mtd(k)%cvxyz)) ok = .false.
+            case default
+              ok = .false.
+            end select
+          end do
+        end if
+      end if
+      if (dat%shk%ncons > 0) then
+        if (.not.(allocated(dat%shk%conslist).and.allocated(dat%shk%distcons))) ok = .false.
+      end if
+    end function md_ckpt_supported
+
+    subroutine md_ckpt_retire()
+!>--- CREST_CKPT: before a fresh start, rename an existing md_<i>.ckpt and the MD's
+!>    trajectory to the first unused <name>.stale[_k] (no deletion, nothing overwritten)
+      character(len=512) :: fck
+      character(len=1100) :: nm
+      logical :: ex
+      integer :: ios
+      call ck_mdfile(dat%md_index,'.ckpt',fck)
+      inquire (file=trim(fck),exist=ex)
+      if (ex) then
+        !$omp critical (crest_ckpt_io)
+        call ck_unique(trim(fck)//'.stale',nm)
+        call rename(trim(fck),trim(nm),ios)
+        !$omp end critical (crest_ckpt_io)
+        if (ios /= 0) call md_ckpt_warn('could not move aside old '//trim(fck))
+      end if
+      inquire (file=trajectory,exist=ex)
+      if (ex) then
+        !$omp critical (crest_ckpt_io)
+        call ck_unique(trajectory//'.stale',nm)
+        call rename(trajectory,trim(nm),ios)
+        !$omp end critical (crest_ckpt_io)
+        if (ios /= 0) call md_ckpt_warn('could not move aside old '//trajectory)
+      end if
+    end subroutine md_ckpt_retire
+
+    logical function md_ckpt_ready() result(ok)
+!>--- CREST_CKPT (B.1): no RNG draw remains once every cv_rmsd potential has ncur >= 1
+      integer :: k
+      ok = .true.
+      if (dat%simtype /= type_mtd) return
+      do k = 1,dat%npot
+        if (dat%mtd(k)%mtdtype == cv_rmsd.and.dat%mtd(k)%ncur < 1) ok = .false.
+      end do
+    end function md_ckpt_ready
+
+    subroutine md_ckpt_write(td,done)
+!>--- CREST_CKPT (B.1): write md_<i>.ckpt via .tmp + fsync + rename.
+!>    Any failure keeps the previous checkpoint and never stops the MD.
+      integer,intent(in) :: td
+      logical,intent(in) :: done
+      character(len=512) :: fck
+      integer :: u,ios,k,np
+      integer(int64) :: c0,c1,cr
+
+      call system_clock(c0,cr)
+      call ck_mdfile(dat%md_index,'.ckpt',fck)
+      !>--- frames 1..dat%dumped must be durable before a checkpoint counts them (B.2)
+      call ck_sync(trj,ios)
+      if (ios /= 0) then
+        call md_ckpt_warn('trajectory flush/fsync failed, checkpoint skipped')
+      else
+        !$omp critical (crest_ckpt_io)
+        open (newunit=u,file=trim(fck)//'.tmp',access='stream',form='unformatted', &
+        &     status='replace',action='write',iostat=ios)
+        !$omp end critical (crest_ckpt_io)
+        if (ios /= 0) then
+          call md_ckpt_warn('cannot open '//trim(fck)//'.tmp, checkpoint skipped')
+        else
+          !>--- (1) header
+          write (u,iostat=ios) CK_MAGIC,CK_VER,ck_step,dat%md_index,dat%simtype,mol%nat, &
+          &     dat%length_steps,dat%sdump,dat%npot,dat%shk%ncons,dat%shk%shake_mode, &
+          &     dat%blockl,dat%maxblock,dat%tstep,dat%tsoll,dat%md_hmass,ck_skey(1:2)
+          !>--- (2) progress
+          if (ios == 0) write (u,iostat=ios) td,merge(1,0,done),term,dcount,printcount, &
+          &     dat%dumped,dat%iblock,dat%nblock,dat%blocknreg
+          !>--- (3) integrator and (4) scalars
+          if (ios == 0) write (u,iostat=ios) mol%xyz,velo,edum,eerror,tav,epav,ekav,ekin,temp
+          !>--- (5) block data
+          if (ios == 0) write (u,iostat=ios) dat%blocke,dat%blockt,dat%blockrege
+          !>--- (6) bias potentials
+          do k = 1,dat%npot
+            if (ios /= 0) exit
+            np = dat%mtd(k)%ncur
+            write (u,iostat=ios) dat%mtd(k)%mtdtype,dat%mtd(k)%nmax,dat%mtd(k)%maxsave, &
+            &     dat%mtd(k)%cvdumpstep,dat%mtd(k)%ncur,dat%mtd(k)%cvdump, &
+            &     dat%mtd(k)%kpush,dat%mtd(k)%alpha,dat%mtd(k)%ramp
+            if (ios == 0.and.np > 0) write (u,iostat=ios) dat%mtd(k)%cvxyz(:,:,1:np)
+          end do
+          !>--- (7) SHAKE
+          if (ios == 0.and.dat%shk%ncons > 0) write (u,iostat=ios) dat%shk%conslist,dat%shk%distcons
+          !>--- (8) wavefunction (terminated by -1)
+          if (ios == 0) then
+            if (ck_nowfn) then
+              write (u,iostat=ios) -1
+            else
+              call wfn_write(calc,u,ios)
+            end if
+          end if
+          !>--- (9) trailer
+          if (ios == 0) write (u,iostat=ios) CK_MAGIC,td
+          call ck_commit(trim(fck),u,ios)  !> ENOSPC etc.: warns, previous file stays valid
+          if (ios == 0) ck_nw = ck_nw+1
+        end if
+      end if
+      call system_clock(c1)
+      ck_tw = ck_tw+real(c1-c0,wp)/real(max(cr,1_int64),wp)
+    end subroutine md_ckpt_write
+
+    subroutine md_ckpt_read(ok)
+!>--- CREST_CKPT (C.2h): read md_<i>.ckpt into temporaries, validate, cut the
+!>    trajectory to dat%dumped frames, then apply. Missing file: silent fresh start.
+!>    Any failure before the apply step: nothing is changed, the MD starts fresh.
+      logical,intent(out) :: ok
+      type :: cvbuf
+        real(wp),allocatable :: x(:,:,:)
+      end type cvbuf
+      character(len=512) :: fck
+      character(len=160) :: why
+      character(len=32) :: wst
+      logical :: ex,okt,wok
+      integer :: u,ios,k,nwb,tmag,ttd,ncur1
+      integer :: hi(13),pg(9),pk(6)
+      real(wp) :: hr(3),sc(7),pr3(3),etmp
+      integer(int64) :: hk(2)
+      real(wp),allocatable :: xt(:,:),vt(:,:),bet(:),btt(:),brt(:),dct(:)
+      integer,allocatable :: clt(:,:),ncurt(:),cvdt(:)
+      type(cvbuf),allocatable :: cvb(:)
+      type(wfnbuf),allocatable :: wb(:)
+
+      ok = .false.
+      call ck_mdfile(dat%md_index,'.ckpt',fck)
+      inquire (file=trim(fck),exist=ex)
+      if (.not.ex) then
+        !>--- never silent (Round 2): a resume that finds no checkpoint says so
+        !$omp critical (crest_ckpt_io)
+        write (stdout,'(a,i0,a,i0)',iostat=ios) 'CREST_CKPT> MD ',dat%md_index, &
+        &      ': no checkpoint found ('//trim(fck)//'), starting fresh, epoch ',ck_epoch()
+        !$omp end critical (crest_ckpt_io)
+        return
+      end if
+
+      why = ' '
+      nwb = 0
+      !$omp critical (crest_ckpt_io)
+      open (newunit=u,file=trim(fck),access='stream',form='unformatted',status='old', &
+      &     action='read',iostat=ios)
+      !$omp end critical (crest_ckpt_io)
+      if (ios /= 0) then
+        why = 'cannot open'
+      else
+        rd: do
+          !>--- (1) header: must match the job definition of this run
+          read (u,iostat=ios) hi,hr,hk
+          if (ios /= 0) then
+            why = 'unreadable header'
+            exit rd
+          end if
+          if (hi(1) /= CK_MAGIC.or.hi(2) /= CK_VER) then
+            why = 'bad magic or version'
+            exit rd
+          end if
+          if (hi(3) /= ck_step) then
+            write (why,'(a,i0)') 'written for step ',hi(3)
+            exit rd
+          end if
+          if (hi(4) /= dat%md_index.or.hi(5) /= dat%simtype.or.hi(6) /= mol%nat.or. &
+          &   hi(7) /= dat%length_steps.or.hi(8) /= dat%sdump.or.hi(9) /= dat%npot.or. &
+          &   hi(10) /= dat%shk%ncons.or.hi(11) /= dat%shk%shake_mode.or. &
+          &   hi(12) /= dat%blockl.or.hi(13) /= dat%maxblock) then
+            why = 'MD parameters changed'
+            exit rd
+          end if
+          if (.not.(beq(hr(1),dat%tstep).and.beq(hr(2),dat%tsoll).and.beq(hr(3),dat%md_hmass))) then
+            why = 'tstep/tsoll/hmass changed'
+            exit rd
+          end if
+          if (dat%simtype == type_md) then
+            if (hk(1) /= ck_skey(1).or.hk(2) /= ck_skey(2)) then
+              why = 'different start structure'
+              exit rd
+            end if
+          end if
+          !>--- (2) progress
+          read (u,iostat=ios) pg
+          if (ios /= 0) then
+            why = 'truncated'
+            exit rd
+          end if
+          if (pg(1) < 1.or.pg(1) > dat%length_steps.or.pg(2) < 0.or.pg(2) > 1.or. &
+          &   pg(6) < 0.or.pg(7) < 0.or.pg(7) > dat%blockl.or.pg(9) < 0.or. &
+          &   pg(9) > dat%maxblock) then
+            why = 'implausible counters'
+            exit rd
+          end if
+          !>--- (3)+(4) integrator and scalars
+          allocate (xt(3,mol%nat),vt(3,mol%nat))
+          read (u,iostat=ios) xt,vt,sc
+          if (ios /= 0) then
+            why = 'truncated'
+            exit rd
+          end if
+          !>--- (5) block data
+          allocate (bet(dat%blockl),btt(dat%blockl),brt(dat%maxblock))
+          read (u,iostat=ios) bet,btt,brt
+          if (ios /= 0) then
+            why = 'truncated'
+            exit rd
+          end if
+          !>--- (6) bias potentials (parameters must equal what md_init_mtd just set)
+          allocate (ncurt(dat%npot),cvdt(dat%npot),cvb(dat%npot))
+          do k = 1,dat%npot
+            read (u,iostat=ios) pk,pr3
+            if (ios /= 0) then
+              why = 'truncated'
+              exit rd
+            end if
+            if (pk(1) /= dat%mtd(k)%mtdtype.or.pk(2) /= dat%mtd(k)%nmax.or. &
+            &   pk(3) /= dat%mtd(k)%maxsave.or.pk(4) /= dat%mtd(k)%cvdumpstep.or. &
+            &   .not.beq(pr3(1),dat%mtd(k)%kpush).or..not.beq(pr3(2),dat%mtd(k)%alpha).or. &
+            &   .not.beq(pr3(3),dat%mtd(k)%ramp)) then
+              why = 'bias parameters changed'
+              exit rd
+            end if
+            if (pk(5) < 0.or.pk(5) > pk(3).or.pk(5) > size(dat%mtd(k)%cvxyz,3)) then
+              why = 'implausible ncur'
+              exit rd
+            end if
+            ncurt(k) = pk(5)
+            cvdt(k) = pk(6)
+            if (pk(5) > 0) then
+              allocate (cvb(k)%x(3,mol%nat,pk(5)))
+              read (u,iostat=ios) cvb(k)%x
+              if (ios /= 0) then
+                why = 'truncated'
+                exit rd
+              end if
+            end if
+          end do
+          !>--- (7) SHAKE
+          if (dat%shk%ncons > 0) then
+            allocate (clt(2,dat%shk%ncons),dct(dat%shk%ncons))
+            read (u,iostat=ios) clt,dct
+            if (ios /= 0) then
+              why = 'truncated'
+              exit rd
+            end if
+          end if
+          !>--- (8) wavefunction (always parsed to reach the trailer)
+          call wfn_read(u,wb,nwb,ios)
+          if (ios /= 0) then
+            why = 'bad wavefunction section'
+            exit rd
+          end if
+          !>--- (9) trailer
+          read (u,iostat=ios) tmag,ttd
+          if (ios /= 0.or.tmag /= CK_MAGIC.or.ttd /= pg(1)) then
+            why = 'bad trailer'
+            exit rd
+          end if
+          exit rd
+        end do rd
+        !$omp critical (crest_ckpt_io)
+        close (u,iostat=ios)
+        !$omp end critical (crest_ckpt_io)
+      end if
+
+      !>--- cut the trajectory back to the frames this checkpoint counts (B.2)
+      if (len_trim(why) == 0) then
+        call truncate_lines(trajectory,int(pg(6),int64)*int(mol%nat+2,int64),okt)
+        if (.not.okt) write (why,'(a,i0,a)') 'trajectory shorter than ',pg(6),' frames'
+      end if
+      if (len_trim(why) > 0) then
+        !$omp critical (crest_ckpt_io)
+        write (stdout,'(a,i0,a)',iostat=ios) 'CREST_CKPT> MD ',dat%md_index, &
+        &      ': checkpoint rejected ('//trim(why)//'), starting fresh'
+        !$omp end critical (crest_ckpt_io)
+        return
+      end if
+
+      !>--- apply (nothing below can fail except the soft wavefunction restore)
+      mol%xyz(:,:) = xt(:,:)
+      velo(:,:) = vt(:,:)
+      edum = sc(1)
+      eerror = sc(2)
+      tav = sc(3)
+      epav = sc(4)
+      ekav = sc(5)
+      ekin = sc(6)
+      temp = sc(7)
+      term = pg(3)
+      dcount = pg(4)
+      printcount = pg(5)
+      dat%dumped = pg(6)
+      dat%iblock = pg(7)
+      dat%nblock = pg(8)
+      dat%blocknreg = pg(9)
+      dat%blocke(:) = bet(:)
+      dat%blockt(:) = btt(:)
+      dat%blockrege(:) = brt(:)
+      ncur1 = 0
+      do k = 1,dat%npot
+        dat%mtd(k)%ncur = ncurt(k)
+        dat%mtd(k)%cvdump = cvdt(k)
+        if (ncurt(k) > 0) dat%mtd(k)%cvxyz(:,:,1:ncurt(k)) = cvb(k)%x(:,:,:)
+        if (k == 1) ncur1 = ncurt(k)
+      end do
+      if (dat%shk%ncons > 0) then
+        dat%shk%conslist(:,:) = clt(:,:)
+        dat%shk%distcons(:) = dct(:)
+      end if
+
+      ck_done = (pg(2) == 1)
+      if (ck_done) then
+        tstart = dat%length_steps+1  !> zero-trip loop, saved term is returned
+        wst = 'n/a (done)'
+      else
+        tstart = pg(1)+1
+        if (ck_nowfn) then
+          wst = 'not (CREST_CKPT_NOWFN)'
+        else
+          !>--- create missing tblite objects at the restored geometry, then overwrite their wfn
+          if (wfn_needs_init(calc)) call engrad(mol,calc,etmp,grd,ios)
+          call wfn_apply(calc,wb,nwb,wok)
+          if (wok) then
+            wst = 'restored'
+          else
+            wst = 'not'
+            call md_ckpt_warn('wfn not restored; continuation is statistically equivalent only')
+          end if
+        end if
+      end if
+      ok = .true.
+      !$omp critical (crest_ckpt_io)
+      write (stdout,'(a,i0,a,i0,a,i0,a,i0)',iostat=ios) 'CREST_CKPT> MD ',dat%md_index, &
+      &     ' resumed after step ',pg(1),' (ncur=',ncur1,', wfn='//trim(wst)//'), epoch ',ck_epoch()
+      !$omp end critical (crest_ckpt_io)
+    end subroutine md_ckpt_read
+
+    logical function beq(a,b)
+!>--- CREST_CKPT: bitwise equality of two reals
+      real(wp),intent(in) :: a,b
+      beq = (transfer(a,0_int64) == transfer(b,0_int64))
+    end function beq
+
+    subroutine md_ckpt_warn(msg)
+!>--- CREST_CKPT: one warning per MD
+      character(len=*),intent(in) :: msg
+      if (ck_warned) return
+      ck_warned = .true.
+      !$omp critical (crest_ckpt_io)
+      write (stderr,'(a,i0,a)',iostat=ck_io) 'CREST_CKPT> WARNING MD ',dat%md_index,': '//msg
+      !$omp end critical (crest_ckpt_io)
+    end subroutine md_ckpt_warn
+
