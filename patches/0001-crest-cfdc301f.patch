diff -ruN --exclude=subprojects upstream/src/algos/parallel.f90 v2tree/src/algos/parallel.f90
--- upstream/src/algos/parallel.f90	2026-09-25 14:45:13
+++ v2tree/src/algos/parallel.f90	2026-10-12 12:08:15
@@ -17,6 +17,733 @@
 ! along with crest.  If not, see <https://www.gnu.org/licenses/>.
 !================================================================================!
 
+!========================================================================================!
+!========================================================================================!
+!> CREST_DIST_OLOOP (crest_dist_oloop_v2, 2026-10-12; v1 + review fixes F1-F10): opt-in
+!> distribution of one crest_oloop pass over Slurm array workers that run this same binary.
+!> Inert unless CREST_DIST_OLOOP (driver) or CREST_DIST_OLOOP_WORKER (worker) is set.
+!> Helpers only: config file, settings fingerprint, chunk/result files (stream I/O).
+!========================================================================================!
+!========================================================================================!
+module crest_dist_oloop
+  use iso_fortran_env,only:wp => real64,int64,int32
+  use iso_c_binding,only:c_int
+  use crest_calculator,only:calcdata
+  implicit none
+  private
+
+  !> settings of CREST_DIST_OLOOP=<config file, or a directory holding dist_oloop.conf>
+  type,public :: dist_cfg
+    character(len=1024) :: workdir = ''        !> pass directories are created here (absolute path)
+    character(len=1024) :: worker_script = ''  !> sbatch script run by every array task
+    character(len=1024) :: worker_env = ''     !> bash file the worker sources (modules, OMP settings)
+    character(len=4096) :: sbatch_args = ''    !> extra sbatch arguments (partition, account, ...)
+    integer :: worker_threads = 32             !> -T of one worker (capped at the smallest chunk)
+    integer :: chunk = 128                     !> structures per chunk (raised so that chunks <= 1000)
+    integer :: throttle = 40                   !> %N of the array
+    integer :: poll = 60                       !> seconds between squeue queries (>= 30)
+    integer :: min_structures = 1000           !> smaller passes run in-process
+    integer :: verify = 32                     !> worker structures recomputed in-process, bitwise
+    integer :: local = 1                       !> driver computes unclaimed chunks while it waits
+    integer :: submit = 1                      !> 0: no Slurm submission (local test mode)
+    integer :: max_rounds = 10                 !> submissions per chunk (a chunk is resubmitted at most max_rounds-1 times)
+    integer :: verify_other = -1               !> worker structures from other CPU models tolerance-checked (-1: = verify)
+    integer :: same_cpu = 0                    !> 1: results of workers on another CPU model are recomputed by the driver
+    integer :: lost_wait = 90                  !> s a chunk must stay out of squeue without a result before it is resubmitted (>= 60)
+    integer :: local_after = 1800              !> s without a running worker or a new result before the driver computes (local = 0; 0: never)
+  end type dist_cfg
+
+  character(len=8),parameter,public :: dmagic_chunk = 'CRDOLC01'
+  character(len=8),parameter,public :: dmagic_res = 'CRDOLR02'
+  character(len=8),parameter,public :: dmagic_end = 'CRDOLEND'
+  integer,parameter,public :: dniov = 10
+  integer,parameter,public :: dnrov = 8
+  integer,parameter,public :: dfplen = 8192
+  !> tolerance for results of workers on another CPU model (energy in Eh, coordinate RMSD in Angstrom)
+  real(wp),parameter,public :: dtol_e = 1.0e-7_wp
+  real(wp),parameter,public :: dtol_rmsd = 1.0e-4_wp
+
+  public :: dist_getenv,dist_read_config,dist_fingerprint
+  public :: dist_overrides_get,dist_overrides_apply,dist_hash_hex,dist_cpu_model
+  public :: dist_ranges,dist_write_chunk,dist_read_chunk,dist_write_result,dist_read_result
+  public :: dist_c_exit,dist_bits_equal
+  public :: dist_exe_sha,dist_jobid,dist_parse_ranges,dist_checksum
+
+  interface
+    subroutine dist_c_exit(st) bind(C,name='_exit')
+      import :: c_int
+      integer(c_int),value :: st
+    end subroutine dist_c_exit
+  end interface
+
+contains
+
+  subroutine dist_getenv(name,val,ok)
+    character(len=*),intent(in) :: name
+    character(len=*),intent(out) :: val
+    logical,intent(out) :: ok
+    integer :: l,st
+    val = ''
+    call get_environment_variable(name,val,length=l,status=st)
+    ok = (st == 0.and.l > 0.and.l <= len(val))
+    if (.not.ok) val = ''
+  end subroutine dist_getenv
+
+  subroutine dist_read_config(path,cfg,ok,msg)
+    character(len=*),intent(in) :: path
+    type(dist_cfg),intent(out) :: cfg
+    logical,intent(out) :: ok
+    character(len=*),intent(out) :: msg
+    character(len=1100) :: f
+    character(len=4096) :: line,key,val
+    integer :: u,io,k,iv
+    logical :: ex
+    ok = .false.
+    msg = ''
+    f = trim(path)//'/dist_oloop.conf'
+    inquire (file=trim(f),exist=ex)
+    if (.not.ex) f = path
+    open (newunit=u,file=trim(f),status='old',action='read',iostat=io)
+    if (io /= 0) then
+      msg = 'cannot open config '//trim(f)
+      return
+    end if
+    do
+      read (u,'(a)',iostat=io) line
+      if (io /= 0) exit
+      !> a '#' starts a comment only at the start of a line or after a blank, so that values may contain '#'
+      if (index(adjustl(line),'#') == 1) cycle
+      k = index(line,' #')
+      if (k > 0) line(k:) = ''
+      k = index(line,achar(9)//'#')
+      if (k > 0) line(k:) = ''
+      k = index(line,'=')
+      if (k <= 1) cycle
+      key = adjustl(line(1:k-1))
+      val = adjustl(line(k+1:))
+      select case (trim(key))
+      case ('workdir')
+        cfg%workdir = val
+      case ('worker_script')
+        cfg%worker_script = val
+      case ('worker_env')
+        cfg%worker_env = val
+      case ('sbatch_args')
+        cfg%sbatch_args = val
+      case ('worker_threads','chunk','throttle','poll','min_structures','verify','local','submit','max_rounds', &
+      &     'verify_other','same_cpu','lost_wait','local_after')
+        read (val,*,iostat=io) iv
+        if (io /= 0) then
+          msg = 'config '//trim(f)//': not an integer: '//trim(key)
+          close (u)
+          return
+        end if
+        select case (trim(key))
+        case ('worker_threads'); cfg%worker_threads = iv
+        case ('chunk'); cfg%chunk = iv
+        case ('throttle'); cfg%throttle = iv
+        case ('poll'); cfg%poll = iv
+        case ('min_structures'); cfg%min_structures = iv
+        case ('verify'); cfg%verify = iv
+        case ('local'); cfg%local = iv
+        case ('submit'); cfg%submit = iv
+        case ('max_rounds'); cfg%max_rounds = iv
+        case ('verify_other'); cfg%verify_other = iv
+        case ('same_cpu'); cfg%same_cpu = iv
+        case ('lost_wait'); cfg%lost_wait = iv
+        case ('local_after'); cfg%local_after = iv
+        end select
+      case default
+        msg = 'config '//trim(f)//': unknown key '//trim(key)
+        close (u)
+        return
+      end select
+    end do
+    close (u)
+    if (len_trim(cfg%workdir) == 0.or.cfg%workdir(1:1) /= '/') then
+      msg = 'config '//trim(f)//': workdir must be an absolute path'
+      return
+    end if
+    if (cfg%submit /= 0.and.len_trim(cfg%worker_script) == 0) then
+      msg = 'config '//trim(f)//': worker_script is required when submit /= 0'
+      return
+    end if
+    if (.not.dist_shell_safe(cfg%sbatch_args)) then
+      msg = 'config '//trim(f)//': sbatch_args contains an unquoted shell character (| ; & < > ` $ ( ) or backslash); '// &
+      &     'it is passed to /bin/sh, so quote such values, e.g. --constraint="epyc-7502|epyc-7413"'
+      return
+    end if
+    cfg%poll = max(cfg%poll,30)
+    cfg%lost_wait = max(cfg%lost_wait,60)
+    cfg%local_after = max(cfg%local_after,0)
+    cfg%max_rounds = max(cfg%max_rounds,1)
+    if (cfg%verify_other < 0) cfg%verify_other = cfg%verify
+    cfg%chunk = max(cfg%chunk,1)
+    cfg%worker_threads = max(cfg%worker_threads,1)
+    cfg%throttle = max(cfg%throttle,1)
+    cfg%verify = max(cfg%verify,0)
+    cfg%min_structures = max(cfg%min_structures,1)
+    if (cfg%submit == 0) cfg%local = 1
+    ok = .true.
+  end subroutine dist_read_config
