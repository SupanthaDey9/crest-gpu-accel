+# Appended only to the isolated experiment checkout, after the frozen overlay.
+option(WITH_TBLITE_GPU_DENSITY_EXPERIMENT "Experimental ordinary-density CUDA hook" OFF)
+if(WITH_TBLITE_GPU_DENSITY_EXPERIMENT AND NOT WITH_TBLITE_GPU)
