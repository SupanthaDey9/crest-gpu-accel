+  integer function restart_goal_of()
+!> restart goal step (0 if this is not a restart)
+    implicit none
+    restart_goal_of = restart_goal
+  end function restart_goal_of
+
+  logical function restart_replaying()
+!> .true. while completed steps are skipped (tracker < goal)
+    implicit none
+    restart_replaying = (restart_goal > 0 .and. restart_tracker < restart_goal)
+  end function restart_replaying
+
+  subroutine restart_set_kind(kind)
+!> label the NEXT tracked step ('multimd','multimd2','oloop','collect',...)
+    implicit none
+    character(len=*),intent(in) :: kind
+    next_kind = kind
+  end subroutine restart_set_kind
+
+  subroutine restart_set_stage(stage)
+!> workflow stage written into the trailing record ('mtd' | 'post')
+    implicit none
+    character(len=*),intent(in) :: stage
+    cur_stage = stage
+  end subroutine restart_set_stage
+
+  logical function restart_post_restore_due()
+!> .true. at the goal step if the goal is the saved post-loop entry
+    implicit none
+    restart_post_restore_due = (post_restore .and. restart_tracker == restart_goal)
+  end function restart_post_restore_due
+
+  logical function track_due()
+!***************************************************************************
+!* CREST_CKPT (SYNTHESIS D.6, repeated preemption): should trackensemble
+!* record? Upstream: only once the goal has been passed (tracker > goal),
+!* so the ensembles of the re-executed goal step itself were never recorded
+!* and the next dumps of a resumed segment carried the goal's INPUT instead
+!* of its output. A second preemption before the next recorded ensemble
+!* then restored the wrong file at goal-1. With CREST_CKPT>0 the goal step
+!* is recorded too, so every dump holds what an uninterrupted run would.
+!***************************************************************************
+    implicit none
+    track_due = (restart_tracker > restart_goal)
+    if (.not.track_due .and. restart_goal > 0 .and. restart_tracker == restart_goal) then
+      track_due = (ckpt_steps() > 0)
+    end if
+  end function track_due
+
+  function restart_decision(kind,val) result(dec)
+!**************************************************************************
+!* CREST_CKPT (SYNTHESIS C.4, B.5): control-flow decisions (kind = 'ELOW',
+!* 'WIDEN','GCN'). Running live, append "<tracker> <kind> <0|1>" to
+!* crest_ckpt/decisions.log and return val. While completed steps are
+!* skipped (tracker < goal), return the last logged value for
+!* (tracker,kind) instead. CREST_CKPT unset/0: return val.
+!**************************************************************************
+    implicit none
+    character(len=*),intent(in) :: kind
+    logical,intent(in) :: val
+    logical :: dec
+    integer :: ich,io,itr,iv
+    character(len=16) :: kstr
+    character(len=256) :: line
+    logical :: ex,found
+    dec = val
+    if (ckpt_steps() <= 0) return
+
+    if (restart_replaying()) then
+!>--- replay: last logged value for (tracker,kind)
+      inquire (file=ckpt_declog,exist=ex)
+      if (.not.ex) then
+        if (.not.dec_warned) write (stdout,'(a)') 'CREST_RESTART> **WARNING** '//ckpt_declog// &
+        &  ' not found (legacy run): replayed decisions are recomputed'
+        dec_warned = .true.
+        return
+      end if
+      found = .false.
+      open (newunit=ich,file=ckpt_declog,status='old',action='read',iostat=io)
+      if (io == 0) then
+        do
+          read (ich,'(a)',iostat=io) line
+          if (io /= 0) exit
+          read (line,*,iostat=io) itr,kstr,iv
+          if (io /= 0) cycle  !> e.g. a torn last line
+          if (itr == restart_tracker .and. kstr == kind .and. (iv == 0 .or. iv == 1)) then
+            found = .true.
+            dec = (iv == 1)
+          end if
+        end do
+        close (ich)
+      end if
+      if (found) then
+        write (stdout,'(a,i0,a,a,a,i0)') 'CREST_RESTART> replayed decision at step ',restart_tracker, &
+        &  ': ',trim(kind),' = ',merge(1,0,dec)
+      else
+        write (stderr,'(a,a,a,i0)') '**ERROR** CREST_RESTART> replay diverged: no logged ',trim(kind), &
+        &  ' decision for step ',restart_tracker
+        if (.not.env_set('CREST_RESUME_FORCE')) error stop 3
+        write (stderr,'(a)') '**WARNING** CREST_RESTART> CREST_RESUME_FORCE is set, recomputing the decision'
+        dec = val
+      end if
+    else
+!>--- live: append one line and close
+      io = makedir('crest_ckpt')
+      if (dec_first .and. restart_goal == 0) then
+        !> fresh run: replace a stale log left by an earlier run in this directory
+        open (newunit=ich,file=ckpt_declog,status='replace',action='write',iostat=io)
+      else
+        open (newunit=ich,file=ckpt_declog,status='unknown',position='append',action='write',iostat=io)
+      end if
+      dec_first = .false.
+      if (io == 0) then
+        write (ich,'(i0,1x,a,1x,i0)',iostat=io) restart_tracker,trim(kind),merge(1,0,val)
+        if (io == 0) call ck_sync(ich,io)
+        close (ich)
+      end if
+      if (io /= 0) write (stderr,'(a)') '**WARNING** CREST_RESTART> could not append to '//ckpt_declog
+    end if
+  end function restart_decision
+
+  integer function kidx(kind)
+!> counter slot of a tracked-step kind
+    implicit none
+    character(len=*),intent(in) :: kind
+    select case (trim(kind))
+    case ('cregen')
+      kidx = 1
+    case ('multimd')
+      kidx = 2
+    case ('multimd2')
+      kidx = 3
+    case ('oloop')
+      kidx = 4
+    case ('collect')
+      kidx = 5
+    case default
+      kidx = 6
+    end select
+  end function kidx
+
+  logical function env_set(vname)
+!> environment variable is set to a non-empty value other than '0'
+    implicit none
+    character(len=*),intent(in) :: vname
+    character(len=64) :: val
+    integer :: l,st
+    val = ' '
+    l = 0
+    call get_environment_variable(vname,val,length=l,status=st)
+    env_set = ((st == 0 .or. st == -1) .and. l > 0 .and. trim(adjustl(val)) /= '0')
+  end function env_set
+
+  function env_value(vname) result(val)
+!> value of an environment variable ('' if unset)
+    implicit none
+    character(len=*),intent(in) :: vname
+    character(len=64) :: val
+    integer :: st
+    val = ' '
+    call get_environment_variable(vname,val,status=st)
+    if (st /= 0) val = ' '
+    val = adjustl(val)
+  end function env_value
 
