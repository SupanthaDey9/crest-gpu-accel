+!>--- .true. if s has no shell metacharacter outside single or double quotes
+  logical function dist_shell_safe(s) result(safe)
+    character(len=*),intent(in) :: s
+    integer :: i
+    character :: q,ch
+    safe = .true.
+    q = ' '
+    do i = 1,len_trim(s)
+      ch = s(i:i)
+      if (q /= ' ') then
+        if (ch == q) q = ' '
+      else if (ch == '"'.or.ch == "'") then
+        q = ch
+      else if (index('|;&<>`$()'//achar(92),ch) > 0) then
+        safe = .false.
+        return
+      end if
+    end do
+    if (q /= ' ') safe = .false.
+  end function dist_shell_safe
+
+!>--- text record of every calcdata setting that can change an optimization result;
+!>    reals as bit patterns. Driver and worker must produce the same text.
+!>    cpu_solver (hybrid v1): the pass runs the CPU tblite solver whatever c says
+!>    (CREST_OPT_SOLVER=cpu), so the solver is recorded as 0 (cpu), as the worker reads it
+  subroutine dist_fingerprint(c,fp,n,cpu_solver)
+    type(calcdata),intent(in) :: c
+    character(len=dfplen),intent(out) :: fp
+    integer,intent(out) :: n
+    logical,intent(in),optional :: cpu_solver
+    integer :: j,sv
+    character(len=16) :: jj
+    fp = ''
+    n = 0
+    call ai('calc.id',c%id)
+    call ai('ncalculations',c%ncalculations)
+    call ai('nconstraints',c%nconstraints)
+    call ai('nscans',c%nscans)
+    call ai('nfreeze',c%nfreeze)
+    call al('oniom',allocated(c%ONIOM))
+    call al('optnewinit',c%optnewinit)
+    call al('anopt',c%anopt)
+    call ai('optlev',c%optlev)
+    call ai('micro_opt',c%micro_opt)
+    call ai('maxcycle',c%maxcycle)
+    call ar('maxdispl_opt',c%maxdispl_opt)
+    call ar('ethr_opt',c%ethr_opt)
+    call ar('gthr_opt',c%gthr_opt)
+    call ar('hlow_opt',c%hlow_opt)
+    call ar('hmax_opt',c%hmax_opt)
+    call ar('acc_opt',c%acc_opt)
+    call ar('maxerise',c%maxerise)
+    call ar('hguess',c%hguess)
+    call al('exact_rf',c%exact_rf)
+    call al('average_conv',c%average_conv)
+    call al('tsopt',c%tsopt)
+    call ai('iupdat',c%iupdat)
+    call ai('opt_engine',c%opt_engine)
+    do j = 1,c%ncalculations
+      write (jj,'(a,i0,a)') 'L',j,'.'
+      call ai(trim(jj)//'id',c%calcs(j)%id)
+      call ai(trim(jj)//'chrg',c%calcs(j)%chrg)
+      call ai(trim(jj)//'uhf',c%calcs(j)%uhf)
+      call al(trim(jj)//'active',c%calcs(j)%active)
+      call ar(trim(jj)//'weight',c%calcs(j)%weight)
+      call al(trim(jj)//'numgrad',c%calcs(j)%numgrad)
+      call ar(trim(jj)//'gradstep',c%calcs(j)%gradstep)
+      call ai(trim(jj)//'refine_lvl',c%calcs(j)%refine_lvl)
+      call ai(trim(jj)//'tblitelvl',c%calcs(j)%tblitelvl)
+      call ar(trim(jj)//'etemp',c%calcs(j)%etemp)
+      call ar(trim(jj)//'accuracy',c%calcs(j)%accuracy)
+      call al(trim(jj)//'apiclean',c%calcs(j)%apiclean)
+      call ai(trim(jj)//'maxscc',c%calcs(j)%maxscc)
+      call al(trim(jj)//'saveint',c%calcs(j)%saveint)
+      call ac(trim(jj)//'solvmodel',c%calcs(j)%solvmodel)
+      call ac(trim(jj)//'solvent',c%calcs(j)%solvent)
+      call ac(trim(jj)//'parametrisation',c%calcs(j)%parametrisation)
+      call ac(trim(jj)//'tbliteparam',c%calcs(j)%tbliteparam)
+      call al(trim(jj)//'restart',c%calcs(j)%restart)
+      call ac(trim(jj)//'restartfile',c%calcs(j)%restartfile)
+      call ac(trim(jj)//'refgeo',c%calcs(j)%refgeo)
+      call ac(trim(jj)//'refcharges',c%calcs(j)%refcharges)
+      call al(trim(jj)//'rdwbo',c%calcs(j)%rdwbo)
+      call al(trim(jj)//'rdqat',c%calcs(j)%rdqat)
+      call al(trim(jj)//'dumpq',c%calcs(j)%dumpq)
+      call al(trim(jj)//'rddip',c%calcs(j)%rddip)
+      call al(trim(jj)//'rddipgrad',c%calcs(j)%rddipgrad)
+      sv = c%calcs(j)%tblite_solver
+      if (present(cpu_solver)) then
+        if (cpu_solver) sv = 0
+      end if
+      call ai(trim(jj)//'tblite_solver',sv)
+      call al(trim(jj)//'tblite_gpu_audit',c%calcs(j)%tblite_gpu_audit)
+    end do
+  contains
+    subroutine add(s)
+      character(len=*),intent(in) :: s
+      if (n+len(s)+1 > dfplen) return
+      fp(n+1:n+len(s)) = s
+      n = n+len(s)+1
+      fp(n:n) = achar(10)
+    end subroutine add
+    subroutine ai(k,v)
+      character(len=*),intent(in) :: k
+      integer,intent(in) :: v
+      character(len=24) :: b
+      write (b,'(i0)') v
+      call add(k//'='//trim(b))
+    end subroutine ai
+    subroutine al(k,v)
+      character(len=*),intent(in) :: k
+      logical,intent(in) :: v
+      if (v) then
+        call add(k//'=T')
+      else
+        call add(k//'=F')
+      end if
+    end subroutine al
+    subroutine ar(k,v)
+      character(len=*),intent(in) :: k
+      real(wp),intent(in) :: v
+      character(len=16) :: b
+      write (b,'(z16.16)') transfer(v,0_int64)
+      call add(k//'='//b)
+    end subroutine ar
+    subroutine ac(k,v)
+      character(len=*),intent(in) :: k
+      character(len=:),allocatable,intent(in) :: v
+      if (allocated(v)) then
+        call add(k//'="'//v//'"')
+      else
+        call add(k//'=<unset>')
+      end if
+    end subroutine ac
+  end subroutine dist_fingerprint
+
+!>--- optimizer settings of the pass (set by the search, e.g. crude level, hlow 0.005)
+  subroutine dist_overrides_get(c,iov,rov)
+    type(calcdata),intent(in) :: c
+    integer,intent(out) :: iov(dniov)
+    real(wp),intent(out) :: rov(dnrov)
+    iov = [c%optlev,c%micro_opt,c%maxcycle,c%iupdat,c%opt_engine,l2i(c%anopt),l2i(c%exact_rf), &
+    &      l2i(c%average_conv),l2i(c%tsopt),l2i(c%optnewinit)]
+    rov = [c%maxdispl_opt,c%ethr_opt,c%gthr_opt,c%hlow_opt,c%hmax_opt,c%acc_opt,c%maxerise,c%hguess]
+  end subroutine dist_overrides_get
+
+  subroutine dist_overrides_apply(c,iov,rov)
+    type(calcdata),intent(inout) :: c
+    integer,intent(in) :: iov(dniov)
+    real(wp),intent(in) :: rov(dnrov)
+    c%optlev = iov(1)
+    c%micro_opt = iov(2)
+    c%maxcycle = iov(3)
+    c%iupdat = iov(4)
+    c%opt_engine = iov(5)
+    c%anopt = (iov(6) /= 0)
+    c%exact_rf = (iov(7) /= 0)
+    c%average_conv = (iov(8) /= 0)
+    c%tsopt = (iov(9) /= 0)
+    c%optnewinit = (iov(10) /= 0)
+    c%maxdispl_opt = rov(1)
+    c%ethr_opt = rov(2)
+    c%gthr_opt = rov(3)
+    c%hlow_opt = rov(4)
+    c%hmax_opt = rov(5)
+    c%acc_opt = rov(6)
+    c%maxerise = rov(7)
+    c%hguess = rov(8)
+  end subroutine dist_overrides_apply
+
+  integer function l2i(l)
+    logical,intent(in) :: l
+    l2i = 0
+    if (l) l2i = 1
+  end function l2i
+
+!>--- pass identity: two 31-bit modular hashes over the fingerprint and the input key
+  subroutine dist_hash_hex(s,nat,nall,key,hex)
+    character(len=*),intent(in) :: s
+    integer,intent(in) :: nat,nall
+    integer(int64),intent(in) :: key(3)
+    character(len=16),intent(out) :: hex
+    integer(int64) :: h1,h2,v(5)
+    integer :: i,k
+    h1 = 17_int64
+    h2 = 31_int64
+    do i = 1,len(s)
+      call mix(int(ichar(s(i:i)),int64))
+    end do
+    v = [int(nat,int64),int(nall,int64),key(1),key(2),key(3)]
+    do i = 1,5
+      do k = 0,7
+        call mix(iand(ishft(v(i),-8*k),255_int64))
+      end do
+    end do
+    write (hex,'(z8.8,z8.8)') int(h1,int32),int(h2,int32)
+  contains
+    subroutine mix(b)
+      integer(int64),intent(in) :: b
+      h1 = mod(h1*1000003_int64+b,2147483647_int64)
+      h2 = mod(h2*999983_int64+b+7_int64,2147483629_int64)
+    end subroutine mix
+  end subroutine dist_hash_hex
+
+  subroutine dist_cpu_model(s)
+    character(len=64),intent(out) :: s
+    character(len=512) :: line
+    integer :: u,io,k
+    s = 'unknown'
+    open (newunit=u,file='/proc/cpuinfo',status='old',action='read',iostat=io)
+    if (io /= 0) return
+    do
+      read (u,'(a)',iostat=io) line
+      if (io /= 0) exit
+      if (index(line,'model name') == 1) then
+        k = index(line,':')
+        if (k > 0) s = adjustl(line(k+1:))
+        exit
+      end if
+    end do
+    close (u)
+  end subroutine dist_cpu_model
+
+!>--- sorted list -> "a-b,c,d-e" (Slurm --array syntax)
+  subroutine dist_ranges(list,n,s,ls)
+    integer,intent(in) :: n,list(n)
+    character(len=*),intent(out) :: s
+    integer,intent(out) :: ls
+    integer :: i,j
+    character(len=32) :: b
+    s = ''
+    ls = 0
+    i = 1
+    do while (i <= n)
+      j = i
+      do while (j < n)
+        if (list(j+1) /= list(j)+1) exit
+        j = j+1
+      end do
+      if (j > i) then
+        write (b,'(i0,a,i0)') list(i),'-',list(j)
+      else
+        write (b,'(i0)') list(i)
+      end if
+      if (ls > 0) then
+        s(ls+1:ls+1) = ','
+        ls = ls+1
+      end if
+      s(ls+1:ls+len_trim(b)) = trim(b)
+      ls = ls+len_trim(b)
+      i = j+1
+    end do
+  end subroutine dist_ranges
+
+  logical function dist_bits_equal(a,b) result(eq)
+    real(wp),intent(in) :: a(:),b(:)
+    integer :: i
+    eq = (size(a) == size(b))
+    if (.not.eq) return
+    do i = 1,size(a)
+      if (transfer(a(i),0_int64) /= transfer(b(i),0_int64)) then
+        eq = .false.
+        return
+      end if
+    end do
+  end function dist_bits_equal
+
+!>--- chunk file: header, settings fingerprint, optimizer settings, atoms, indices, xyz (Bohr)
+  subroutine dist_write_chunk(fname,cid,nall,nat,n,tn,nested,fp,nfp,iov,rov,at,idx,xyz,key,io)
+    character(len=*),intent(in) :: fname,fp
+    integer,intent(in) :: cid,nall,nat,n,tn,nfp,iov(dniov),at(nat),idx(n)
+    logical,intent(in) :: nested
+    real(wp),intent(in) :: rov(dnrov),xyz(3,nat,n)
+    integer(int64),intent(in) :: key(3)
+    integer,intent(out) :: io
+    integer :: u,io2,nst
+    nst = 0
+    if (nested) nst = 1
+    open (newunit=u,file=fname//'.tmp',access='stream',form='unformatted',status='replace', &
+    &     action='write',iostat=io)
+    if (io /= 0) return
+    write (u,iostat=io) dmagic_chunk,1_int32,int(cid,int32),int(nall,int32),int(nat,int32),int(n,int32), &
+    &                   int(tn,int32),int(nst,int32),int(nfp,int32)
+    if (io == 0) write (u,iostat=io) fp(1:nfp)
+    if (io == 0) write (u,iostat=io) int(iov,int32),rov
+    if (io == 0) write (u,iostat=io) int(at,int32),int(idx,int32)
+    if (io == 0) write (u,iostat=io) xyz
+    if (io == 0) write (u,iostat=io) key,dmagic_end
+    close (u,iostat=io2)
+    if (io == 0) io = io2
+    if (io == 0) call rename(fname//'.tmp',fname,io)
+  end subroutine dist_write_chunk
+
+  subroutine dist_read_chunk(fname,cid,nall,nat,n,tn,nst,fp,nfp,iov,rov,at,idx,xyz,key,ok)
+    character(len=*),intent(in) :: fname
+    integer,intent(out) :: cid,nall,nat,n,tn,nst,nfp,iov(dniov)
+    character(len=dfplen),intent(out) :: fp
+    real(wp),intent(out) :: rov(dnrov)
+    integer,allocatable,intent(out) :: at(:),idx(:)
+    real(wp),allocatable,intent(out) :: xyz(:,:,:)
+    integer(int64),intent(out) :: key(3)
+    logical,intent(out) :: ok
+    character(len=8) :: m1,m2
+    integer(int32) :: h(8),iov4(dniov)
+    integer(int32),allocatable :: a4(:),i4(:)
+    integer :: u,io
+    ok = .false.
+    fp = ''
+    open (newunit=u,file=fname,access='stream',form='unformatted',status='old',action='read',iostat=io)
+    if (io /= 0) return
+    read (u,iostat=io) m1,h
+    if (io /= 0.or.m1 /= dmagic_chunk.or.h(1) /= 1) then
+      close (u)
+      return
+    end if
+    cid = h(2); nall = h(3); nat = h(4); n = h(5); tn = h(6); nst = h(7); nfp = h(8)
+    if (nat < 1.or.n < 1.or.nfp < 1.or.nfp > dfplen) then
+      close (u)
+      return
+    end if
+    read (u,iostat=io) fp(1:nfp)
+    if (io == 0) read (u,iostat=io) iov4,rov
+    allocate (a4(nat),i4(n),xyz(3,nat,n))
+    if (io == 0) read (u,iostat=io) a4,i4
+    if (io == 0) read (u,iostat=io) xyz
+    if (io == 0) read (u,iostat=io) key,m2
+    close (u)
+    if (io /= 0.or.m2 /= dmagic_end) return
+    iov = iov4
+    at = a4
+    idx = i4
+    ok = .true.
+  end subroutine dist_read_chunk
+
+!>--- result file (v2): per structure status (0 optimized, 1 partial, 2 failed), energy, gnorm,
+!>    level energies (etmp) and the optimized xyz (Bohr, before any output rounding).
+!>    The header names the writer's CPU model, crest binary (sha256) and Slurm task; a checksum
+!>    of the payload precedes the end magic. The temporary name is unique per host, task and pid.
+  subroutine dist_write_result(fname,cid,n,nat,netmp,writer,key,cpu,exesha,jobid,idx,st,en,gn,et,xyz,io)
+    character(len=*),intent(in) :: fname
+    integer,intent(in) :: cid,n,nat,netmp,writer,idx(n),st(n)
+    integer(int64),intent(in) :: key(3)
+    character(len=64),intent(in) :: cpu,exesha
+    character(len=32),intent(in) :: jobid
+    real(wp),intent(in) :: en(n),gn(n),et(netmp,n),xyz(3,nat,n)
+    integer,intent(out) :: io
+    integer :: u,io2,i
+    integer(int64) :: ck(2)
+    character(len=64) :: host
+    character(len=32) :: jb
+    character(len=200) :: tag
+    host = ''
+    call hostnm(host)
+    jb = jobid
+    do i = 1,len_trim(host)
+      if (index('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.',host(i:i)) == 0) host(i:i) = '_'
+    end do
+    do i = 1,len_trim(jb)
+      if (index('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-.',jb(i:i)) == 0) jb(i:i) = '_'
+    end do
+    write (tag,'(a,i0,a,a,a,a,a,i0)') '.tmp',writer,'_',trim(host),'_',trim(jb),'_',getpid()
+    call dist_checksum(n,nat,netmp,idx,st,en,gn,et,xyz,ck)
+    open (newunit=u,file=fname//trim(tag),access='stream',form='unformatted',status='replace', &
+    &     action='write',iostat=io)
+    if (io /= 0) return
+    write (u,iostat=io) dmagic_res,2_int32,int(cid,int32),int(n,int32),int(nat,int32),int(netmp,int32), &
+    &                   int(writer,int32),key,cpu,exesha,jobid
+    if (io == 0) write (u,iostat=io) int(idx,int32),int(st,int32)
+    if (io == 0) write (u,iostat=io) en,gn,et,xyz
+    if (io == 0) write (u,iostat=io) ck,dmagic_end
+    close (u,iostat=io2)
+    if (io == 0) io = io2
+    if (io == 0) call rename(fname//trim(tag),fname,io)
+  end subroutine dist_write_result
+
+  subroutine dist_read_result(fname,cid,n,nat,netmp,writer,key,cpu,exesha,jobid,idx,st,en,gn,et,xyz,ok)
+    character(len=*),intent(in) :: fname
+    integer,intent(out) :: cid,n,nat,netmp,writer
+    integer(int64),intent(out) :: key(3)
+    character(len=64),intent(out) :: cpu,exesha
+    character(len=32),intent(out) :: jobid
+    integer,allocatable,intent(out) :: idx(:),st(:)
+    real(wp),allocatable,intent(out) :: en(:),gn(:),et(:,:),xyz(:,:,:)
+    logical,intent(out) :: ok
+    character(len=8) :: m1,m2
+    integer(int32) :: h(6)
+    integer(int32),allocatable :: i4(:),s4(:)
+    integer(int64) :: ck(2),ck2(2)
+    integer :: u,io
+    ok = .false.
+    open (newunit=u,file=fname,access='stream',form='unformatted',status='old',action='read',iostat=io)
+    if (io /= 0) return
+    read (u,iostat=io) m1,h,key,cpu,exesha,jobid
+    if (io /= 0.or.m1 /= dmagic_res.or.h(1) /= 2) then
+      close (u)
+      return
+    end if
+    cid = h(2); n = h(3); nat = h(4); netmp = h(5); writer = h(6)
+    if (n < 1.or.nat < 1.or.netmp < 0.or.netmp > 64) then
+      close (u)
+      return
+    end if
+    allocate (i4(n),s4(n),en(n),gn(n),et(netmp,n),xyz(3,nat,n))
+    read (u,iostat=io) i4,s4
+    if (io == 0) read (u,iostat=io) en,gn,et,xyz
+    if (io == 0) read (u,iostat=io) ck,m2
+    close (u)
+    if (io /= 0.or.m2 /= dmagic_end) return
+    idx = i4
+    st = s4
+    call dist_checksum(n,nat,netmp,idx,st,en,gn,et,xyz,ck2)
+    ok = all(ck == ck2)
+  end subroutine dist_read_result
+
+!>--- payload checksum of a result: two modular hashes over the 32-bit words of idx, st and
+!>    the bit patterns of en, gn, et, xyz (no integer overflow; reproducible in Python)
+  subroutine dist_checksum(n,nat,netmp,idx,st,en,gn,et,xyz,ck)
+    integer,intent(in) :: n,nat,netmp,idx(n),st(n)
+    real(wp),intent(in) :: en(n),gn(n),et(netmp,n),xyz(3,nat,n)
+    integer(int64),intent(out) :: ck(2)
+    integer :: i,j,k
+    ck = [17_int64,31_int64]
+    do i = 1,n
+      call w32(int(idx(i),int64))
+    end do
+    do i = 1,n
+      call w32(int(st(i),int64))
+    end do
+    do i = 1,n
+      call w64(en(i))
+    end do
+    do i = 1,n
+      call w64(gn(i))
+    end do
+    do i = 1,n
+      do j = 1,netmp
+        call w64(et(j,i))
+      end do
+    end do
+    do i = 1,n
+      do j = 1,nat
+        do k = 1,3
+          call w64(xyz(k,j,i))
+        end do
+      end do
+    end do
+  contains
+    subroutine w32(v)
+      integer(int64),intent(in) :: v
+      integer(int64) :: b
+      b = iand(v,4294967295_int64)   !> low 32 bits (two's complement word as written to the file)
+      ck(1) = mod(ck(1)*1000003_int64+b,2147483647_int64)
+      ck(2) = mod(ck(2)*999983_int64+b+7_int64,2147483629_int64)
+    end subroutine w32
+    subroutine w64(x)
+      real(wp),intent(in) :: x
+      integer(int64) :: v
+      v = transfer(x,0_int64)
+      call w32(iand(v,4294967295_int64))
+      call w32(iand(ishft(v,-32),4294967295_int64))
+    end subroutine w64
+  end subroutine dist_checksum
+
+!>--- sha256 and path of the running crest binary (one shell call per process, then cached);
+!>    'unknown' when it cannot be determined
+  subroutine dist_exe_sha(sha,path)
+    character(len=64),intent(out) :: sha
+    character(len=1024),intent(out) :: path
+    character(len=64),save :: csha = ''
+    character(len=1024),save :: cpath = ''
+    logical,save :: cdone = .false.
+    character(len=1024) :: td,a0,f
+    character(len=4096) :: cmd
+    integer :: es,cs,u,io,l,st
+    logical :: okt
+    if (.not.cdone) then
+      cdone = .true.
+      csha = 'unknown'
+      cpath = ''
+      call dist_getenv('TMPDIR',td,okt)
+      if (.not.okt) td = '/tmp'
+      call get_command_argument(0,a0,length=l,status=st)
+      if (st /= 0) a0 = ''
+      write (f,'(a,i0,a)') trim(td)//'/crest_dist_exe_',getpid(),'.txt'
+      write (cmd,'(a,i0,a)') 'p=$(readlink -f /proc/',getpid(),'/exe 2>/dev/null) ; [ -n "$p" ] || p=$(command -v '''// &
+      &  trim(a0)//''' 2>/dev/null) ; s=$( (sha256sum "$p" 2>/dev/null || shasum -a 256 "$p" 2>/dev/null) | cut -c1-64) ; '// &
+      &  '[ ${#s} -eq 64 ] && printf ''%s\n%s\n'' "$s" "$p" > '''//trim(f)//''''
+      call execute_command_line(trim(cmd),exitstat=es,cmdstat=cs)
+      if (es == 0.and.cs == 0) then
+        open (newunit=u,file=trim(f),status='old',action='read',iostat=io)
+        if (io == 0) then
+          read (u,'(a)',iostat=io) csha
+          if (io == 0) read (u,'(a)',iostat=io) cpath
+          close (u)
+          if (io /= 0.or.len_trim(csha) /= 64) then
+            csha = 'unknown'
+            cpath = ''
+          end if
+        end if
+      end if
+    end if
+    sha = csha
+    path = cpath
+  end subroutine dist_exe_sha
+
+!>--- the Slurm task writing a result: <array job>_<task>, else the job id, else 'none'
+  subroutine dist_jobid(s)
+    character(len=32),intent(out) :: s
+    character(len=32) :: a,t
+    logical :: oka,okt
+    call dist_getenv('SLURM_ARRAY_JOB_ID',a,oka)
+    call dist_getenv('SLURM_ARRAY_TASK_ID',t,okt)
+    if (oka.and.okt) then
+      s = trim(a)//'_'//trim(t)
+    else
+      call dist_getenv('SLURM_JOB_ID',s,oka)
+      if (.not.oka) s = 'none'
+    end if
+  end subroutine dist_jobid
+
+!>--- Slurm --array text "a-b,c" -> mask(0:nch-1); ok=.false. on a malformed or out-of-range item
+  subroutine dist_parse_ranges(s,nch,mask,ok)
+    character(len=*),intent(in) :: s
+    integer,intent(in) :: nch
+    logical,intent(out) :: mask(0:nch-1)
+    logical,intent(out) :: ok
+    integer :: p,q,k,a,b,io
+    character(len=64) :: item
+    mask = .false.
+    ok = .false.
+    p = 1
+    do while (p <= len_trim(s))
+      q = index(s(p:),',')
+      if (q == 0) then
+        item = s(p:len_trim(s))
+        p = len_trim(s)+1
+      else
+        item = s(p:p+q-2)
+        p = p+q
+      end if
+      k = index(item,'-')
+      if (k > 0) then
+        read (item(1:k-1),*,iostat=io) a
+        if (io == 0) read (item(k+1:),*,iostat=io) b
+      else
+        read (item,*,iostat=io) a
+        b = a
+      end if
+      if (io /= 0) return
+      if (a < 0.or.b < a.or.b >= nch) return
+      mask(a:b) = .true.
+    end do
+    ok = .true.
+  end subroutine dist_parse_ranges
+
