 end subroutine get_atm_dispersion
+
+
+!> CREST GPU ATM route (energy + all derivatives). Returns .true. only when the CUDA
+!> implementation computed and added the complete contribution. It is taken only when
+!> CREST_ATM_GPU=1, for one zero translation (molecular case) and native shapes;
+!> otherwise, or on any CUDA failure, the caller runs the native CPU routine.
+logical function atm_gpu_route(mol, trans, cutoff, s9, a1, a2, alp, r4r2, &
+      & c6, dc6dcn, dc6dq, energy, dEdcn, dEdq, gradient, sigma) result(done)
+   use, intrinsic :: iso_c_binding, only : c_int
+   class(structure_type), intent(in) :: mol
+   real(wp), intent(in) :: trans(:, :)
+   real(wp), intent(in) :: cutoff, s9, a1, a2, alp
+   real(wp), intent(in) :: r4r2(:)
+   real(wp), intent(in) :: c6(:, :), dc6dcn(:, :), dc6dq(:, :)
+   real(wp), intent(inout) :: energy(:), dEdcn(:), dEdq(:)
+   real(wp), intent(inout) :: gradient(:, :), sigma(:, :)
+   integer :: nat
+
+   done = .false.
+   if (crest_atm_gpu_enabled() == 0_c_int) return
+   nat = mol%nat
+   if (nat < 1 .or. size(trans, 1) /= 3 .or. size(trans, 2) /= 1) return
+   if (any(trans(:, 1) /= 0.0_wp)) return
+   if (size(mol%xyz, 1) /= 3 .or. size(mol%xyz, 2) /= nat .or. size(mol%id) /= nat) return
+   if (size(r4r2) < 1) return
+   if (size(c6, 1) /= nat .or. size(c6, 2) /= nat) return
+   if (size(dc6dcn, 1) /= nat .or. size(dc6dcn, 2) /= nat) return
+   if (size(dc6dq, 1) /= nat .or. size(dc6dq, 2) /= nat) return
+   if (size(energy) /= nat .or. size(dEdcn) /= nat .or. size(dEdq) /= nat) return
+   if (size(gradient, 1) /= 3 .or. size(gradient, 2) /= nat) return
+   if (size(sigma, 1) /= 3 .or. size(sigma, 2) /= 3) return
+   done = crest_atm_gpu_derivs(int(nat, c_int), int(size(r4r2), c_int), mol%xyz, &
+      & int(mol%id, c_int), r4r2, c6, dc6dcn, dc6dq, cutoff, s9, a1, a2, alp, &
+      & energy, dEdcn, dEdq, gradient, sigma) == 0_c_int
+end function atm_gpu_route
 
 
